    "cwc_why_buy": {
      "type": "CWC_why_buy",
      "blocks": {
        "cwc_why_buy_b1": {
          "type": "card",
          "settings": {
            "icon": "store",
            "custom_icon_alt": "",
            "title": "A Real Storefront",
            "text": "<p>We are a licensed retailer operating a physical store in Coronado, California — not a marketplace reseller or a drop shipper.</p>"
          }
        },
        "cwc_why_buy_b2": {
          "type": "card",
          "settings": {
            "icon": "shield",
            "custom_icon_alt": "",
            "title": "Verified Authentic",
            "text": "<p>Every bottle is sourced through licensed channels and inspected before it ships. Nothing comes off the secondary market.</p>"
          }
        },
        "cwc_why_buy_b3": {
          "type": "card",
          "settings": {
            "icon": "box",
            "custom_icon_alt": "",
            "title": "Packed for Glass",
            "text": "<p>Wrapped, braced, and boxed in molded inserts. The same packing whether it is a $35 bottle or a $2,000 one.</p>"
          }
        },
        "cwc_why_buy_b4": {
          "type": "card",
          "settings": {
            "icon": "tag",
            "custom_icon_alt": "",
            "title": "Fair Retail Pricing",
            "text": "<p>Allocated bottles are listed at fair retail when they land. No lottery, no markup games, no waitlist to buy in.</p>"
          }
        }
      },
      "block_order": [
        "cwc_why_buy_b1",
        "cwc_why_buy_b2",
