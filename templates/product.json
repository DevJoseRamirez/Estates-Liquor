    "cwc_product_faq": {
      "type": "CWC_faq",
      "blocks": {
        "cwc_product_faq_b1": {
          "type": "item",
          "settings": {
            "question": "When will this ship?",
            "answer": "<p>Orders placed Monday through Thursday ship the same week. Orders placed Friday through Sunday ship the following Monday, so bottles are never sitting in a warehouse over a weekend.</p>",
            "open_by_default": true
          }
        },
        "cwc_product_faq_b2": {
          "type": "item",
          "settings": {
            "question": "Which states do you ship to?",
            "answer": "<p>We ship to most US states. Enter your ZIP code at checkout and we will confirm delivery to your address before you pay.</p>",
            "open_by_default": false
          }
        },
        "cwc_product_faq_b3": {
          "type": "item",
          "settings": {
            "question": "Do I have to sign for delivery?",
            "answer": "<p>Yes. Federal rules require an adult 21 or older to sign for every delivery.</p>",
            "open_by_default": false
          }
        },
        "cwc_product_faq_b4": {
          "type": "item",
          "settings": {
            "question": "How is the bottle packed?",
            "answer": "<p>Wrapped, braced, and boxed in molded inserts built for glass.</p>",
            "open_by_default": false
          }
        },
        "cwc_product_faq_b5": {
          "type": "item",
          "settings": {
            "question": "Can I return it?",
            "answer": "<p>Add shipping protection at checkout and we replace or refund any bottle that arrives broken or goes missing.</p>",
            "open_by_default": false
          }
        }
      },
