    "cwc_faq": {
      "type": "CWC_faq",
      "blocks": {
        "cwc_faq_b1": {
          "type": "item",
          "settings": {
            "question": "Which states do you ship to?",
            "answer": "<p>We ship to most US states. A small number restrict direct spirits shipments. Enter your ZIP code at checkout and we will confirm delivery to your address before you pay.</p>",
            "open_by_default": false
          }
        },
        "cwc_faq_b2": {
          "type": "item",
          "settings": {
            "question": "Do I have to be home to receive my order?",
            "answer": "<p>Yes. Federal rules require an adult 21 or older to sign for every delivery. The carrier will attempt delivery three times. You can also route the package to a nearby pickup location.</p>",
            "open_by_default": false
          }
        },
        "cwc_faq_b3": {
          "type": "item",
          "settings": {
            "question": "What happens if a bottle arrives broken?",
            "answer": "<p>Add shipping protection at checkout and we replace the bottle or refund you in full, no claim forms and no waiting on a carrier investigation. Send us a photo and we handle the rest.</p>",
            "open_by_default": false
          }
        },
        "cwc_faq_b4": {
          "type": "item",
          "settings": {
            "question": "Are your allocated bottles authentic?",
            "answer": "<p>Every bottle is sourced through licensed channels and inspected before it ships. We are a licensed retailer operating a physical store in Coronado, California, not a marketplace reseller.</p>",
            "open_by_default": false
          }
        },
        "cwc_faq_b5": {
          "type": "item",
          "settings": {
            "question": "When will my order ship?",
            "answer": "<p>Orders placed Monday through Thursday ship the same week. Orders placed Friday through Sunday ship the following Monday, so bottles are never sitting in a warehouse over a weekend.</p>",
            "open_by_default": false
          }
        }
