    "cwc_faq": {
      "type": "CWC_faq",
      "blocks": {
        "cwc_faq_b1": {
          "type": "item",
          "settings": {
            "question": "When will this ship?",
            "answer": "<p>Orders placed Monday through Thursday are processed and ship within 3–5 business days. Orders placed Friday through Sunday are processed the following Monday. We ship from Coronado, CA via UPS, and tracking is emailed as soon as your order leaves.</p>",
            "open_by_default": true
          }
        },
        "cwc_faq_b2": {
          "type": "item",
          "settings": {
            "question": "Which states do you ship to?",
            "answer": "<p>We ship to most US states, but not to Tennessee, US territories, or APO/FPO addresses. Enter your ZIP code at checkout and we will confirm delivery to your address before you pay. Not sure? Email <a href=\"mailto:support@estatesliquor.com\">support@estatesliquor.com</a> before ordering.</p>",
            "open_by_default": false
          }
        },
        "cwc_faq_b3": {
          "type": "item",
          "settings": {
            "question": "Do I have to sign for delivery?",
            "answer": "<p>Yes. An adult 21 or older with valid government-issued ID must be present to sign. UPS will not leave alcohol unattended.</p><p></p>",
            "open_by_default": false
          }
        },
        "cwc_faq_b4": {
          "type": "item",
          "settings": {
            "question": "What happens if I miss the delivery?",
            "answer": "<p>UPS attempts delivery up to three times. If all three attempts fail, the package is returned to us and re-shipping costs are the customer's responsibility.</p><p></p>",
            "open_by_default": false
          }
        },
        "cwc_faq_b5": {
          "type": "item",
          "settings": {
            "question": "How is the bottle packed?",
            "answer": "<p>Wrapped, braced, and boxed in molded inserts built for glass — the same packing whether it is a $35 bottle or a $2,000 one.</p><p></p>",
            "open_by_default": false
          }
        },
        "item_m9HTdC": {
          "type": "item",
          "settings": {
            "question": "Can I return it?",
            "answer": "<p>All sales are final. Alcohol is a consumable product, so we cannot accept returns based on taste preference. If a bottle arrives broken or we ship the wrong item, contact us within 48 hours of delivery with your order number and a photo, and we will replace or refund it at no cost.</p>",
            "open_by_default": false
          }
        },
        "item_ctWHkr": {
          "type": "item",
          "settings": {
            "question": "What if my order is lost or damaged in transit?",
            "answer": "<p>Contact us within 48 hours at <a href=\"mailto:support@estatesliquor.com\">support@estatesliquor.com</a> with your order number and photos. Adding shipping protection at checkout covers loss, damage, and theft, and lets us resolve it immediately rather than waiting on a UPS claim.</p>",
            "open_by_default": false
          }
        },
        "item_DNNXet": {
          "type": "item",
          "settings": {
            "question": "Can I cancel an order?",
            "answer": "<p>Email <a href=\"mailto:support@estatesliquor.com\">support@estatesliquor.com</a> immediately and we will try to stop it before it ships. If the order has already been processed, a 10% restocking fee applies.</p>",
            "open_by_default": false
          }
        }
      },
