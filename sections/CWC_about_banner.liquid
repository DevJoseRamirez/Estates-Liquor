{% style %}
  #cwc_about-banner-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#0A1F12' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#C9D2CC' }};
    --overlay-color: {{ section.settings.overlay_color | default: '#0A1F12' }};
    {% comment %}
      The wash steps down in the overlay colour itself, not black — so the rgb
      channels are pulled out once here and reused at three alphas.
    {% endcomment %}
    {%- assign overlay_hex = section.settings.overlay_color | default: '#0A1F12' -%}
    --overlay-rgb: {{ overlay_hex | color_extract: 'red' }}, {{ overlay_hex | color_extract: 'green' }}, {{ overlay_hex | color_extract: 'blue' }};
    --overlay-opacity: {{ section.settings.overlay_opacity | default: 100 | divided_by: 100.0 }};
    --overlay-coverage: {{ section.settings.overlay_coverage | default: 0 }}%;
    --image-opacity: {{ section.settings.image_opacity | default: 38 | divided_by: 100.0 }};
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_about_banner.css' | asset_url | stylesheet_tag }}

<section id="cwc_about-banner-{{ section.id }}" class="cwc_about-banner">
  {% comment %}
    The photo carries its own wrapper so Image Opacity fades it into the
    section background without touching the overlay wash. Mirrors CWC_hero.
  {% endcomment %}
  {% if section.settings.image != blank %}
    <span class="cwc_about-banner__image" aria-hidden="true">
      {% if section.settings.image_mobile != blank %}
        <picture>
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 900 }}"
          >
          <img
            src="{{ section.settings.image | image_url: width: 2000 }}"
            alt="{{ section.settings.alt_text | default: 'About banner background' | escape }}"
            loading="eager"
            fetchpriority="high"
            width="2000"
            height="700"
          >
        </picture>
      {% else %}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          alt="{{ section.settings.alt_text | default: 'About banner background' | escape }}"
          loading="eager"
          fetchpriority="high"
          width="2000"
          height="700"
        >
      {% endif %}
    </span>
  {% endif %}

  <span class="cwc_about-banner__overlay" aria-hidden="true"></span>

  <div class="cwc_about-banner__container">
    <div class="cwc_about-banner__content">
      {% if section.settings.eyebrow != blank %}
        <p class="cwc_about-banner__content-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_about-banner__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_about-banner__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC About Banner",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Coronado, California"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>About Estates Liquor</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>A specialist retailer for rare, allocated, and premium spirits — the bottles that are genuinely hard to find at a fair price.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Banner Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Banner Background Image Alt Text"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image Opacity",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 38,
      "info": "Fades the photo into the Background Color."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Strength",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_coverage",
      "label": "Overlay Coverage",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "How far across the banner the overlay holds full strength before fading toward the photo."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#C9D2CC"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#0A1F12"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "About Banner",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
