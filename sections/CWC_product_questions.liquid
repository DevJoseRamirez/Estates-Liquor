{% style %}
  #cwc_product-questions-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#0A1F12' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --body-text-color: {{ section.settings.body_text_color | default: '#A6ADA8' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#C4933F' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 45 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 45 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 45 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 45 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_questions.css' | asset_url | stylesheet_tag }}

<section id="cwc_product-questions-{{ section.id }}" class="cwc_product-questions">
  <div class="cwc_product-questions__container">
    <div class="cwc_product-questions__wrapper">

      {% if section.settings.show_icon %}
        <span class="cwc_product-questions__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.6L3 21l1.7-5.1A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z" />
          </svg>
        </span>
      {% endif %}

      <div class="cwc_product-questions__content">
        {% if section.settings.heading != blank %}
          <h2 class="cwc_product-questions__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_product-questions__subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="cwc_product-questions__actions">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'action' %}
                {% liquid
                  case block.settings.link_type
                    when 'phone'
                      assign action_href = block.settings.value | prepend: 'tel:' | replace: ' ', '' | replace: '-', ''
                    when 'email'
                      assign action_href = block.settings.value | prepend: 'mailto:'
                    else
                      assign action_href = block.settings.link
                  endcase
                %}

                {% if block.settings.label != blank and action_href != blank %}
                  <a
                    href="{{ action_href }}"
                    class="cwc_product-questions__button{% if block.settings.style == 'outline' %} cwc_product-questions__button--outline{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.label }}
                  </a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Product Questions",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show Icon",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions about this bottle?"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Talk to someone who has actually tasted it. Our team is in the store six days a week and answers the phone.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Subtext Color",
      "default": "#A6ADA8"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Primary Button Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Primary Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "action",
      "name": "Action Link",
      "settings": [
        {
          "type": "select",
          "id": "link_type",
          "label": "Link Type",
          "options": [
            { "value": "phone", "label": "Phone Call" },
            { "value": "email", "label": "Email" },
            { "value": "url", "label": "Page Link" }
          ],
          "default": "phone",
          "info": "Phone and Email build the link from the value below. Page Link uses the URL field."
        },
        {
          "type": "text",
          "id": "value",
          "label": "Phone Number Or Email",
          "default": "619-781-3613"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Page Link",
          "info": "Used when Link Type is Page Link — point this at your contact form."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button Label",
          "default": "Call 619-781-3613"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Button Style",
          "options": [
            { "value": "primary", "label": "Filled" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Product Questions",
      "category": "CWC Custom",
      "blocks": [
        { "type": "action" },
        { "type": "action" }
      ]
    }
  ]
}
{% endschema %}
