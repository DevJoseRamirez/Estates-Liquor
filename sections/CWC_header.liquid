{% comment %}
  Two rows: a top bar (logo, search, icons) and a nav row under it. A
  top-level menu link with children opens a full-width mega panel.

  The mobile menu is a sibling of the header, not a child. The header slides
  on scroll with a transform, and a transformed ancestor becomes the containing
  block for position:fixed children, which would pin the full-screen menu to
  the header instead of the viewport. Both ids are named below so the section's
  variables still reach the menu.
{% endcomment %}
{% style %}
  #cwc_header-{{ section.id }},
  #cwc_header-menu-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#3A3A36' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A35A12' }};
    --brand-color: {{ section.settings.brand_color | default: '#221813' }};
    --hover-bg: {{ section.settings.hover_bg_color | default: '#F6F6F3' }};
    --border-color: {{ section.settings.border_color | default: '#ECECE8' }};
    --menu-bg: {{ section.settings.menu_bg_color | default: '#ffffff' }};
    --promo-bg: {{ section.settings.promo_bg_color | default: '#F6F6F3' }};
    --promo-label-bg: {{ section.settings.promo_label_bg_color | default: '#221813' }};
    --promo-label-text: {{ section.settings.promo_label_text_color | default: '#E9A23B' }};
    --promo-dark-bg: {{ section.settings.promo_dark_bg_color | default: '#221813' }};
    --promo-dark-text: {{ section.settings.promo_dark_text_color | default: '#ffffff' }};
    --promo-price: {{ section.settings.promo_price_color | default: '#E9A23B' }};
    --drawer-footer-bg: {{ section.settings.drawer_footer_bg_color | default: '#221813' }};
    --bar-bg: {{ section.settings.bar_bg_color | default: '#221813' }};
    --bar-text: {{ section.settings.bar_text_color | default: '#ffffff' }};
    --bar-accent: {{ section.settings.bar_accent_color | default: '#E9A23B' }};
    --bar-field-bg: {{ section.settings.bar_field_bg_color | default: '#2E221B' }};
    --bar-field-line: {{ section.settings.bar_field_border_color | default: '#453D39' }};
    --bar-line: {{ section.settings.bar_line_color | default: '#342B26' }};
    --pn-bg: {{ section.settings.menu_bg_color | default: '#ffffff' }};
    --pn-text: {{ section.settings.text_color | default: '#3A3A36' }};
    --pn-brand: {{ section.settings.brand_color | default: '#221813' }};
    --pn-highlight: {{ section.settings.bold_color | default: '#A35A12' }};
    --pn-hover: {{ section.settings.hover_bg_color | default: '#F6F6F3' }};
    --pn-line: {{ section.settings.border_color | default: '#ECECE8' }};
    --logo-width: {{ section.settings.logo_width | default: 150 }}px;
    --logo-width-mobile: {{ section.settings.logo_width_mobile | default: 130 }}px;
    --padding-top: {{ section.settings.padding_top | default: 15 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 15 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 15 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 15 | times: 0.5 }}px;
  }

  #cwc_header-overlay-{{ section.id }} {
    --overlay-color: {{ section.settings.search_overlay_color | default: '#221813' }};
    --overlay-opacity: {{ section.settings.search_overlay_opacity | default: 45 | divided_by: 100.0 }};
  }

  {% comment %}
    The section wrapper is what sticks; the header inside it is only as tall as
    itself. When a row slides away the wrapper keeps its full height, so the
    wrapper ignores the pointer and only the header rows and the menu take
    clicks, or the empty strip left behind would block the page beneath it.
    The wrapper also turns overflow back on so the mega panel is not clipped.
  {% endcomment %}
  #shopify-section-{{ section.id }} {
    position: {% if section.settings.enable_sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 500;
    overflow: visible;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} > *:not(.cwc_header) {
    pointer-events: auto;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_header.css' | asset_url | stylesheet_tag }}

{% liquid
  assign desktop_menu = section.settings.main_menu
  assign mobile_menu = section.settings.mobile_menu
  if mobile_menu == blank or mobile_menu.links.size == 0
    assign mobile_menu = desktop_menu
  endif

  assign highlights = section.settings.highlight_links | downcase | split: ','

  assign scroll_mode = section.settings.scroll_mode | default: 'hide_nav'

  assign logo_alt = section.settings.logo_alt | default: shop.name
  assign logo_sizes = section.settings.logo_width | default: 150 | append: 'px'
%}

{%- capture logo_markup -%}
  {%- if section.settings.logo != blank -%}
    <picture>
      {%- if section.settings.logo_mobile != blank -%}
        <source
          media="(max-width: 991px)"
          srcset="{{ section.settings.logo_mobile | image_url: width: 260 }} 1x, {{ section.settings.logo_mobile | image_url: width: 520 }} 2x"
        >
      {%- endif -%}
      {{
        section.settings.logo
        | image_url: width: 600
        | image_tag:
          class: 'cwc_header__logo-image',
          alt: logo_alt,
          loading: 'eager',
          widths: '200, 300, 450, 600',
          sizes: logo_sizes
      }}
    </picture>
  {%- else -%}
    {%- if section.settings.show_logo_mark -%}
      <svg class="cwc_header__logo-mark" viewBox="0 0 52 62" aria-hidden="true" focusable="false">
        <rect x="16" y="0" width="20" height="6" rx="2" />
        <rect x="18" y="6" width="16" height="11" />
        <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
      </svg>
    {%- endif -%}
    <span class="cwc_header__wordmark">
      {%- if section.settings.wordmark_top != blank -%}
        <span class="cwc_header__wordmark-top">{{ section.settings.wordmark_top | escape }}</span>
      {%- endif -%}
      <span class="cwc_header__wordmark-rule" aria-hidden="true"></span>
      {%- if section.settings.wordmark_bottom != blank -%}
        <span class="cwc_header__wordmark-bottom">{{ section.settings.wordmark_bottom | escape }}</span>
      {%- endif -%}
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- capture cart_icon -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
    <line x1="3" y1="6" x2="21" y2="6" />
    <path d="M16 10a4 4 0 0 1-8 0" />
  </svg>
{%- endcapture -%}

{%- capture search_icon -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
    <circle cx="11" cy="11" r="7" />
    <path d="M20 20l-3.5-3.5" />
  </svg>
{%- endcapture -%}

{%- capture menu_icon -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
    <line x1="3" y1="6" x2="21" y2="6" />
    <line x1="3" y1="12" x2="21" y2="12" />
    <line x1="3" y1="18" x2="21" y2="18" />
  </svg>
{%- endcapture -%}

<header
  id="cwc_header-{{ section.id }}"
  class="cwc_header cwc_header--mode-{{ scroll_mode }}{% if section.settings.enable_sticky %} cwc_header--sticky{% endif %}{% if section.settings.show_border %} cwc_header--bordered{% endif %}{% if section.settings.desktop_layout == 'logo_center' %} cwc_header--logo-center{% endif %}"
  data-section-id="{{ section.id }}"
  data-sticky="{{ section.settings.enable_sticky }}"
  data-hide-on-scroll="{{ section.settings.hide_on_scroll }}"
  data-scroll-mode="{{ scroll_mode }}"
>
  {% comment %}
    Top bar: logo, search, icons. On scroll down either the nav row tucks
    under this bar (keep logo and search) or this bar slides away (keep menu).
  {% endcomment %}
  <div class="cwc_header__top" data-cwc-header-top>
    <div class="cwc_header__container cwc_header__top-inner">

      <div class="cwc_header__mobile-actions">
        <button
          type="button"
          class="cwc_header__icon"
          data-cwc-menu-open
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="cwc_header-menu-{{ section.id }}"
        >
          {{ menu_icon }}
        </button>

        {% if section.settings.show_search %}
          <button
            type="button"
            class="cwc_header__icon"
            data-cwc-menu-open
            data-cwc-menu-search-focus
            aria-label="Search"
            aria-expanded="false"
            aria-controls="cwc_header-menu-{{ section.id }}"
          >
            {{ search_icon }}
          </button>
        {% endif %}
      </div>

      {% comment %} Desktop: shown once the nav row has tucked away, brings it back {% endcomment %}
      {% if section.settings.hide_on_scroll and scroll_mode == 'hide_nav' and desktop_menu != blank %}
        <button
          type="button"
          class="cwc_header__nav-toggle"
          data-cwc-nav-toggle
          aria-label="Show menu"
          aria-expanded="false"
          aria-controls="cwc_header-nav-{{ section.id }}"
        >
          {{ menu_icon }}
        </button>
      {% endif %}

      <a href="{{ routes.root_url }}" class="cwc_header__logo" aria-label="{{ shop.name | escape }} home">
        {{ logo_markup }}
      </a>

      {% comment %}
        A plain GET form to the search page, so searching works with no JS.
        CWC_header.js adds the suggestions dropdown on top of it.
      {% endcomment %}
      {% if section.settings.show_search %}
        <div class="cwc_header__search" data-cwc-search data-predictive="{{ section.settings.enable_predictive }}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="cwc_header__search-form">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <label class="cwc_header__visually-hidden" for="cwc_header-search-{{ section.id }}">Search the store</label>
            <input
              id="cwc_header-search-{{ section.id }}"
              type="search"
              name="q"
              class="cwc_header__search-input"
              data-cwc-search-input
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | default: 'Search bottles, brands, collections' | escape }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            >
            <button
              type="submit"
              class="cwc_header__search-submit"
              aria-label="{{ section.settings.search_button_label | default: 'Search' | escape }}"
            >
              {{ search_icon }}
            </button>
          </form>
          <div class="cwc_header__search-results" id="cwc_header-search-results-{{ section.id }}" data-cwc-search-results hidden></div>
          <span class="cwc_header__visually-hidden" data-cwc-search-status aria-live="polite"></span>
        </div>
      {% endif %}

      <div class="cwc_header__icons">
        {% if section.settings.show_account %}
          <a
            href="{% if shop.customer_accounts_enabled %}{{ routes.account_url }}{% else %}{{ routes.root_url }}{% endif %}"
            class="cwc_header__icon cwc_header__icon--account{% if section.settings.show_icon_labels %} cwc_header__icon--labeled{% endif %}"
            aria-label="{{ section.settings.account_label | default: 'Account' | escape }}"
          >
            <span class="cwc_header__icon-glyph">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21v-1a7 7 0 0 1 7-7h2a7 7 0 0 1 7 7v1" />
              </svg>
            </span>
            {% if section.settings.show_icon_labels %}
              <span class="cwc_header__icon-label" aria-hidden="true">{{ section.settings.account_label | default: 'Account' | escape }}</span>
            {% endif %}
          </a>
        {% endif %}

        {% comment %}
          A real link to /cart. When the theme's cart drawer is listening, the
          JS opens that instead, so the link still works if the drawer never loads.
        {% endcomment %}
        {% if section.settings.show_cart %}
          <a href="{{ routes.cart_url }}" class="cwc_header__icon cwc_header__icon--cart{% if section.settings.show_icon_labels %} cwc_header__icon--labeled{% endif %}" data-cwc-cart aria-label="Cart, {{ cart.item_count }} items">
            {% comment %} With a label the count follows the word (CART [2]); without one it pins to the icon {% endcomment %}
            <span class="cwc_header__icon-glyph">
              {{ cart_icon }}
              {% unless section.settings.show_icon_labels %}
                <span class="cwc_header__cart-count" data-cwc-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
              {% endunless %}
            </span>
            {% if section.settings.show_icon_labels %}
              <span class="cwc_header__icon-label" aria-hidden="true">{{ section.settings.cart_label | default: 'Cart' | escape }}</span>
              <span class="cwc_header__cart-count cwc_header__cart-count--inline" data-cwc-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
            {% endif %}
          </a>
        {% endif %}
      </div>

    </div>
  </div>

  {% comment %}
    Mobile search row: full width under the top bar. It slides up behind the
    bar once the shopper scrolls down and
    comes back at the top of the page. Hidden on desktop.
  {% endcomment %}
  {% if section.settings.show_search %}
    <div class="cwc_header__msearch" data-cwc-msearch>
      <div class="cwc_header__container">
        <div class="cwc_header__search" data-cwc-search data-predictive="{{ section.settings.enable_predictive }}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="cwc_header__search-form">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <label class="cwc_header__visually-hidden" for="cwc_header-msearch-{{ section.id }}">Search the store</label>
            <input
              id="cwc_header-msearch-{{ section.id }}"
              type="search"
              name="q"
              class="cwc_header__search-input"
              data-cwc-search-input
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | default: 'Search bottles, brands, collections' | escape }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            >
            <button
              type="submit"
              class="cwc_header__search-submit"
              aria-label="{{ section.settings.search_button_label | default: 'Search' | escape }}"
            >
              {{ search_icon }}
            </button>
          </form>
          <div class="cwc_header__search-results" id="cwc_header-msearch-results-{{ section.id }}" data-cwc-search-results hidden></div>
          <span class="cwc_header__visually-hidden" data-cwc-search-status aria-live="polite"></span>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %}
    Desktop nav. A top-level link with children opens a mega panel: its
    children become column headings and their children the links under them.
    A mega block, matched by title, picks the panel's structure: "Link
    Columns" (column footer links, notes, featured tile) or "Product Tabs"
    (the children become tabs showing their collection's bottles).
  {% endcomment %}
  {% if desktop_menu != blank and desktop_menu.links.size > 0 %}
    <nav class="cwc_header__nav" id="cwc_header-nav-{{ section.id }}" aria-label="{{ section.settings.nav_label | default: 'Main' | escape }}">
      <div class="cwc_header__container cwc_header__nav-inner">
        <ul class="cwc_header__nav-list">
          {% for link in desktop_menu.links %}
            {% liquid
              assign link_key = link.title | downcase | strip
              assign is_highlight = false
              for entry in highlights
                assign entry_key = entry | strip
                if entry_key == link_key
                  assign is_highlight = true
                endif
              endfor

              assign panel_block = nil
              for block in section.blocks
                if block.type == 'mega_panel' or block.type == 'mega_products'
                  assign block_key = block.settings.menu_item | downcase | strip
                  if block_key == link_key
                    assign panel_block = block
                    break
                  endif
                endif
              endfor

              assign has_promo = false
              if panel_block != nil and panel_block.type == 'mega_panel'
                if panel_block.settings.promo_heading != blank or panel_block.settings.promo_text != blank or panel_block.settings.promo_image != blank or panel_block.settings.promo_product != blank
                  assign has_promo = true
                endif
              endif

              assign has_panel = false
              if link.links.size > 0 or has_promo
                assign has_panel = true
              endif

              assign panel_id = 'cwc_header-mega-' | append: section.id | append: '-' | append: forloop.index
            %}

            <li class="cwc_header__nav-item{% if has_panel %} cwc_header__nav-item--has-mega{% endif %}" data-cwc-nav-item>
              <a
                href="{{ link.url }}"
                class="cwc_header__nav-link{% if is_highlight %} cwc_header__nav-link--highlight{% endif %}{% if link.active or link.child_active %} cwc_header__nav-link--current{% endif %}"
                {% if has_panel %}aria-controls="{{ panel_id }}"{% endif %}
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
                {% if has_panel %}
                  <span class="cwc_header__chevron" aria-hidden="true"></span>
                {% endif %}
              </a>

              {% if has_panel and panel_block.type == 'mega_products' and link.links.size > 0 %}
                {% render 'CWC_header-mega-products',
                  link: link,
                  block: panel_block,
                  panel_id: panel_id
                %}
              {% elsif has_panel %}
                {% render 'CWC_header-mega',
                  link: link,
                  block: panel_block,
                  panel_id: panel_id,
                  has_promo: has_promo,
                  view_all_label: section.settings.view_all_label
                %}
              {% endif %}
            </li>
          {% endfor %}
        </ul>

        {% comment %} Only shown once the top bar has slid away, so the cart stays reachable {% endcomment %}
        {% if section.settings.show_cart %}
          <a href="{{ routes.cart_url }}" class="cwc_header__icon cwc_header__nav-cart" data-cwc-cart aria-label="Cart, {{ cart.item_count }} items" tabindex="-1">
            {{ cart_icon }}
            <span class="cwc_header__cart-count" data-cwc-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
          </a>
        {% endif %}
      </div>
    </nav>
  {% endif %}
</header>

{% comment %}
  Tints the page under the header while the search is in use or a mega panel
  is open (each switched on in settings). A sibling of the
  header for the same reason as the menu: the header's transform would pin a
  fixed child to the header. JS sets its top edge to the header's bottom edge,
  so the whole header stays clear and only the page below is dimmed.
{% endcomment %}
{% liquid
  assign overlay_search = false
  if section.settings.show_search and section.settings.enable_search_overlay
    assign overlay_search = true
  endif
  assign overlay_mega = false
  if section.settings.enable_mega_overlay and desktop_menu != blank
    assign overlay_mega = true
  endif
%}
{% if overlay_search or overlay_mega %}
  <div
    class="cwc_header__overlay"
    id="cwc_header-overlay-{{ section.id }}"
    data-cwc-search-overlay
    data-search="{{ overlay_search }}"
    data-mega="{{ overlay_mega }}"
    aria-hidden="true"
  ></div>
{% endif %}

{% render 'CWC_header-mobile',
  section: section,
  nav_menu: mobile_menu,
  highlights: highlights,
  logo_markup: logo_markup,
  cart_icon: cart_icon,
  search_icon: search_icon
%}

<script src="{{ 'CWC_header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Header",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the text wordmark below."
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Mobile Logo",
      "info": "Optional. Uses the logo when blank."
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo Alt Text",
      "info": "Defaults to the store name."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo Width (Mobile)",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 130,
      "info": "Applies at 991px and below."
    },
    {
      "type": "checkbox",
      "id": "show_logo_mark",
      "label": "Show Bottle Mark",
      "default": true,
      "info": "Only used with the text wordmark."
    },
    {
      "type": "text",
      "id": "wordmark_top",
      "label": "Wordmark Top Line",
      "default": "Estates"
    },
    {
      "type": "text",
      "id": "wordmark_bottom",
      "label": "Wordmark Bottom Line",
      "default": "Liquor"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Desktop Menu",
      "info": "Top level = nav links. Second level = mega panel column headings. Third level = links under each heading. A menu with only two levels shows the second level as one list across the panel."
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile Menu",
      "info": "Optional. Uses the desktop menu when blank. Top level = accordion rows, second level = links inside."
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Accessible Nav Label",
      "default": "Main"
    },
    {
      "type": "text",
      "id": "highlight_links",
      "label": "Highlight Links",
      "default": "Featured",
      "info": "Comma-separated menu titles to show in the highlight colour."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Prefix",
      "default": "View All",
      "info": "Adds a last link to two-level panels and mobile accordions, e.g. \"View All Whiskey\". Leave blank for none."
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search bottles, brands, collections"
    },
    {
      "type": "text",
      "id": "search_button_label",
      "label": "Search Button Label",
      "info": "The button shows an icon only; this is read out by screen readers",
      "default": "Search"
    },
    {
      "type": "checkbox",
      "id": "enable_predictive",
      "label": "Show Suggestions While Typing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_search_overlay",
      "label": "Dim Page While Searching",
      "info": "Tints everything below the header while the search box is in use",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mega_overlay",
      "label": "Dim Page While Mega Menu Is Open",
      "info": "Same overlay color and opacity as the search",
      "default": true
    },
