{% style %}
  #cwc_trust-bar-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F8F6F1' }};
    --text-color: {{ section.settings.text_color | default: '#0A1F12' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#666666' }};
    --icon-color: {{ section.settings.icon_color | default: '#C4933F' }};
    --border-color: {{ section.settings.border_color | default: '#E0DDD6' }};
    --icon-size: {{ section.settings.icon_size | default: 36 }}px;
    --padding-top: {{ section.settings.padding_top | default: 20 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 20 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 20 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 20 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_trust_bar.css' | asset_url | stylesheet_tag }}

{% if section.blocks.size > 0 %}
  <section
    id="cwc_trust-bar-{{ section.id }}"
    class="cwc_trust-bar{% if section.settings.show_border %} cwc_trust-bar--bordered{% endif %}"
  >
    <div class="cwc_trust-bar__container">
      <div class="cwc_trust-bar__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'item' %}
              <div class="cwc_trust-bar__card" {{ block.shopify_attributes }}>
                {% if block.settings.custom_icon != blank %}
                  <span class="cwc_trust-bar__card-image">
                    <img
                      src="{{ block.settings.custom_icon | image_url: width: 144 }}"
                      alt="{{ block.settings.custom_icon_alt | default: '' | escape }}"
                      loading="lazy"
                      width="36"
                      height="36"
                    >
                  </span>
                {% elsif block.settings.icon != 'none' %}
                  <span class="cwc_trust-bar__card-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      {% case block.settings.icon %}
                        {% when 'arrow' %}
                          <path d="M5 12h14M12 5l7 7-7 7" />
                        {% when 'shield' %}
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        {% when 'truck' %}
                          <rect x="1" y="3" width="15" height="13" rx="1" />
                          <path d="M16 8h4l3 3v5h-7V8z" />
                          <circle cx="5.5" cy="18.5" r="2.5" />
                          <circle cx="18.5" cy="18.5" r="2.5" />
                        {% when 'check' %}
                          <path d="M9 12l2 2 4-4" />
                          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" />
                        {% when 'lock' %}
                          <rect x="4" y="10" width="16" height="11" rx="2" />
                          <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        {% when 'star' %}
                          <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
                        {% when 'clock' %}
                          <circle cx="12" cy="12" r="9" />
                          <path d="M12 7v5.2l3.4 2" />
                        {% when 'gift' %}
                          <rect x="3" y="8" width="18" height="4" />
                          <path d="M5 12v9h14v-9" />
                          <path d="M12 8v13" />
                          <path d="M12 8S10.6 3 8.2 3a2.5 2.5 0 0 0 0 5H12z" />
                          <path d="M12 8s1.4-5 3.8-5a2.5 2.5 0 0 1 0 5H12z" />
                        {% when 'returns' %}
                          <path d="M3 12a9 9 0 0 1 15.4-6.4L21 8" />
                          <path d="M21 3.5V8h-4.5" />
                          <path d="M21 12a9 9 0 0 1-15.4 6.4L3 16" />
                          <path d="M3 20.5V16h4.5" />
                        {% when 'support' %}
                          <path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2" />
                          <rect x="2" y="13.5" width="4" height="6.5" rx="1.6" />
                          <rect x="18" y="13.5" width="4" height="6.5" rx="1.6" />
                        {% when 'bottle' %}
                          <path d="M10 2.5h4V6l2 3.2V21H8V9.2L10 6V2.5z" />
                          <path d="M8 13h8" />
                        {% when 'card' %}
                          <rect x="2" y="5" width="20" height="14" rx="2" />
                          <path d="M2 10h20" />
                      {% endcase %}
                    </svg>
                  </span>
                {% endif %}

                <div class="cwc_trust-bar__card-body">
                  {% if block.settings.title != blank %}
                    <div class="cwc_trust-bar__card-title">{{ block.settings.title }}</div>
                  {% endif %}

                  {% if block.settings.subtext != blank %}
                    <div class="cwc_trust-bar__card-text">{{ block.settings.subtext }}</div>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "CWC Trust Bar",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F6F1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#C4933F"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show Bottom Border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider Color",
      "default": "#E0DDD6"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No Icon" },
            { "value": "arrow", "label": "Arrow" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Shipping Truck" },
            { "value": "check", "label": "Check Circle" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" },
            { "value": "returns", "label": "Returns" },
            { "value": "support", "label": "Support" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "card", "label": "Credit Card" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Optional)",
          "info": "Overrides the icon above. Use a small square image."
        },
        {
          "type": "text",
          "id": "custom_icon_alt",
          "label": "Custom Icon Alt Text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "On orders over $200"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Trust Bar",
      "category": "CWC Custom",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
