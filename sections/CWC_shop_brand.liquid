{% style %}
  #cwc_shop-brand-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#0A1F12' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#0A1F12' }};
    --card-text-color: {{ section.settings.card_text_color | default: '#9A9A9A' }};
    --border-color: {{ section.settings.border_color | default: '#E0DDD6' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#0A1F12' }};
    --columns: {{ section.settings.columns | default: 6 }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_shop_brand.css' | asset_url | stylesheet_tag }}

<section id="cwc_shop-brand-{{ section.id }}" class="cwc_shop-brand">
  <div class="cwc_shop-brand__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_shop-brand__content">
      {% if section.settings.eyebrow != blank %}
        <p class="cwc_shop-brand__content-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_shop-brand__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.show_rule %}
        <span class="cwc_shop-brand__rule" aria-hidden="true"></span>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_shop-brand__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Brand Tiles {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_shop-brand__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'brand' %}
              {% liquid
                assign brand_collection = block.settings.collection

                if block.settings.title != blank
                  assign brand_title = block.settings.title
                elsif brand_collection != blank
                  assign brand_title = brand_collection.title
                else
                  assign brand_title = blank
                endif

                if block.settings.count_text != blank
                  assign brand_count = block.settings.count_text
                elsif brand_collection != blank
                  assign brand_count = brand_collection.products_count | append: ' bottles'
                else
                  assign brand_count = blank
                endif

                if block.settings.link != blank
                  assign brand_link = block.settings.link
                elsif brand_collection != blank
                  assign brand_link = brand_collection.url
                else
                  assign brand_link = nil
                endif
              %}

              {% if brand_title != blank %}
                {% if brand_link %}
                  <a href="{{ brand_link }}" class="cwc_shop-brand__card" {{ block.shopify_attributes }}>
                {% else %}
                  <div class="cwc_shop-brand__card" {{ block.shopify_attributes }}>
                {% endif %}

                <span class="cwc_shop-brand__card-title">{{ brand_title }}</span>

                {% if brand_count != blank %}
                  <span class="cwc_shop-brand__card-text">{{ brand_count }}</span>
                {% endif %}

                {% if brand_link %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}

    {% comment %} Footer Button {% endcomment %}
    {% if section.settings.button_label != blank %}
      <div class="cwc_shop-brand__button">
        <a href="{{ section.settings.button_link | default: '#' }}" class="cwc_shop-brand__button-link">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "CWC Shop By Brand",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "600+ Bottles in Stock"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Shop by Distillery</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Gold Rule",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View All Brands"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E0DDD6"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Count Color",
      "default": "#9A9A9A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Color",
      "default": "#0A1F12"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Supplies the title, bottle count, and link."
        },
        {
          "type": "header",
          "content": "Overrides (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override"
        },
        {
          "type": "text",
          "id": "count_text",
          "label": "Count Override",
          "info": "Falls back to the collection's product count."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Brand",
      "category": "CWC Custom",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
