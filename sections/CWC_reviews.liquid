{% style %}
  #cwc_reviews-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F2EFE8' }};
    --text-color: {{ section.settings.text_color | default: '#0A1F12' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --star-color: {{ section.settings.star_color | default: '#C4933F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-text-color: {{ section.settings.card_text_color | default: '#2C2C2C' }};
    --card-meta-color: {{ section.settings.card_meta_color | default: '#9A9A9A' }};
    --avatar-bg: {{ section.settings.avatar_bg_color | default: '#0A1F12' }};
    --border-color: {{ section.settings.border_color | default: '#E0DDD6' }};
    --columns: {{ section.settings.columns | default: 3 }};
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_reviews.css' | asset_url | stylesheet_tag }}

<section id="cwc_reviews-{{ section.id }}" class="cwc_reviews" data-section-id="{{ section.id }}">
  <div class="cwc_reviews__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_reviews__content">
      {% if section.settings.eyebrow != blank %}
        <p class="cwc_reviews__content-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_reviews__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.show_rating %}
        <div class="cwc_reviews__rating">
          {% if section.settings.rating_score != blank %}
            <span class="cwc_reviews__rating-score">{{ section.settings.rating_score }}</span>
          {% endif %}

          <span class="cwc_reviews__stars cwc_reviews__stars--large" role="img" aria-label="5 out of 5 stars">
            {% for i in (1..5) %}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
              </svg>
            {% endfor %}
          </span>

          {% if section.settings.rating_meta != blank %}
            <span class="cwc_reviews__rating-meta">{{ section.settings.rating_meta }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% comment %} Reviews — scroll-snap track, swipeable with no JS {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_reviews__carousel">
        <div class="cwc_reviews__track" tabindex="0" role="group" aria-label="Customer reviews">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'review' %}
                <div class="cwc_reviews__card" {{ block.shopify_attributes }}>
                  <span class="cwc_reviews__stars" role="img" aria-label="5 out of 5 stars">
                    {% for i in (1..5) %}
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
                      </svg>
                    {% endfor %}
                  </span>

                  {% if block.settings.text != blank %}
                    <div class="cwc_reviews__card-text cwc-rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}

                  <div class="cwc_reviews__card-author">
                    {% if block.settings.avatar != blank %}
                      <span class="cwc_reviews__card-avatar cwc_reviews__card-avatar--image">
                        <img
                          src="{{ block.settings.avatar | image_url: width: 96 }}"
                          alt="{{ block.settings.avatar_alt | default: block.settings.name | escape }}"
                          loading="lazy"
                          width="36"
                          height="36"
                        >
                      </span>
                    {% elsif block.settings.name != blank %}
                      <span class="cwc_reviews__card-avatar" aria-hidden="true">
                        {{ block.settings.name | slice: 0 | upcase }}
                      </span>
                    {% endif %}

                    <span class="cwc_reviews__card-author-body">
                      {% if block.settings.name != blank %}
                        <span class="cwc_reviews__card-name">{{ block.settings.name }}</span>
                      {% endif %}
                      {% if block.settings.location != blank %}
                        <span class="cwc_reviews__card-location">{{ block.settings.location }}</span>
                      {% endif %}
                    </span>
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        <div class="cwc_reviews__nav" data-cwc-reviews-nav hidden>
          <button type="button" class="cwc_reviews__nav-button" data-cwc-reviews-prev aria-label="Previous reviews">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <button type="button" class="cwc_reviews__nav-button" data-cwc-reviews-next aria-label="Next reviews">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    {% endif %}

  </div>
</section>

<script src="{{ 'CWC_reviews.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Reviews",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Verified Reviews"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Trusted by Spirits Enthusiasts</p>"
    },
    {
      "type": "header",
      "content": "Rating Strip"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Strip",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_meta",
      "label": "Rating Caption",
      "default": "Verified store rating · Judge.me"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards Per View",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Extra reviews scroll horizontally."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2EFE8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E0DDD6"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Quote Color",
      "default": "#2C2C2C"
    },
    {
      "type": "color",
      "id": "card_meta_color",
      "label": "Card Location Color",
      "default": "#9A9A9A"
    },
    {
      "type": "color",
      "id": "avatar_bg_color",
      "label": "Avatar Background Color",
      "default": "#0A1F12"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Review Text",
          "default": "<p>Found a Pappy 15 here when nowhere else had it. Shipping was fast, bottle arrived perfectly packed.</p>",
          "info": "Every review shows five stars."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer Name",
          "default": "Michael T."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Reviewer Location",
          "default": "Dallas, TX"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Reviewer Avatar Image (Optional)",
          "info": "Falls back to the first letter of the name."
        },
        {
          "type": "text",
          "id": "avatar_alt",
          "label": "Reviewer Avatar Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "category": "CWC Custom",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
