{% style %}
  #cwc_barrel-picks-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#0A1F12' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#666666' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#F2EFE8' }};
    --card-media-bg: {{ section.settings.card_media_bg_color | default: '#ffffff' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#0A1F12' }};
    --card-text-color: {{ section.settings.card_text_color | default: '#9A9A9A' }};
    --card-brand-color: {{ section.settings.card_brand_color | default: '#C4933F' }};
    --border-color: {{ section.settings.border_color | default: '#E0DDD6' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#0A1F12' }};
    --button-bg: {{ section.settings.card_button_bg_color | default: '#0A1F12' }};
    --per-view: {{ section.settings.columns | default: 3 }};
    --per-view-mobile: {{ section.settings.columns_mobile | default: 2 }};
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_barrel_picks.css' | asset_url | stylesheet_tag }}

{% liquid
  assign feature_collection = section.settings.collection

  if section.settings.button_link != blank
    assign button_link = section.settings.button_link
  elsif feature_collection != blank
    assign button_link = feature_collection.url
  else
    assign button_link = null
  endif
%}

<section id="cwc_barrel-picks-{{ section.id }}" class="cwc_barrel-picks">
  <div class="cwc_barrel-picks__container">
    <div class="cwc_barrel-picks__wrapper">
      {% comment %} Left — copy + CTA {% endcomment %}
      <div class="cwc_barrel-picks__content">
        {% if section.settings.eyebrow != blank %}
          <p class="cwc_barrel-picks__content-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_barrel-picks__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_barrel-picks__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank and button_link %}
          <a href="{{ button_link }}" class="cwc_barrel-picks__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      {% comment %}
        Right — barrel picks from the featured collection. Always a rail: three
        cards fill the column on desktop, two on mobile, and the rest are
        reached by dragging or by the arrows.
      {% endcomment %}
      <div class="cwc_barrel-picks__carousel" data-cwc-carousel>
        <button
          type="button"
          class="cwc_barrel-picks__arrow cwc_barrel-picks__arrow--prev"
          data-cwc-prev
          aria-label="Previous bottles"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M15 18 9 12l6-6" />
          </svg>
        </button>

        <button
          type="button"
          class="cwc_barrel-picks__arrow cwc_barrel-picks__arrow--next"
          data-cwc-next
          aria-label="Next bottles"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>

        <div class="cwc_barrel-picks__grid" data-cwc-track>
        {% if feature_collection != blank and feature_collection.products_count > 0 %}
          {% for product in feature_collection.products limit: section.settings.products_to_show %}
            {% liquid
              assign current_variant = product.selected_or_first_available_variant

              # Same badge ladder as the collection grid. Stock state is deliberately
              # not surfaced — a sold-out card matches an in-stock one.
              assign badge_label = ''
              assign badge_style = ''
              if product.compare_at_price > product.price
                assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
                assign badge_label = '-' | append: discount | append: '%'
                assign badge_style = 'sale'
              elsif product.tags contains 'Allocated' or product.tags contains 'allocated'
                assign badge_label = 'Allocated'
                assign badge_style = 'allocated'
              elsif product.tags contains 'Barrel Pick' or product.tags contains 'barrel pick'
                assign badge_label = 'Barrel Pick'
                assign badge_style = 'barrel'
              elsif product.tags contains 'New' or product.tags contains 'new'
                assign badge_label = 'New'
                assign badge_style = 'new'
              endif

              # Detail line: metafield first, product type as the fallback
              assign product_meta = product.metafields.custom.details
              if product_meta == blank
                assign product_meta = product.type
              endif
            %}

            <div class="cwc_barrel-picks__card">
              <a href="{{ product.url }}" class="cwc_barrel-picks__card-image" tabindex="-1" aria-hidden="true">
                {% if product.featured_image != blank %}
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="500"
                    height="667"
                  >
                {% else %}
                  <span class="cwc_barrel-picks__card-placeholder">
                    <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
                      <rect x="16" y="0" width="20" height="6" rx="2" />
                      <rect x="18" y="6" width="16" height="11" />
                      <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
                    </svg>
                  </span>
                {% endif %}

                {% if badge_label != blank %}
                  <span class="cwc_barrel-picks__card-badge cwc_barrel-picks__card-badge--{{ badge_style }}">
                    {{ badge_label }}
                  </span>
                {% endif %}
              </a>

              <div class="cwc_barrel-picks__card-body">
                {% if product.vendor != blank %}
                  <div class="cwc_barrel-picks__card-brand">{{ product.vendor }}</div>
                {% endif %}

                <a href="{{ product.url }}" class="cwc_barrel-picks__card-title">{{ product.title }}</a>

                {% if product_meta != blank %}
                  <div class="cwc_barrel-picks__card-text">{{ product_meta }}</div>
                {% endif %}

                {% comment %}
                  Sold-out swaps the add-to-cart button for a visually identical
                  link to the product page, so the control never silently fails.
                {% endcomment %}
                <div class="cwc_barrel-picks__card-footer">
                  <div class="cwc_barrel-picks__card-price">
                    {% if product.compare_at_price > product.price %}
                      <span class="cwc_barrel-picks__card-price-was">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    {{ product.price | money }}
                  </div>

                  {%- capture cart_icon -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                      <line x1="3" y1="6" x2="21" y2="6" />
                      <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                  {%- endcapture -%}

                  {% if product.available %}
                    <button
                      type="button"
                      class="cwc_barrel-picks__card-button"
                      data-variant-id="{{ current_variant.id }}"
                      aria-label="Add {{ product.title | escape }} to cart"
                    >
                      {% comment %} {{ cart_icon }} {% endcomment %}
                      Add
                    </button>
                  {% else %}
                    <a
                      href="{{ product.url }}"
                      class="cwc_barrel-picks__card-button"
                      aria-label="View {{ product.title | escape }}"
                    >
                      {% comment %} {{ cart_icon }} {% endcomment %}
                      Add
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="cwc_barrel-picks__empty">
            <p>Select a collection to show your barrel picks here.</p>
          </div>
        {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'CWC_barrel_picks.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Barrel Picks",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Estates Barrel Program"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>We taste every<br>barrel before<br>we buy it.</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Our team travels to the distillery, tastes through the barrel line-up, and buys the ones we would pour ourselves. Each pick is labeled with the barrel number, warehouse, and floor.</p>"
    },
    {
      "type": "header",
      "content": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Supplies the bottles shown and the button destination."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Bottles To Show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 6,
      "info": "How many load into the rail. Anything past Cards Per View is reached by scrolling."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Barrel Picks"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link Override",
      "info": "Defaults to the collection above."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards Per View (Desktop)",
      "info": "Anything past this is reached by dragging or by the arrows.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Cards Per View (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E0DDD6"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Color",
      "default": "#0A1F12"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#F2EFE8"
    },
    {
      "type": "color",
      "id": "card_media_bg_color",
      "label": "Card Image Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Detail Color",
      "default": "#9A9A9A"
    },
    {
      "type": "color",
      "id": "card_brand_color",
      "label": "Card Brand Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "card_button_bg_color",
      "label": "Add To Cart Button Color",
      "default": "#0A1F12"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Barrel Picks",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
