{% style %}
  #cwc_barrel-picks-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#13241C' }};
    --highlight-color: {{ section.settings.bold_color | default: '#8A6A2E' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#8A6A2E' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#5C5C57' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#F4F0E8' }};
    --card-media-bg: {{ section.settings.card_media_bg_color | default: '#ffffff' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#13241C' }};
    --card-text-color: {{ section.settings.card_text_color | default: '#5C5C57' }};
    --card-brand-color: {{ section.settings.card_brand_color | default: '#1F3A2E' }};
    --border-color: {{ section.settings.border_color | default: '#ECECE8' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#13241C' }};
    --button-bg: {{ section.settings.card_button_bg_color | default: '#E9A23B' }};
    --per-view: {{ section.settings.columns | default: 3 }};
    --per-view-mobile: {{ section.settings.columns_mobile | default: 2 }};
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_card.css' | asset_url | stylesheet_tag }}
{{ 'CWC_barrel_picks.css' | asset_url | stylesheet_tag }}

{% liquid
  assign feature_collection = section.settings.collection

  if section.settings.button_link != blank
    assign button_link = section.settings.button_link
  elsif feature_collection != blank
    assign button_link = feature_collection.url
  else
    assign button_link = null
  endif
%}

<section id="cwc_barrel-picks-{{ section.id }}" class="cwc_barrel-picks">
  <div class="cwc_barrel-picks__container">
    <div class="cwc_barrel-picks__wrapper">
      {% comment %} Left — copy + CTA {% endcomment %}
      <div class="cwc_barrel-picks__content">
        {% if section.settings.eyebrow != blank %}
          <p class="cwc_barrel-picks__content-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_barrel-picks__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_barrel-picks__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank and button_link %}
          <a href="{{ button_link }}" class="cwc_barrel-picks__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      {% comment %}
        Right — barrel picks from the featured collection. Always a rail: three
        cards fill the column on desktop, two on mobile, and the rest are
        reached by dragging or by the arrows.
      {% endcomment %}
      <div class="cwc_barrel-picks__carousel" data-cwc-carousel>
        <button
          type="button"
          class="cwc_barrel-picks__arrow cwc_barrel-picks__arrow--prev"
          data-cwc-prev
          aria-label="Previous bottles"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M15 18 9 12l6-6" />
          </svg>
        </button>

        <button
          type="button"
          class="cwc_barrel-picks__arrow cwc_barrel-picks__arrow--next"
          data-cwc-next
          aria-label="Next bottles"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>

        <div class="cwc_barrel-picks__grid" data-cwc-track>
        {% if feature_collection != blank and feature_collection.products_count > 0 %}
          {% for product in feature_collection.products limit: section.settings.products_to_show %}
            <div class="cwc_barrel-picks__card">
              {% render 'cwc-product-card', product: product, section_settings: section.settings %}
            </div>
          {% endfor %}
        {% else %}
          <div class="cwc_barrel-picks__empty">
            <p>Select a collection to show your barrel picks here.</p>
          </div>
        {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'CWC_product_card.js' | asset_url }}" defer></script>
<script src="{{ 'CWC_barrel_picks.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Barrel Picks",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Estates Barrel Program"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>We taste every<br>barrel before<br>we buy it.</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Our team travels to the distillery, tastes through the barrel line-up, and buys the ones we would pour ourselves. Each pick is labeled with the barrel number, warehouse, and floor.</p>"
    },
    {
      "type": "header",
      "content": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Supplies the bottles shown and the button destination."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Bottles To Show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 6,
      "info": "How many load into the rail. Anything past Cards Per View is reached by scrolling."
    },
    {
      "type": "checkbox",
      "id": "show_card_vendor",
      "label": "Show Brand On Cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_meta",
      "label": "Show Detail Line On Cards",
      "default": false
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Barrel Picks"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link Override",
      "info": "Defaults to the collection above."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards Per View (Desktop)",
      "info": "Anything past this is reached by dragging or by the arrows.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Cards Per View (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#13241C"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#8A6A2E"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#8A6A2E"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ECECE8"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Color",
      "default": "#13241C"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#F4F0E8"
    },
    {
      "type": "color",
      "id": "card_media_bg_color",
      "label": "Card Image Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#13241C"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Detail Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "card_brand_color",
      "label": "Card Brand Color",
      "default": "#1F3A2E"
    },
    {
      "type": "color",
      "id": "card_button_bg_color",
      "label": "Add To Cart Button Color",
      "default": "#E9A23B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Barrel Picks",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
