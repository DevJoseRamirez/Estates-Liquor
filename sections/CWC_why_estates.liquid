{%- comment -%}
  CWC Why Estates — dark-green authority band: gold mono eyebrow, Fraunces
  headline with a gold italic phrase, then up to four reasons in columns split
  by hairlines. Each reason: outlined icon box, Fraunces title, short line.
  Desktop: one row; tablet: 2 x 2; mobile: stacked.
{%- endcomment -%}

{% style %}
  #cwc_why-estates-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#13241C' }};
    --text-color: {{ section.settings.text_color | default: '#FFFFFF' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C49340' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C49340' }};
    --icon-color: {{ section.settings.icon_color | default: '#C49340' }};
    --icon-border: {{ section.settings.icon_border_color | default: 'rgba(196, 147, 64, 0.5)' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#FFFFFF' }};
    --card-text-color: {{ section.settings.card_text_color | default: 'rgba(255, 255, 255, 0.7)' }};
    --divider-color: {{ section.settings.divider_color | default: 'rgba(196, 147, 64, 0.3)' }};
    --columns: {{ section.blocks.size | at_least: 1 | at_most: 4 }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.65 | round }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.65 | round }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_why_estates.css' | asset_url | stylesheet_tag }}

<section id="cwc_why-estates-{{ section.id }}" class="cwc_why-estates">
  <div class="cwc_why-estates__container">

    {% comment %} Section Header {% endcomment %}
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="cwc_why-estates__content">
        {% if section.settings.eyebrow != blank %}
          <p class="cwc_why-estates__content-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_why-estates__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% comment %} Reasons {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_why-estates__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'reason' %}
              <div class="cwc_why-estates__card" {{ block.shopify_attributes }}>
                {% if block.settings.custom_icon != blank %}
                  <span class="cwc_why-estates__card-icon">
                    <img
                      src="{{ block.settings.custom_icon | image_url: width: 96 }}"
                      alt=""
                      width="24"
                      height="24"
                      loading="lazy"
                    >
                  </span>
                {% elsif block.settings.icon != 'none' %}
                  <span class="cwc_why-estates__card-icon">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
                      {% case block.settings.icon %}
                        {% when 'shield' %}
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4" />
                        {% when 'package' %}
                          <path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10" />
                        {% when 'clock' %}
                          <path d="M12 6v6l4 2 M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18" />
                        {% when 'phone' %}
                          <path d="M5 3h4l2 5-3 2a12 12 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 3 5a2 2 0 0 1 2-2z" />
                        {% when 'store' %}
                          <path d="M3 9h18v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                          <path d="M3 9l2-5h14l2 5" />
                          <path d="M9 21v-6h6v6" />
                        {% when 'truck' %}
                          <rect x="1" y="4" width="15" height="12" rx="1" />
                          <path d="M16 8h4l3 3v5h-7V8z" />
                          <circle cx="5.5" cy="18.5" r="2.5" />
                          <circle cx="18.5" cy="18.5" r="2.5" />
                        {% when 'tag' %}
                          <path d="M20.6 13.4L12 22l-9-9V3h10z" />
                          <circle cx="7.5" cy="7.5" r="1.5" />
                        {% when 'star' %}
                          <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
                        {% when 'bottle' %}
                          <path d="M10 2.5h4V6l2 3.2V21H8V9.2L10 6V2.5z" />
                          <path d="M8 13h8" />
                        {% when 'check' %}
                          <path d="M4 12.5l5 5L20 6.5" />
                      {% endcase %}
                    </svg>
                  </span>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h3 class="cwc_why-estates__card-title">{{ block.settings.title | escape }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="cwc_why-estates__card-text cwc-rte">
                    {{ block.settings.text }}
                  </div>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cwc_why-estates__empty">
        <p>Add reasons to display this section.</p>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "CWC Why Estates",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Estates"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Bought right. <em>Shipped right.</em></p>",
      "info": "Italic or bold words use the Heading Accent Color."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#13241C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Accent Color",
      "default": "#C49340"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C49340"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#C49340"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon Box Outline Color",
      "info": "Leave empty for a soft gold outline."
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Reason Title Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Reason Text Color",
      "info": "Leave empty for soft white."
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "info": "Leave empty for a soft gold hairline."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No Icon" },
            { "value": "shield", "label": "Shield" },
            { "value": "package", "label": "Package" },
            { "value": "clock", "label": "Clock" },
            { "value": "phone", "label": "Phone" },
            { "value": "store", "label": "Storefront" },
            { "value": "truck", "label": "Shipping Truck" },
            { "value": "tag", "label": "Price Tag" },
            { "value": "star", "label": "Star" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon (Optional)",
          "info": "Overrides the icon above. Small square transparent PNG or SVG."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Authentic bottles"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every bottle sold by a licensed California retailer.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CWC Why Estates",
      "category": "CWC Custom",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "icon": "shield",
            "title": "Authentic bottles",
            "text": "<p>Every bottle sold by a licensed California retailer.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "package",
            "title": "Packed for glass",
            "text": "<p>Molded inserts, and replaced if broken or lost with shipping protection.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "clock",
            "title": "Listed the day it lands",
            "text": "<p>Allocated releases at fair retail. No lottery, no waitlist.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "phone",
            "title": "A real store in Coronado",
            "text": "<p>Call <a href=\"tel:6197913613\">619-791-3613</a> and talk to someone who knows the shelf.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
