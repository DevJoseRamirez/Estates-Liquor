{% style %}
  #cwc_collection-header-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --text-color: {{ section.settings.text_color | default: '#14281D' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A35A12' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#3A3A36' }};
    --meta-color: {{ section.settings.meta_color | default: '#5C5C57' }};
    --border-color: {{ section.settings.border_color | default: '#ECECE8' }};
    --pill-border: {{ section.settings.pill_border_color | default: '#D9D9D3' }};
    --pill-bg: {{ section.settings.pill_bg_color | default: '#FFFFFF' }};
    --pill-text: {{ section.settings.pill_text_color | default: '#14281D' }};
    --pill-active-bg: {{ section.settings.pill_active_bg_color | default: '#E9A23B' }};
    --pill-active-text: {{ section.settings.pill_active_text_color | default: '#14281D' }};
    --padding-top: {{ section.settings.padding_top | default: 36 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 32 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 36 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 32 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_collection_header.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Also used on templates/search.json: title becomes the search terms, a search box replaces
  # the intro and the pill row is hidden.
  assign is_search = false
  if template.name == 'search'
    assign is_search = true
  endif

  assign current = collection
  assign parent_collection = current.metafields.custom.parent_collection.value

  # Pills: collection metafield first, then the fixed pill blocks, else none
  assign meta_pills = current.metafields.custom.sub_collections.value
  assign pill_source = 'none'
  if is_search
    assign pill_source = 'none'
  elsif meta_pills != blank and meta_pills.size > 0
    assign pill_source = 'metafield'
  elsif section.blocks.size > 0
    assign pill_source = 'blocks'
  endif

  # Big count beside the title: in-stock count from the availability filter
  # when the store exposes one, else the collection's product count.
  assign count_value = nil
  assign count_label = 'Bottles'
  unless is_search or current == blank
    for filter in current.filters
      if filter.param_name == 'filter.v.availability'
        for value in filter.values
          if value.value == '1'
            assign count_value = value.count
            assign count_label = 'Bottles in stock'
          endif
        endfor
      endif
    endfor
    if count_value == nil
      assign count_value = current.products_count
    endif
  endunless
-%}

<section id="cwc_collection-header-{{ section.id }}" class="cwc_collection-header">
  <div class="cwc_collection-header__container">

    {% if section.settings.show_breadcrumb %}
      <nav class="cwc_collection-header__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="cwc_collection-header__breadcrumb-link">Home</a>
        {% if parent_collection != blank %}
          <span class="cwc_collection-header__breadcrumb-sep" aria-hidden="true">/</span>
          <a href="{{ parent_collection.url }}" class="cwc_collection-header__breadcrumb-link">{{ parent_collection.title | escape }}</a>
        {% endif %}
        {% if is_search %}
          <span class="cwc_collection-header__breadcrumb-sep" aria-hidden="true">/</span>
          <span class="cwc_collection-header__breadcrumb-current" aria-current="page">{{ section.settings.search_crumb | default: 'Search' | escape }}</span>
        {% elsif current != blank %}
          <span class="cwc_collection-header__breadcrumb-sep" aria-hidden="true">/</span>
          <span class="cwc_collection-header__breadcrumb-current" aria-current="page">{{ current.title | escape }}</span>
        {% endif %}
      </nav>
    {% endif %}

    <div class="cwc_collection-header__intro">
    <div class="cwc_collection-header__content">
      <h1 class="cwc_collection-header__content-heading">
        {%- if is_search -%}
          {%- if search.performed -%}
            {{- section.settings.search_results_title | default: 'Results for' | escape }} “{{ search.terms | escape }}”
          {%- else -%}
            {{- section.settings.search_title | default: 'Search' | escape -}}
          {%- endif -%}
        {%- elsif section.settings.title != blank -%}
          {{- section.settings.title | escape -}}
        {%- elsif current != blank -%}
          {{- current.title | escape -}}
        {%- else -%}
          Collection title
        {%- endif -%}
      </h1>

      {% if is_search %}
        <form action="{{ routes.search_url }}" method="get" role="search" class="cwc_collection-header__search">
          <label class="cwc_collection-header__search-label" for="cwc_collection-header-search-{{ section.id }}">Search the store</label>
          <input
            id="cwc_collection-header-search-{{ section.id }}"
            type="search"
            name="q"
            class="cwc_collection-header__search-input"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | default: 'Search a bottle, brand or spirit' | escape }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <input type="hidden" name="type" value="product">
          <button type="submit" class="cwc_collection-header__search-submit">
            {{- section.settings.search_button_label | default: 'Search' | escape -}}
          </button>
        </form>
      {% elsif section.settings.show_description and section.settings.description != blank %}
        <div class="cwc_collection-header__content-subtext cwc-rte">
          {{ section.settings.description }}
        </div>
      {% elsif section.settings.show_description and current.description != blank %}
        <div class="cwc_collection-header__content-subtext cwc-rte">
          {{ current.description }}
        </div>
      {% endif %}
    </div>

    {% if count_value != nil %}
      <p class="cwc_collection-header__count">
        <span class="cwc_collection-header__count-number">{{ count_value }}</span>
        <span class="cwc_collection-header__count-label">{{ count_label }}</span>
      </p>
    {% endif %}
    </div>

    {% if pill_source != 'none' %}
      <ul class="cwc_collection-header__pills" role="list">
        {% if section.settings.show_all_pill and current != blank %}
          <li class="cwc_collection-header__pill-item">
            <a href="{{ current.url }}" class="cwc_collection-header__pill cwc_collection-header__pill--active" aria-current="page">
              {{- section.settings.all_label | default: 'All' | escape -}}
            </a>
          </li>
        {% endif %}

        {% if pill_source == 'metafield' %}
          {% for pill_collection in meta_pills %}
            {% if pill_collection == blank or pill_collection.handle == current.handle %}{% continue %}{% endif %}
            {%- liquid
              assign pill_check = pill_collection.handle | append: ' ' | append: pill_collection.title | downcase
              assign pill_allocation = false
              if pill_check contains 'allocat'
                assign pill_allocation = true
              endif
            -%}
            <li class="cwc_collection-header__pill-item">
              <a href="{{ pill_collection.url }}" class="cwc_collection-header__pill{% if pill_allocation %} cwc_collection-header__pill--allocation{% endif %}">{{ pill_collection.title | escape }}</a>
            </li>
          {% endfor %}
        {% else %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'pill' %}
                {%- liquid
                  assign pill_collection = block.settings.collection
                  assign pill_label = block.settings.label
                  if pill_label == blank and pill_collection != blank
                    assign pill_label = pill_collection.title
                  endif
                  assign pill_active = false
                  if pill_collection != blank and pill_collection.handle == current.handle
                    assign pill_active = true
                  endif
                  # The Allocation pill gets the amber-text outline
                  assign pill_check = pill_collection.handle | append: ' ' | append: pill_label | downcase
                  assign pill_allocation = false
                  if pill_check contains 'allocat'
                    assign pill_allocation = true
                  endif
                -%}
                {% if pill_collection != blank and pill_label != blank %}
                  {% unless pill_active and section.settings.show_all_pill %}
                    <li class="cwc_collection-header__pill-item" {{ block.shopify_attributes }}>
                      <a
                        href="{{ pill_collection.url }}"
                        class="cwc_collection-header__pill{% if pill_active %} cwc_collection-header__pill--active{% elsif pill_allocation %} cwc_collection-header__pill--allocation{% endif %}"
                        {% if pill_active %}aria-current="page"{% endif %}
                      >
                        {{- pill_label | escape -}}
                      </a>
                    </li>
                  {% endunless %}
                {% endif %}
            {% endcase %}
          {% endfor %}
        {% endif %}
      </ul>
    {% endif %}

  </div>
</section>

