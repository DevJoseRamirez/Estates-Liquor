{% style %}
  #cwc_rare-allocated-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#0A1F12' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#C4933F' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};

    {% comment %}
      Cards mirror the collection grid, so they carry their own light palette
      rather than inheriting the dark panel's --text-color.
    {% endcomment %}
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-text-color: {{ section.settings.card_text_color | default: '#0A1F12' }};
    --card-meta-color: {{ section.settings.card_meta_color | default: '#9A9A9A' }};
    --card-media-bg: {{ section.settings.card_media_bg_color | default: '#F2EFE8' }};
    --card-border-color: {{ section.settings.card_border_color | default: '#E0DDD6' }};
    --card-button-bg: {{ section.settings.card_button_bg_color | default: '#0A1F12' }};
    --decor-opacity: {{ section.settings.decor_opacity | default: 16 | divided_by: 100.0 }};
    --per-view: {{ section.settings.cards_per_view | default: 2 }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_rare_allocated.css' | asset_url | stylesheet_tag }}

{% liquid
  assign feature_collection = section.settings.collection

  if section.settings.button_link != blank
    assign button_link = section.settings.button_link
  elsif feature_collection != blank
    assign button_link = feature_collection.url
  else
    assign button_link = null
  endif
%}

<section id="cwc_rare-allocated-{{ section.id }}" class="cwc_rare-allocated">
  {% comment %} Decorative bottle silhouettes — purely visual, hidden from AT {% endcomment %}
  {% if section.settings.show_decor %}
    <span class="cwc_rare-allocated__decor" aria-hidden="true">
      <svg class="cwc_rare-allocated__decor-bottle cwc_rare-allocated__decor-bottle--1" width="28" height="72" viewBox="0 0 28 72" focusable="false">
        <rect x="9" y="0" width="10" height="8" rx="2" fill="#bf8d3a"/>
        <path d="M4 8 Q2 14 2 20 L2 62 Q2 68 14 68 Q26 68 26 62 L26 20 Q26 14 24 8 Z" fill="#bf8d3a"/>
      </svg>

      <svg class="cwc_rare-allocated__decor-bottle cwc_rare-allocated__decor-bottle--2" width="28" height="86" viewBox="0 0 28 86" focusable="false">
        <rect x="9" y="0" width="10" height="8" rx="2" fill="#a8ccb4"/>
        <path d="M4 8 Q2 14 2 20 L2 76 Q2 82 14 82 Q26 82 26 76 L26 20 Q26 14 24 8 Z" fill="#a8ccb4"/>
      </svg>

      <svg class="cwc_rare-allocated__decor-bottle cwc_rare-allocated__decor-bottle--3" width="28" height="72" viewBox="0 0 28 72" focusable="false">
        <rect x="9" y="0" width="10" height="8" rx="2" fill="#bf8d3a"/>
        <path d="M4 8 Q2 14 2 20 L2 62 Q2 68 14 68 Q26 68 26 62 L26 20 Q26 14 24 8 Z" fill="#bf8d3a"/>
      </svg>
    </span>
  {% endif %}

  <div class="cwc_rare-allocated__container">
    <div class="cwc_rare-allocated__wrapper">
      {% comment %} Left — copy, CTA, stats {% endcomment %}
      <div class="cwc_rare-allocated__content">
        {% if section.settings.eyebrow != blank %}
          <p class="cwc_rare-allocated__content-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_rare-allocated__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_rare-allocated__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank and button_link %}
          <a href="{{ button_link }}" class="cwc_rare-allocated__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="cwc_rare-allocated__stats">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'stat' %}
                  <div class="cwc_rare-allocated__stat" {{ block.shopify_attributes }}>
                    {% if block.settings.number != blank %}
                      <span class="cwc_rare-allocated__stat-number">{{ block.settings.number }}</span>
                    {% endif %}
                    {% if block.settings.label != blank %}
                      <span class="cwc_rare-allocated__stat-label">{{ block.settings.label }}</span>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% comment %}
        Right — products from the featured collection. Always a rail: two cards
        fill the column and the rest are reached by dragging or by the arrows.
      {% endcomment %}
      <div class="cwc_rare-allocated__carousel" data-cwc-carousel>
        <button
          type="button"
          class="cwc_rare-allocated__arrow cwc_rare-allocated__arrow--prev"
          data-cwc-prev
          aria-label="Previous bottles"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M15 18 9 12l6-6" />
          </svg>
        </button>

        <button
          type="button"
          class="cwc_rare-allocated__arrow cwc_rare-allocated__arrow--next"
          data-cwc-next
          aria-label="Next bottles"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>

      <div class="cwc_rare-allocated__grid" data-cwc-track>
        {% if feature_collection != blank and feature_collection.products_count > 0 %}
          {% for product in feature_collection.products limit: section.settings.products_to_show %}
            {% liquid
              assign current_variant = product.selected_or_first_available_variant

              # Same badge ladder as the collection grid — stock state is
              # deliberately not surfaced, so a sold-out card looks identical.
              assign badge_label = ''
              assign badge_style = ''
              if product.compare_at_price > product.price
                assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
                assign badge_label = '-' | append: discount | append: '%'
                assign badge_style = 'sale'
              elsif product.tags contains 'Allocated' or product.tags contains 'allocated'
                assign badge_label = 'Allocated'
                assign badge_style = 'allocated'
              elsif product.tags contains 'Barrel Pick' or product.tags contains 'barrel pick'
                assign badge_label = 'Barrel Pick'
                assign badge_style = 'barrel'
              elsif product.tags contains 'New' or product.tags contains 'new'
                assign badge_label = 'New'
                assign badge_style = 'new'
              endif

              # Detail line: metafield first, product type as the fallback
              assign product_meta = product.metafields.custom.details
              if product_meta == blank
                assign product_meta = product.type
              endif
            %}

            <div class="cwc_rare-allocated__card">
              <a href="{{ product.url }}" class="cwc_rare-allocated__card-media" tabindex="-1" aria-hidden="true">
                {% if product.featured_image != blank %}
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="500"
                    height="667"
                  >
                {% else %}
                  <span class="cwc_rare-allocated__card-placeholder">
                    <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
                      <rect x="16" y="0" width="20" height="6" rx="2" />
                      <rect x="18" y="6" width="16" height="11" />
                      <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
                    </svg>
                  </span>
                {% endif %}

                {% if badge_label != blank %}
                  <span class="cwc_rare-allocated__card-badge cwc_rare-allocated__card-badge--{{ badge_style }}">
                    {{ badge_label }}
                  </span>
                {% endif %}
              </a>

              <div class="cwc_rare-allocated__card-body">
                {% if product.vendor != blank %}
                  <div class="cwc_rare-allocated__card-brand">{{ product.vendor }}</div>
                {% endif %}

                <a href="{{ product.url }}" class="cwc_rare-allocated__card-title">{{ product.title }}</a>

                {% if product_meta != blank %}
                  <div class="cwc_rare-allocated__card-text">{{ product_meta }}</div>
                {% endif %}

                {% comment %}
                  Sold-out swaps the add-to-cart button for a visually identical
                  link to the product page, so the control never silently fails.
                {% endcomment %}
                <div class="cwc_rare-allocated__card-footer">
                  <div class="cwc_rare-allocated__card-price">
                    {% if product.compare_at_price > product.price %}
                      <span class="cwc_rare-allocated__card-price-was">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    {{ product.price | money }}
                  </div>

                  {%- capture cart_icon -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                      <line x1="3" y1="6" x2="21" y2="6" />
                      <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                  {%- endcapture -%}

                  {% if product.available %}
                    <button
                      type="button"
                      class="cwc_rare-allocated__card-button"
                      data-variant-id="{{ current_variant.id }}"
                      aria-label="Add {{ product.title | escape }} to cart"
                    >
                      {% comment %} {{ cart_icon }} {% endcomment %}
                      Add
                    </button>
                  {% else %}
                    <a
                      href="{{ product.url }}"
                      class="cwc_rare-allocated__card-button"
                      aria-label="View {{ product.title | escape }}"
                    >
                      {% comment %} {{ cart_icon }} {% endcomment %}
                      Add
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="cwc_rare-allocated__empty">
            <p>Select a collection to show its bottles here.</p>
          </div>
        {% endif %}
      </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'CWC_rare_allocated.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Rare And Allocated",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rare & Allocated"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>The bottles that<br>rarely reach<br>the shelf.</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Allocated releases arrive in small quantities and leave fast. We list them at fair retail — no lottery, no markup games. When a bottle lands, it goes live.</p>"
    },
    {
      "type": "header",
      "content": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Supplies the bottles shown and the button destination."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Bottles To Show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 6,
      "info": "How many load into the rail. Anything past Cards In View is reached by scrolling."
    },
    {
      "type": "range",
      "id": "cards_per_view",
      "label": "Cards In View",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Rare & Allocated"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link Override",
      "info": "Defaults to the collection above."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Background Decoration"
    },
    {
      "type": "checkbox",
      "id": "show_decor",
      "label": "Show Bottle Silhouettes",
      "default": true
    },
    {
      "type": "range",
      "id": "decor_opacity",
      "label": "Silhouette Opacity",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 16,
      "info": "Higher values compete with the copy sitting over them.",
      "visible_if": "{{ section.settings.show_decor }}"
    },
    {
      "type": "header",
      "content": "Card Colors",
      "info": "Defaults match the collection grid cards."
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "card_meta_color",
      "label": "Card Detail Line Color",
      "default": "#9A9A9A"
    },
    {
      "type": "color",
      "id": "card_media_bg_color",
      "label": "Card Image Background Color",
      "default": "#F2EFE8"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#E0DDD6"
    },
    {
      "type": "color",
      "id": "card_button_bg_color",
      "label": "Quick Add Button Color",
      "default": "#0A1F12"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Stat Number",
          "default": "40+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "Allocated Releases"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Rare And Allocated",
      "category": "CWC Custom",
      "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }]
    }
  ]
}
{% endschema %}
