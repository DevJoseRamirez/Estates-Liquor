{% style %}
  #cwc_rare-allocated-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#0A1F12' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#ffffff' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#C4933F' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_rare_allocated.css' | asset_url | stylesheet_tag }}

{% liquid
  assign feature_collection = section.settings.collection

  if section.settings.button_link != blank
    assign button_link = section.settings.button_link
  elsif feature_collection != blank
    assign button_link = feature_collection.url
  else
    assign button_link = nil
  endif
%}

<section id="cwc_rare-allocated-{{ section.id }}" class="cwc_rare-allocated">
  <div class="cwc_rare-allocated__container">
    <div class="cwc_rare-allocated__wrapper">

      {% comment %} Left — copy, CTA, stats {% endcomment %}
      <div class="cwc_rare-allocated__content">
        {% if section.settings.eyebrow != blank %}
          <p class="cwc_rare-allocated__content-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_rare-allocated__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_rare-allocated__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank and button_link %}
          <a href="{{ button_link }}" class="cwc_rare-allocated__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="cwc_rare-allocated__stats">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'stat' %}
                  <div class="cwc_rare-allocated__stat" {{ block.shopify_attributes }}>
                    {% if block.settings.number != blank %}
                      <span class="cwc_rare-allocated__stat-number">{{ block.settings.number }}</span>
                    {% endif %}
                    {% if block.settings.label != blank %}
                      <span class="cwc_rare-allocated__stat-label">{{ block.settings.label }}</span>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% comment %} Right — products from the featured collection {% endcomment %}
      <div class="cwc_rare-allocated__grid">
        {% if feature_collection != blank and feature_collection.products_count > 0 %}
          {% for product in feature_collection.products limit: section.settings.products_to_show %}
            <a href="{{ product.url }}" class="cwc_rare-allocated__card">
              <span class="cwc_rare-allocated__card-image">
                {% if product.featured_image != blank %}
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="500"
                    height="500"
                  >
                {% else %}
                  <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
                    <rect x="16" y="0" width="20" height="6" rx="2" fill="currentColor" />
                    <rect x="18" y="6" width="16" height="11" fill="currentColor" />
                    <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" fill="currentColor" />
                  </svg>
                {% endif %}
              </span>

              <span class="cwc_rare-allocated__card-body">
                {% if product.vendor != blank %}
                  <span class="cwc_rare-allocated__card-brand">{{ product.vendor }}</span>
                {% endif %}
                <span class="cwc_rare-allocated__card-title">{{ product.title }}</span>
                <span class="cwc_rare-allocated__card-price">{{ product.price | money }}</span>
              </span>
            </a>
          {% endfor %}
        {% else %}
          <div class="cwc_rare-allocated__empty">
            <p>Select a collection to show its bottles here.</p>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Rare And Allocated",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rare & Allocated"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>The bottles that<br>rarely reach<br>the shelf.</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Allocated releases arrive in small quantities and leave fast. We list them at fair retail — no lottery, no markup games. When a bottle lands, it goes live.</p>"
    },
    {
      "type": "header",
      "content": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Supplies the bottles shown and the button destination."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Bottles To Show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Rare & Allocated"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link Override",
      "info": "Defaults to the collection above."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Stat Number",
          "default": "40+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "Allocated Releases"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Rare And Allocated",
      "category": "CWC Custom",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
