{% style %}
  #cwc_search-body-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#14281D' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A35A12' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#5C5C57' }};
    --meta-color: {{ section.settings.meta_color | default: '#5C5C57' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-media-bg: {{ section.settings.card_media_bg_color | default: '#FFFFFF' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E9A23B' }};
    --card-button-bg: {{ section.settings.button_bg_color | default: '#E9A23B' }};
    --border-color: {{ section.settings.border_color | default: '#DEDED8' }};
    --off-white: {{ section.settings.muted_bg_color | default: '#FBF1E4' }};
    --columns: {{ section.settings.columns | default: 4 }};
    --sidebar-width: {{ section.settings.sidebar_width | default: 250 }}px;
    --padding-top: {{ section.settings.padding_top | default: 35 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 35 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{% comment %}
  Shares CWC_collection_body's stylesheet, script and product card on purpose:
  the search grid, filters and cards must stay identical to the collection
  page. Only search-specific pieces live in CWC_search_body.css.
{% endcomment %}
{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_collection_body.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_card.css' | asset_url | stylesheet_tag }}
{{ 'CWC_search_body.css' | asset_url | stylesheet_tag }}

{% liquid
  assign terms = search.terms | escape

  # Search params every link/form on the page has to carry so a filter, sort
  # or "clear" never drops the query itself
  assign search_types = search.types | join: ','
  assign encoded_terms = search.terms | url_encode
  assign base_query = 'q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'
  if search_types != blank
    assign base_query = base_query | append: '&type=' | append: search_types
  endif
  assign clear_url = routes.search_url | append: '?' | append: base_query

  # Current filter selections, rebuilt as a query string so sort links keep them
  assign filter_query = ''
  for filter in search.filters
    for value in filter.active_values
      # Values can hold spaces, &, ' or # — encode or the sort links break
      assign encoded_value = value.value | url_encode
      assign pair = value.param_name | append: '=' | append: encoded_value
      assign filter_query = filter_query | append: '&' | append: pair
    endfor
    if filter.type == 'price_range'
      if filter.min_value.value != nil
        assign encoded_value = filter.min_value.value | url_encode
        assign filter_query = filter_query | append: '&' | append: filter.min_value.param_name | append: '=' | append: encoded_value
      endif
      if filter.max_value.value != nil
        assign encoded_value = filter.max_value.value | url_encode
        assign filter_query = filter_query | append: '&' | append: filter.max_value.param_name | append: '=' | append: encoded_value
      endif
    endif
  endfor

  assign active_filter_count = 0
  for filter in search.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
  endfor
%}

{%- capture search_hidden_inputs -%}
  <input type="hidden" name="q" value="{{ terms }}">
  <input type="hidden" name="options[prefix]" value="last">
  {%- if search_types != blank -%}
    <input type="hidden" name="type" value="{{ search_types }}">
  {%- endif -%}
{%- endcapture -%}

{% if search.performed %}
  {% paginate search.results by section.settings.products_per_page %}
    {%- comment -%}
      Products tagged no_feed never render — same rule as the collection grid —
      so counts are measured against the visible set. See CWC_collection_body.
    {%- endcomment -%}
    {%- liquid
      assign hidden_count = 0
      for item in search.results
        if item.object_type == 'product'
          assign no_feed_check = item.tags | join: ',' | downcase | prepend: ',' | append: ','
          if no_feed_check contains ',no_feed,'
            assign hidden_count = hidden_count | plus: 1
          endif
        endif
      endfor
      assign page_visible = search.results.size | minus: hidden_count
      assign adjusted_items = paginate.items | minus: hidden_count
      assign shown_total = paginate.current_offset | plus: page_visible
    -%}
    <section
      id="cwc_search-body-{{ section.id }}"
      class="cwc_collection-body cwc_search-body"
      data-section-id="{{ section.id }}"
    >

      {% comment %} Mobile filter / sort bar — sticky, tablet and down {% endcomment %}
      <div class="cwc_collection-body__mobile-bar">
        <div class="cwc_collection-body__container cwc_collection-body__mobile-bar-inner">
          <button type="button" class="cwc_collection-body__mobile-button" data-cwc-open="filters">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
              <line x1="4" y1="6" x2="20" y2="6" />
              <line x1="7" y1="12" x2="17" y2="12" />
              <line x1="10" y1="18" x2="14" y2="18" />
            </svg>
            {{ section.settings.filter_label | default: 'Filter' }}
            {% if active_filter_count > 0 %}
              <span class="cwc_collection-body__mobile-badge">{{ active_filter_count }}</span>
            {% endif %}
          </button>

          <button type="button" class="cwc_collection-body__mobile-button" data-cwc-open="sort">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M7 4v16M7 20l-3-3M7 20l3-3" />
              <path d="M17 20V4M17 4l-3 3M17 4l3 3" />
            </svg>
            {{ section.settings.sort_label | default: 'Sort' }}
          </button>
        </div>
      </div>

      <div class="cwc_collection-body__container">
        <div class="cwc_collection-body__layout">

          {% comment %}
            One filter form. Desktop: sticky sidebar. Tablet/mobile: the same
            node becomes a bottom sheet, so filter state can never desync.
          {% endcomment %}
          <aside class="cwc_collection-body__sidebar" data-cwc-sheet="filters" aria-label="Filters">
            <div class="cwc_collection-body__sheet-head">
              <span class="cwc_collection-body__sheet-title">{{ section.settings.filter_label | default: 'Filter' }}</span>
              <button type="button" class="cwc_collection-body__sheet-close" data-cwc-close aria-label="Close filters">&times;</button>
            </div>

            <form method="get" action="{{ routes.search_url }}" class="cwc_collection-body__filter-form" data-cwc-filter-form>
              {{ search_hidden_inputs }}
              {% if search.sort_by != blank %}
                <input type="hidden" name="sort_by" value="{{ search.sort_by }}">
              {% endif %}

              <div class="cwc_collection-body__filter-head">
                <span class="cwc_collection-body__filter-head-title">{{ section.settings.filter_label | default: 'Filter' }}</span>
                {% if active_filter_count > 0 %}
                  <a href="{{ clear_url }}" class="cwc_collection-body__filter-clear">
                    {{ section.settings.clear_label | default: 'Clear All' }}
                  </a>
                {% endif %}
              </div>

              {% if search.filters.size > 0 %}
                {% for filter in search.filters %}
                  <details class="cwc_collection-body__filter-group"{% if filter.active_values.size > 0 or forloop.index <= section.settings.open_filter_groups %} open{% endif %}>
                    <summary class="cwc_collection-body__filter-toggle">
                      {{ filter.label }}
                      <span class="cwc_collection-body__filter-sign" aria-hidden="true"></span>
                    </summary>

                    <div class="cwc_collection-body__filter-body">
                      {% case filter.type %}
                        {% when 'price_range' %}
                          <div class="cwc_collection-body__price">
                            <input
                              type="number"
                              name="{{ filter.min_value.param_name }}"
                              value="{{ filter.min_value.value }}"
                              placeholder="{{ 0 | money_without_currency | strip_html }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | strip_html }}"
                              aria-label="Minimum price"
                            >
                            <span>to</span>
                            <input
                              type="number"
                              name="{{ filter.max_value.param_name }}"
                              value="{{ filter.max_value.value }}"
                              placeholder="{{ filter.range_max | money_without_currency | strip_html }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | strip_html }}"
                              aria-label="Maximum price"
                            >
                          </div>

                        {% else %}
                          <ul class="cwc_collection-body__filter-list">
                            {% for value in filter.values %}
                              <li>
                                <label class="cwc_collection-body__filter-option">
                                  <input
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  <span>{{ value.label }}</span>
                                  <span class="cwc_collection-body__filter-count">{{ value.count }}</span>
                                </label>
                              </li>
                            {% endfor %}
                          </ul>
                      {% endcase %}
                    </div>
                  </details>
                {% endfor %}
              {% else %}
                <p class="cwc_collection-body__filter-empty">
                  No filters are set up for search yet. Add them in Search &amp; Discovery.
                </p>
              {% endif %}

              <div class="cwc_collection-body__sheet-foot">
                <a href="{{ clear_url }}" class="cwc_collection-body__button cwc_collection-body__button--outline">
                  {{ section.settings.clear_label | default: 'Clear All' }}
                </a>
                <button type="submit" class="cwc_collection-body__button cwc_collection-body__button--primary" data-cwc-apply>
                  {{ section.settings.apply_label | default: 'Apply Filters' }}
                </button>
              </div>
            </form>
          </aside>

          {% comment %} Main column {% endcomment %}
          <div class="cwc_collection-body__main">

            <div class="cwc_collection-body__toolbar">
              <p
                class="cwc_collection-body__count"
                data-cwc-count
                data-cwc-noun="{{ section.settings.item_noun | default: 'results' | escape }}"
              >
                {% if adjusted_items > 0 %}
                  Showing
                  <strong data-cwc-count-range>
                    {{ paginate.current_offset | plus: 1 }}–{{ shown_total | at_most: adjusted_items }}
                  </strong>
                  of <span data-cwc-count-total>{{ adjusted_items }}</span>
                  {{ section.settings.item_noun | default: 'results' }}
                {% else %}
                  0 {{ section.settings.item_noun | default: 'results' }}
                {% endif %}
              </p>

              {% if search.sort_options.size > 0 %}
                <form method="get" action="{{ routes.search_url }}" class="cwc_collection-body__sort" data-cwc-sort-form>
                  {{ search_hidden_inputs }}
                  {% for filter in search.filters %}
                    {% for value in filter.active_values %}
                      <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                    {% endfor %}
                    {% if filter.type == 'price_range' %}
                      {% if filter.min_value.value != nil %}
                        <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}">
                      {% endif %}
                      {% if filter.max_value.value != nil %}
                        <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}">
                      {% endif %}
                    {% endif %}
                  {% endfor %}

                  <label for="cwc_sort-{{ section.id }}">{{ section.settings.sort_label | default: 'Sort' }}</label>
                  <select id="cwc_sort-{{ section.id }}" name="sort_by" class="cwc_collection-body__sort-select">
                    {% assign current_sort = search.sort_by | default: search.default_sort_by %}
                    {% for option in search.sort_options %}
                      <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                        {{ option.name }}
                      </option>
                    {% endfor %}
                  </select>
                  <button type="submit" class="cwc_collection-body__sort-submit" data-cwc-sort-submit>Go</button>
                </form>
              {% endif %}
            </div>

            {% if active_filter_count > 0 %}
              <div class="cwc_collection-body__chips">
                {% for filter in search.filters %}
                  {% for value in filter.active_values %}
                    <span class="cwc_collection-body__chip">
                      {{ value.label }}
                      <a href="{{ value.url_to_remove }}" aria-label="Remove filter {{ value.label | escape }}">&times;</a>
                    </span>
                  {% endfor %}
                {% endfor %}
              </div>
            {% endif %}

            {% if page_visible > 0 or paginate.pages > 1 %}
              <div class="cwc_collection-body__grid" data-cwc-grid data-cwc-hidden="{{ hidden_count }}">
                {% for item in search.results %}
                  {% case item.object_type %}
                    {% when 'product' %}
                      {%- assign product_tag_list = item.tags | join: ',' | downcase | prepend: ',' | append: ',' -%}
                      {%- if product_tag_list contains ',no_feed,' -%}
                        {%- continue -%}
                      {%- endif -%}
                      {% render 'cwc-product-card', product: item, section_settings: section.settings %}

                    {% else %}
                      {% comment %}
                        Articles and pages only show up when the search wasn't
                        limited to products (e.g. from the header). Same card
                        frame, text-only body.
                      {% endcomment %}
                      {%- liquid
                        if item.object_type == 'article'
                          assign entry_label = section.settings.article_label | default: 'Article'
                          assign entry_text = item.excerpt_or_content
                        else
                          assign entry_label = section.settings.page_label | default: 'Page'
                          assign entry_text = item.content
                        endif
                      -%}
                      <a href="{{ item.url }}" class="cwc_collection-body__card cwc_search-body__entry">
                        <span class="cwc_search-body__entry-type">{{ entry_label }}</span>
                        <span class="cwc_search-body__entry-title">{{ item.title }}</span>
                        {% if entry_text != blank %}
                          <span class="cwc_search-body__entry-text">{{ entry_text | strip_html | truncatewords: 22 }}</span>
                        {% endif %}
                        <span class="cwc_search-body__entry-link">
                          {{ section.settings.entry_link_label | default: 'Read More' }} &rarr;
                        </span>
                      </a>
                  {% endcase %}
                {% endfor %}
              </div>

              {% if paginate.pages > 1 %}
                {% if section.settings.use_pagination %}
                  <nav class="cwc_collection-body__pagination" aria-label="Pagination">
                    {% if paginate.previous %}
                      <a href="{{ paginate.previous.url }}" aria-label="Previous page">&lsaquo;</a>
                    {% endif %}

                    {% assign current_page_label = paginate.current_page | append: '' %}
                    {% for part in paginate.parts %}
                      {% if part.is_link %}
                        <a href="{{ part.url }}">{{ part.title }}</a>
                      {% elsif part.title == current_page_label %}
                        <span class="cwc_collection-body__pagination-current" aria-current="page">{{ part.title }}</span>
                      {% else %}
                        <span class="cwc_collection-body__pagination-gap">{{ part.title }}</span>
                      {% endif %}
                    {% endfor %}

                    {% if paginate.next %}
                      <a href="{{ paginate.next.url }}" aria-label="Next page">&rsaquo;</a>
                    {% endif %}
                  </nav>
                {% else %}
                  <div class="cwc_collection-body__load">
                    <p
                      class="cwc_collection-body__load-progress"
                      data-cwc-load-progress
                      data-cwc-total-items="{{ paginate.items }}"
                      data-cwc-noun="{{ section.settings.item_noun | default: 'results' | escape }}"
                    >
                      Showing {{ shown_total }} of {{ adjusted_items }}
                      {{ section.settings.item_noun | default: 'results' }}
                    </p>

                    {% assign shown_ratio = shown_total | times: 100 | divided_by: adjusted_items %}
                    <div class="cwc_collection-body__load-bar" aria-hidden="true">
                      <span style="width: {{ shown_ratio }}%;" data-cwc-load-fill></span>
                    </div>

                    {% if paginate.next %}
                      <a
                        href="{{ paginate.next.url }}"
                        class="cwc_collection-body__button cwc_collection-body__button--outline"
                        data-cwc-load-more
                      >
                        {{ section.settings.load_more_label | default: 'Load More' }}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              {% endif %}
            {% else %}
              <div class="cwc_collection-body__empty">
                {% if active_filter_count > 0 %}
                  <p>{{ section.settings.empty_filtered_text | default: 'No bottles match these filters.' }}</p>
                  <a href="{{ clear_url }}" class="cwc_collection-body__button cwc_collection-body__button--outline">
                    {{ section.settings.clear_label | default: 'Clear All' }}
                  </a>
                {% else %}
                  <p>
                    {{ section.settings.no_results_text | default: 'Nothing on the shelf matches [terms].' | replace: '[terms]', terms }}
                  </p>
                  {% if section.settings.browse_link != blank %}
                    <a href="{{ section.settings.browse_link }}" class="cwc_collection-body__button cwc_collection-body__button--outline">
                      {{ section.settings.browse_label | default: 'Browse All Bottles' }}
                    </a>
                  {% endif %}
                {% endif %}
              </div>
            {% endif %}

          </div>
        </div>
      </div>

      {% comment %} Mobile sort sheet — plain links, works with JS disabled {% endcomment %}
      {% if search.sort_options.size > 0 %}
        <div class="cwc_collection-body__sheet" data-cwc-sheet="sort" aria-label="Sort">
          <div class="cwc_collection-body__sheet-head">
            <span class="cwc_collection-body__sheet-title">{{ section.settings.sort_label | default: 'Sort' }}</span>
            <button type="button" class="cwc_collection-body__sheet-close" data-cwc-close aria-label="Close sort">&times;</button>
          </div>

          <div class="cwc_collection-body__sheet-body">
            <ul class="cwc_collection-body__sort-list">
              {% assign current_sort = search.sort_by | default: search.default_sort_by %}
              {% for option in search.sort_options %}
                <li>
                  <a
                    href="{{ clear_url }}&sort_by={{ option.value }}{{ filter_query }}"
                    class="{% if option.value == current_sort %}cwc_collection-body__sort-list-active{% endif %}"
                    {% if option.value == current_sort %}aria-current="true"{% endif %}
                  >
                    {{ option.name }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}

      <div class="cwc_collection-body__overlay" data-cwc-overlay hidden></div>
    </section>
  {% endpaginate %}

{% else %}
  {% comment %} No query yet — the header carries the search box {% endcomment %}
  <section id="cwc_search-body-{{ section.id }}" class="cwc_collection-body cwc_search-body cwc_search-body--idle">
    <div class="cwc_collection-body__container">
      <div class="cwc_collection-body__empty">
        {% if section.settings.idle_text != blank %}
          <p>{{ section.settings.idle_text }}</p>
        {% endif %}
        {% if section.settings.browse_link != blank %}
          <a href="{{ section.settings.browse_link }}" class="cwc_collection-body__button cwc_collection-body__button--outline">
            {{ section.settings.browse_label | default: 'Browse All Bottles' }}
          </a>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

<script src="{{ 'CWC_collection_body.js' | asset_url }}" defer></script>
<script src="{{ 'CWC_product_card.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Search Body",
  "settings": [
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results Per Page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "use_pagination",
      "label": "Use Numbered Pagination",
      "default": false,
      "info": "Off: Load More button with a progress bar. On: numbered page links. Only one shows at a time."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "item_noun",
      "label": "Item Noun",
      "default": "results",
      "info": "Used in \"Showing 1–24 of 60 results\"."
    },
    {
      "type": "header",
      "content": "Empty States"
    },
    {
      "type": "text",
      "id": "idle_text",
      "label": "Before Searching Text",
      "default": "Type a bottle, brand, or style above to search our shelf."
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No Results Text",
      "default": "Nothing on the shelf matches [terms].",
      "info": "[terms] is replaced with what the shopper searched."
    },
    {
      "type": "text",
      "id": "empty_filtered_text",
      "label": "No Filter Matches Text",
      "default": "No bottles match these filters."
    },
    {
      "type": "url",
      "id": "browse_link",
      "label": "Browse Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "browse_label",
      "label": "Browse Link Label",
      "default": "Browse All Bottles"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "range",
      "id": "sidebar_width",
      "label": "Sidebar Width",
      "min": 200,
      "max": 340,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "open_filter_groups",
      "label": "Filter Groups Open By Default",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4,
      "info": "Groups with an active filter always open."
    },
    {
      "type": "paragraph",
      "content": "Search filters come from Shopify's Search & Discovery app (Filters → Search). They only apply to product results."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter Label",
      "default": "Filter"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort Label",
      "default": "Sort"
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear Label",
      "default": "Clear All"
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Apply Label",
      "default": "Apply Filters"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load More Label",
      "default": "Load More",
      "info": "Unused when Numbered Pagination is on."
    },
    {
      "type": "text",
      "id": "article_label",
      "label": "Article Result Label",
      "default": "Article"
    },
    {
      "type": "text",
      "id": "page_label",
      "label": "Page Result Label",
      "default": "Page"
    },
    {
      "type": "text",
      "id": "entry_link_label",
      "label": "Article / Page Link Label",
      "default": "Read More"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#14281D"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#A35A12"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "border_color",
