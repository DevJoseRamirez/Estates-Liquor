{% style %}
  #cwc_email-signup-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#0A1F12' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#ffffff' }};
    --disclaimer-color: {{ section.settings.disclaimer_color | default: '#8E968F' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#C4933F' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};

    {% comment %} Field reads as a raised panel, not a tint of the background {% endcomment %}
    --input-bg: {{ section.settings.input_bg_color | default: '#1A3A25' }};
    --input-border-color: {{ section.settings.input_border_color | default: '#3E5C48' }};
    --input-text-color: {{ section.settings.input_text_color | default: '#ffffff' }};
    --input-placeholder-color: {{ section.settings.input_placeholder_color | default: '#9DAEA3' }};
    --section-border-color: {{ section.settings.section_border_color | default: '#36473D' }};
    --section-border-width: {{ section.settings.section_border_width | default: 1 }}px;
    --success-bg: {{ section.settings.success_bg_color | default: '#163D22' }};
    --success-text-color: {{ section.settings.success_text_color | default: '#ffffff' }};
    --error-bg: {{ section.settings.error_bg_color | default: '#5A1D1D' }};
    --error-text-color: {{ section.settings.error_text_color | default: '#FFD9D9' }};
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_email_signup.css' | asset_url | stylesheet_tag }}

<section id="cwc_email-signup-{{ section.id }}" class="cwc_email-signup">
  <div class="cwc_email-signup__container">
    <div class="cwc_email-signup__content">

      {% if section.settings.eyebrow != blank %}
        <p class="cwc_email-signup__content-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_email-signup__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_email-signup__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}

      {% form 'customer', class: 'cwc_email-signup__form-wrapper' %}
        {% comment %}
          Confirmation and errors sit above the field on a filled panel so they
          stay legible against the dark section background.
        {% endcomment %}
        {% if form.posted_successfully? %}
          <p class="cwc_email-signup__message cwc_email-signup__message--success" role="status">
            {{ section.settings.success_message | default: 'You are on the list. Watch your inbox for the next drop.' }}
          </p>
        {% elsif form.errors %}
          <p class="cwc_email-signup__message cwc_email-signup__message--error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {% endif %}

        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="cwc_email-signup__form">
          <label class="cwc_email-signup__label" for="cwc_email-{{ section.id }}">
            {{ section.settings.placeholder | default: 'Your email address' }}
          </label>

          <input
            id="cwc_email-{{ section.id }}"
            class="cwc_email-signup__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder | default: 'Your email address' | escape }}"
            autocomplete="email"
            required
          >

          <button type="submit" class="cwc_email-signup__button">
            {{ section.settings.button_label | default: 'Get First Access' }}
          </button>
        </div>
      {% endform %}

      {% if section.settings.disclaimer != blank %}
        <p class="cwc_email-signup__disclaimer">{{ section.settings.disclaimer }}</p>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
