{% style %}
  #cwc_about-image-text-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F8F6F1' }};
    --text-color: {{ section.settings.text_color | default: '#0A1F12' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --panel-bg: {{ section.settings.panel_bg_color | default: '#F8F6F1' }};
    --body-color: {{ section.settings.body_color | default: '#666666' }};
    --media-bg: {{ section.settings.media_bg_color | default: '#0A1F12' }};
    --media-ratio: {{ section.settings.media_ratio | default: 100 | divided_by: 100.0 }};
    --media-opacity: {{ section.settings.media_opacity | default: 55 | divided_by: 100.0 }};
    --border-color: {{ section.settings.border_color | default: '#E0DDD6' }};
    --padding-top: {{ section.settings.padding_top | default: 75 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 75 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 75 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_about_image_text.css' | asset_url | stylesheet_tag }}

<section
  id="cwc_about-image-text-{{ section.id }}"
  class="cwc_about-image-text{% if section.settings.image_position == 'right' %} cwc_about-image-text--reverse{% endif %}"
>
  <div class="cwc_about-image-text__wrapper">

    {% comment %} Media — bleeds to the viewport edge, no container padding {% endcomment %}
    <div class="cwc_about-image-text__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.alt_text | default: 'Store shelves' | escape }}"
          loading="lazy"
          width="1200"
          height="1200"
        >
      {% else %}
        <div class="cwc_about-image-text__placeholder">
          <span>Add image</span>
        </div>
      {% endif %}
    </div>

    {% comment %} Copy panel {% endcomment %}
    <div class="cwc_about-image-text__panel">
      <div class="cwc_about-image-text__content">
        {% if section.settings.eyebrow != blank %}
          <p class="cwc_about-image-text__content-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_about-image-text__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.show_rule %}
          <span class="cwc_about-image-text__rule" aria-hidden="true"></span>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_about-image-text__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "CWC About Image Text",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Not A Drop-Shipper"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>There is an actual store behind this website.</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>We operate a physical storefront in Coronado, California. The bottles listed on this site are bottles we hold — not inventory sitting in a third-party warehouse, and not a catalog we forward to someone else to fulfill.</p><p>That means when you call with a question about a bottle, you are talking to someone who can walk over and look at it. Every order is packed by hand and ships nationally via UPS, with an adult signature required at delivery.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Gold Rule",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Split Panel Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Split Panel Image Alt Text"
    },
    {
      "type": "range",
      "id": "media_ratio",
      "label": "Image Height",
      "min": 60,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Height of the image column relative to its width."
    },
    {
      "type": "range",
      "id": "media_opacity",
      "label": "Image Opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55,
      "info": "Fades the photo into the Image Background Color."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "Mobile always stacks the image above the copy."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F6F1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Copy Panel Background Color",
      "default": "#F8F6F1"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Image Background Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider Color",
      "default": "#E0DDD6"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 75
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "About Image Text",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
