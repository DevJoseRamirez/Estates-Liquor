{% style %}
  #cwc_related-products-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#221813' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A35A12' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#A35A12' }};
    --meta-color: {{ section.settings.meta_color | default: '#5C5C57' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-media-bg: {{ section.settings.card_media_bg_color | default: '#FFFFFF' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E9A23B' }};
    --card-button-bg: {{ section.settings.button_bg_color | default: '#E9A23B' }};
    --card-button-text: {{ section.settings.button_text_color | default: '#221813' }};
    --card-meta-color: {{ section.settings.meta_color | default: '#5C5C57' }};
    --border-color: {{ section.settings.border_color | default: '#ECECE8' }};
    --columns: {{ section.settings.columns | default: 4 }};
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_card.css' | asset_url | stylesheet_tag }}
{{ 'CWC_related_products.css' | asset_url | stylesheet_tag }}

{% liquid
  assign source_product = section.settings.product | default: product
  assign products_to_show = section.settings.products_to_show

  # Filtered-out products (this one, add-ons, no_feed) would otherwise shrink
  # the row, so ask for a couple spare — Shopify caps recommendations at 10
  assign fetch_limit = products_to_show | plus: 2 | at_most: 10
  assign rendered_count = 0
%}

<section
  id="cwc_related-products-{{ section.id }}"
  class="cwc_related-products"
  data-section-id="{{ section.id }}"
>
  <div class="cwc_related-products__container">

    <div class="cwc_related-products__content">
      {% if section.settings.eyebrow != blank %}
        <p class="cwc_related-products__content-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_related-products__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.show_rule %}
        <span class="cwc_related-products__rule" aria-hidden="true"></span>
      {% endif %}
    </div>

    {% comment %}
      Shopify fills recommendations.products on the product-recommendations
      route. A collection can be picked instead when a curated row is wanted.
    {% endcomment %}
    {% liquid
      assign related_list = null
      if section.settings.collection != blank
        assign related_list = section.settings.collection.products
      elsif recommendations.performed? and recommendations.products_count > 0
        assign related_list = recommendations.products
      endif

      # Shipping protection is a checkout add-on, never an upsell — Shopify
      # returns it like any other product, so it goes out by handle
      assign excluded_handles = 'shipping-protection' | split: ','
    %}

    <div class="cwc_related-products__carousel" data-cwc-carousel>
      <button
        type="button"
        class="cwc_related-products__arrow cwc_related-products__arrow--prev"
        data-cwc-prev
        aria-label="Previous products"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M15 18 9 12l6-6" />
        </svg>
      </button>

      <button
        type="button"
        class="cwc_related-products__arrow cwc_related-products__arrow--next"
        data-cwc-next
        aria-label="Next products"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>

    {% if related_list %}
      <div class="cwc_related-products__track" data-cwc-track data-cwc-grid>
        {% for related in related_list %}
          {%- if rendered_count >= products_to_show -%}{%- break -%}{%- endif -%}
          {%- comment -%}
            Products tagged no_feed stay out of every feed, this row included.
            Case-insensitive, comma-delimited so no_feed_extra doesn't trip it.
          {%- endcomment -%}
          {%- assign related_tag_list = related.tags | join: ',' | downcase | prepend: ',' | append: ',' -%}
          {% unless related.id == source_product.id or excluded_handles contains related.handle or related_tag_list contains ',no_feed,' %}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
            {% comment %}
              Same card as the collection grid (snippets/cwc-product-card.liquid).
              The wrapper is only the carousel slot.
            {% endcomment %}
            <div class="cwc_related-products__card">
              {% render 'cwc-product-card', product: related, section_settings: section.settings %}
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    {% else %}
      <div
        class="cwc_related-products__track"
        data-cwc-track
        data-cwc-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ source_product.id }}&limit={{ fetch_limit }}"
      >
        <p class="cwc_related-products__empty">
          {{ section.settings.empty_text | default: 'Recommendations load once this product is published.' }}
        </p>
      </div>
    {% endif %}
    </div>

  </div>
</section>

<script src="{{ 'CWC_product_card.js' | asset_url }}" defer></script>
<script src="{{ 'CWC_related_products.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Related Products",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "More From Bourbon"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>You May Also Like</p>"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Gold Rule",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the product being viewed."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Override",
      "info": "Pick a collection to curate this row. Leave empty to use Shopify's automatic recommendations."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products To Show",
      "info": "Automatic recommendations top out at 10. A collection override can show up to 12.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_card_vendor",
      "label": "Show Brand On Cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_meta",
      "label": "Show Detail Line On Cards",
      "default": false
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty Text",
      "default": "Recommendations load once this product is published."
    },
    {
      "type": "text",
      "id": "notify_label",
      "label": "Sold Out Label",
      "default": "Notify Me When Available"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#221813"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#A35A12"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#A35A12"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ECECE8"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_media_bg_color",
      "label": "Card Image Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Add To Cart Button Color",
      "default": "#E9A23B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Add To Cart Text Color",
      "default": "#221813"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Related Products",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
