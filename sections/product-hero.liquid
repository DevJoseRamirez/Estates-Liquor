{{ 'section-product-hero.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-theme-parallax.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="theme-parallax"></script>

{% liquid
  assign section_link_enabled = true
  for block in section.blocks
    case block.type
      when 'button'
        if block.settings.first_button_link != blank and block.settings.first_button_label != blank or block.settings.second_button_link != blank and block.settings.second_button_label != blank
          assign section_link_enabled = false
        endif
      when 'hotspot'
        assign section_link_enabled = false
    endcase
  endfor

  assign has_hotspot = false
  for block in section.blocks
    if block.type == 'hotspot'
      assign has_hotspot = true
      break
    endif
  endfor
  assign section_link = false
  if section_link_enabled and section.settings.section_link != blank
    assign section_link = true
  endif

  assign placeholder_classes = 'icon icon--placeholder icon--placeholder--subdued'
  if section.settings.section_width == 'content'
    assign placeholder_classes = placeholder_classes | append: ' block-radius'
  endif

  assign animation_offset = 2
  assign overlay_opacity = 100 | minus: section.settings.image_overlay_opacity
  assign overlay_color = 'color-mix(in srgb, rgba(' | append: section.settings.image_overlay_color.rgba | append: '), transparent ' | append: overlay_opacity | append: '%)'
%}

{% if has_hotspot %}
  <safe-load-scripts class="hidden">
    <script src="{{ 'component-product-hero.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="product-hero"></script>
  </safe-load-scripts>
{% endif %}

<div
  class="wrapper-spacing--v{% if section.settings.section_width == 'content' %} wrapper-spacing--h{% endif %}{% if request.visual_preview_mode %} section-preview{% else %} show-on-scroll{% endif %}"
  data-wetheme-section-type="product-hero"
  data-wetheme-section-id="{{ section.id }}"
  style="--margin-section-top: {{ section.settings.section_margin_top }}px; --margin-section-bottom: {{ section.settings.section_margin_bottom }}px;"
>
  <div class="product-hero__grid {{ section.id }}{% if section.settings.animation_style == 'sticky_content' %} sticky_content{% endif %}{% if section.settings.section_width == 'content' %} width--content block-radius-clip{% endif %}">
    <div class="product-hero__grid--background{% if settings.animations_enabled %} kb-enabled{% endif %}{% if section.settings.animation_style == 'fade_zoom' %} fade-zoom-enabled{% endif %}" style="--overlay-color: {{ overlay_color }};">

      {% for i in (1..2) %}
        {%- liquid
          capture device
            cycle 'desktop', 'mobile'
          endcapture

          assign image_setting = 'image_' | append: device
          assign height_setting = 'height_' | append: device
          assign original_image_class = 'product-hero__' | append: device | append: '-image--original'
          assign cropped_image_class = 'product-hero__' | append: device | append: '-image--cropped'
          assign background_image = section.settings[image_setting]
          if device == 'mobile' and section.settings.image_mobile == blank and section.settings.image_desktop
            assign background_image = section.settings.image_desktop
          endif
        -%}

        {% if section.settings[height_setting] == 'original' %}
          {%- liquid
            assign hero_aspect = background_image.aspect_ratio | default: 1.5
            assign hero_sizer = 100.0 | divided_by: hero_aspect
          -%}
          <style>
            .{{ section.id }} {
              --hero-sizer-{{ device }}: {{ hero_sizer }}%;
            }
          </style>
          <div class="{{ original_image_class }}">
            {% if background_image %}
              {% render 'responsive-image', image: background_image, sizes: '100vw', loading: 'eager', allow_stretch: true %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: placeholder_classes | replace: '<svg', '<svg preserveAspectRatio="xMinYMin slice"' }}
            {% endif %}
          </div>
        {% else %}
          {%- liquid
            assign parallax = false
            if section.settings.animation_style == 'parallax' and section.settings[height_setting] != 'original'
              assign parallax = true
            endif
          -%}
          <style>
            .{{ section.id }} {
              --height-{{ device }}: {{ section.settings[height_setting] }};
            }

            {% capture selector %}.{{ section.id }} .{{ cropped_image_class }} .product-hero__cropped-image .parallax-child{% endcapture %}
            {% render 'responsive-background-image', image: background_image, selector: selector, sizes: '2000, 4000' %}
          </style>
          <div class="{{ cropped_image_class }}">
            {% if background_image %}
              <theme-parallax data-parallax-enabled="{{ parallax }}" class="product-hero__cropped-image" role="img" aria-label="{{ background_image.alt | escape }}">
                <div class="parallax-child"></div>
              </theme-parallax>
            {% else %}
              <theme-parallax data-parallax-enabled="{{ parallax }}" class="product-hero__cropped-placeholder">
                <div class="parallax-child">
                  {{ 'lifestyle-1' | placeholder_svg_tag: placeholder_classes | replace: '<svg', '<svg preserveAspectRatio="xMinYMin slice"' }}
                </div>
              </theme-parallax>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% comment %} Shoppable hotspots overlay layer {% endcomment %}
    {% if has_hotspot %}
      <product-hero-hotspots class="product-hero__hotspots" data-wetheme-section-id="{{ section.id }}" data-section-id="{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'hotspot' %}
            {%- liquid
              assign hs_product = block.settings.product
              assign hs_h_d = block.settings.hotspot_horizontal_position_desktop
              assign hs_v_d = block.settings.hotspot_vertical_position_desktop
              assign hs_h_m = block.settings.hotspot_horizontal_position_mobile
              assign hs_v_m = block.settings.hotspot_vertical_position_mobile
              assign hs_classes = ''
              if hs_v_d < 50
                assign hs_classes = hs_classes | append: ' is-below-d'
              endif
              if hs_h_d < 20
                assign hs_classes = hs_classes | append: ' is-left-d'
              elsif hs_h_d > 80
                assign hs_classes = hs_classes | append: ' is-right-d'
              endif
              if hs_v_m < 50
                assign hs_classes = hs_classes | append: ' is-below-m'
              endif
              if hs_h_m < 20
                assign hs_classes = hs_classes | append: ' is-left-m'
              elsif hs_h_m > 80
                assign hs_classes = hs_classes | append: ' is-right-m'
              endif
            -%}
            <div
              class="product-hero__hotspot{{ hs_classes }}"
              data-block-index="{{ forloop.index0 }}"
              style="--hotspot-h-desktop: {{ hs_h_d }}%; --hotspot-v-desktop: {{ hs_v_d }}%; --hotspot-h-mobile: {{ hs_h_m }}%; --hotspot-v-mobile: {{ hs_v_m }}%; --hotspot-color: rgba({{ block.settings.hotspot_color.rgba }});"
              {{ block.shopify_attributes }}
            >
              <button type="button" class="product-hero__hotspot-trigger" data-hotspot-button data-block-index="{{ forloop.index0 }}" aria-expanded="false" aria-label="{% if hs_product != blank %}{{ hs_product.title | escape }}{% else %}{{ 'general.onboarding.product_title' | t }}{% endif %}">
                <span class="product-hero__hotspot-icon"></span>
              </button>
              {% if hs_product != blank %}
                <a class="product-hero__hotspot-card" data-hotspot-card href="{{ hs_product.url }}">
                  <span class="product-hero__hotspot-card-media">
                    {% if hs_product.featured_media %}
                      {{ hs_product.featured_media | image_url: width: 240 | image_tag: class: 'product-hero__hotspot-card-img', widths: '120, 200, 300', loading: 'lazy' }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'icon icon--placeholder' }}
                    {% endif %}
                  </span>
                  <span class="product-hero__hotspot-card-body">
                    <span class="product-hero__hotspot-card-title">{{ hs_product.title }}</span>
                    <span class="product-hero__hotspot-card-price">{% if settings.show_currency_code %}{{ hs_product.price | money_with_currency }}{% else %}{{ hs_product.price | money }}{% endif %}</span>
                  </span>
                </a>
              {% else %}
                <span class="product-hero__hotspot-card" data-hotspot-card>
                  <span class="product-hero__hotspot-card-media">
                    {{ 'product-1' | placeholder_svg_tag: 'icon icon--placeholder' }}
                  </span>
                  <span class="product-hero__hotspot-card-body">
                    <span class="product-hero__hotspot-card-title">{{ 'general.onboarding.product_title' | t }}</span>
                    <span class="product-hero__hotspot-card-price">{% if settings.show_currency_code %}{{ 399 | money_with_currency }}{% else %}{{ 399 | money }}{% endif %}</span>
                  </span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </product-hero-hotspots>
    {% endif %}

    {% if section_link %}
      {% liquid
        assign section_link_label = ''
        for block in section.blocks
          if block.type == 'heading' and block.settings.title != blank
            assign section_link_label = block.settings.title | strip_html
            break
          endif
        endfor
        if section_link_label == blank
          assign section_link_label = 'sections.cross-sells.learn_more' | t
        endif
      %}
      <a class="product-hero__section-link" href="{{ section.settings.section_link }}" style="z-index: 1;" aria-label="{{ section_link_label | escape }}"></a>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="product-hero__grid--foreground product-hero__text--position-mobile-{{ section.settings.text_position_mobile }} product-hero__text--position-desktop-{{ section.settings.text_position_desktop }}"{% if section_link %} style="pointer-events: none;"{% endif %}>
        {% liquid
          assign caption_bg_transparent = false
          if section.settings.caption_bg_color == 'rgba(0, 0, 0, 0)' or section.settings.caption_bg_color == 'rgba(0,0,0,0)' or section.settings.caption_bg_color == 'none' or section.settings.caption_bg_color == 'transparent' or section.settings.caption_bg_color == ''
            assign caption_bg_transparent = true
          endif

          assign text_color = 'rgba(' | append: section.settings.text_color.rgba | append: ')'
          assign link_color = 'rgba(' | append: section.settings.text_color.rgba | append: ')'
          assign link_border_color = 'color-mix(in srgb, ' | append: text_color | append: ', transparent 50%)'
          assign text_color_transparent25 = 'color-mix(in srgb, ' | append: text_color | append: ', transparent 75%)'

          assign offset_x_desktop = section.settings.content_offset_x_desktop | minus: 50
          assign offset_y_desktop = section.settings.content_offset_y_desktop | minus: 50
          assign offset_x_mobile = section.settings.content_offset_x_mobile | minus: 50
          assign offset_y_mobile = section.settings.content_offset_y_mobile | minus: 50

          assign feature_row_open = false
        %}
        <div
          class="product-hero__caption product-hero__caption-{% if caption_bg_transparent %}transparent{% else %}solid{% endif %}-bg product-hero__caption--align-mobile-{{ section.settings.text_alignment_mobile }} product-hero__caption--align-desktop-{{ section.settings.text_alignment_desktop }} block-radius"
          style="background: rgba({{ section.settings.caption_bg_color.rgba }}); color: {{ text_color }}; --link-color: {{ link_color }}; --link-border-color: {{ link_border_color }}; --text-color-transparent25: {{ text_color_transparent25 }}; --caption-width-desktop: {{ section.settings.caption_width_desktop }}%; --caption-width-mobile: {{ section.settings.caption_width_mobile }}%; --offset-x-desktop: {{ offset_x_desktop }}%; --offset-y-desktop: {{ offset_y_desktop }}%; --offset-x-mobile: {{ offset_x_mobile }}%; --offset-y-mobile: {{ offset_y_mobile }}%;"
        >
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'heading' %}
                {% if feature_row_open %}</div>{% assign feature_row_open = false %}{% endif %}
                {% if block.settings.title != blank %}
                  {%- liquid
                    assign heading_html = block.settings.title
                    if block.settings.highlight_text != blank
                      assign hl_class = 'product-hero__hl'
                      if block.settings.highlight_effect == 'circle'
                        assign hl_class = hl_class | append: ' product-hero__hl--circle'
                      elsif block.settings.highlight_effect == 'underline'
                        assign hl_class = hl_class | append: ' product-hero__hl--underline'
                      else
                        assign hl_class = hl_class | append: ' product-hero__hl--color'
                      endif
                      if block.settings.highlight_bold
                        assign hl_class = hl_class | append: ' product-hero__hl--bold'
                      endif
                      if block.settings.highlight_italic
                        assign hl_class = hl_class | append: ' product-hero__hl--italic'
                      endif
                      assign highlight_terms = block.settings.highlight_text | split: ','
                      for term in highlight_terms
                        assign term = term | strip
                        if term != blank
                          assign highlight_span = '<span class="' | append: hl_class | append: '">' | append: term | append: '</span>'
                          assign heading_html = heading_html | replace: term, highlight_span
                        endif
                      endfor
                    endif
                  -%}
                  <style>
                    .{{ block.id }} {
                      font-size: {{ block.settings.font_size_mobile }}px;
                      --heading-highlight-color: {{ block.settings.heading_highlight_color }};

                      @media screen and (min-width: 768px) {
                        font-size: {{ block.settings.font_size_desktop }}px;
                      }
                    }
                  </style>
                  <h2 class="{{ block.id }} product-hero__heading text-link-animated" style="padding-bottom: {{ block.settings.heading_bottom_spacing }}px;" data-animate data-animate-order="{{ forloop.index | plus: animation_offset }}" {{ block.shopify_attributes }}>{{ heading_html }}</h2>
                {% endif %}

              {% when 'subheading' %}
                {% if feature_row_open %}</div>{% assign feature_row_open = false %}{% endif %}
                {% if block.settings.subheading != blank %}
                  <style>
                    .{{ block.id }} {
                      font-size: {{ block.settings.font_size_mobile }}px;

                      @media screen and (min-width: 768px) {
                        font-size: {{ block.settings.font_size_desktop }}px;
                      }
                    }
                  </style>
                  <div class="{{ block.id }} product-hero__subheading text-link-animated{% if block.settings.subheading_uppercase %} product-hero__subheading--uppercase{% endif %}" style="padding-bottom: {{ block.settings.subheading_bottom_spacing }}px;" data-animate data-animate-order="{{ forloop.index | plus: animation_offset }}" {{ block.shopify_attributes }}>{{ block.settings.subheading }}</div>
                {% endif %}

              {% when 'text' %}
                {% if feature_row_open %}</div>{% assign feature_row_open = false %}{% endif %}
                {% if block.settings.text != blank %}
                  <style>
                    .{{ block.id }} {
                      font-size: {{ block.settings.font_size_mobile }}px;

                      @media screen and (min-width: 768px) {
                        font-size: {{ block.settings.font_size_desktop }}px;
                      }
                    }
                  </style>
                  <div class="{{ block.id }} product-hero__text text-link-animated richtext-block" style="padding-bottom: {{ block.settings.text_bottom_spacing }}px;" data-animate data-animate-order="{{ forloop.index | plus: animation_offset }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                {% endif %}

              {% when 'button' %}
                {% if feature_row_open %}</div>{% assign feature_row_open = false %}{% endif %}
                {% unless block.settings.first_button_label == blank and block.settings.second_button_label == blank %}
                  {% if block.settings.override_button_colors %}
                    {% render 'button-color-overrides',
                      id: block.id,
                      style: block.settings.buttons_style,
                      text_color: block.settings.buttons_text,
                      background_color: block.settings.buttons_background
                    %}
                    {% if block.settings.buttons_font_weight != 'default' or block.settings.buttons_font_size > 0 %}
                      <style>
                        .dynamic-section-button--{{ block.id }} {
                          {% if block.settings.buttons_font_weight != 'default' %}--button-font-weight: {{ block.settings.buttons_font_weight }};{% endif %}
                          {% if block.settings.buttons_font_size > 0 %}--button-font-size-px: {{ block.settings.buttons_font_size }}px;{% endif %}
                        }
                      </style>
                    {% endif %}
                  {% endif %}

                  <div class="product-hero__buttons{% if block.settings.buttons_style == 'underlined' %} text-link-animated{% endif %}" style="padding-bottom: {{ block.settings.buttons_bottom_spacing }}px;" {{ block.shopify_attributes }}>
                    {% if block.settings.first_button_label != blank %}
                      {% capture first_button_attr %}
                        data-animate
                        data-animate-order="{{ forloop.index | plus: animation_offset }}"
                      {% endcapture %}
                      {% render 'dynamic-section-button',
                        id: block.id,
                        link: block.settings.first_button_link,
                        label: block.settings.first_button_label,
                        style: block.settings.buttons_style,
                        show_arrow: block.settings.show_arrow,
                        wrapper: false,
                        attributes: first_button_attr
                      %}
                    {% endif %}
                    {% if block.settings.second_button_label != blank %}
                      {% if block.settings.first_button_label != blank %}
                        {% assign animation_offset = animation_offset | plus: 1 %}
                      {% endif %}
                      {% capture second_button_attr %}
                        data-animate
                        data-animate-order="{{ forloop.index | plus: animation_offset }}"
                      {% endcapture %}
                      {% render 'dynamic-section-button',
                        id: block.id,
                        link: block.settings.second_button_link,
                        label: block.settings.second_button_label,
                        style: block.settings.buttons_style,
                        show_arrow: block.settings.show_arrow,
                        wrapper: false,
                        attributes: second_button_attr
                      %}
                    {% endif %}
                  </div>
                {% endunless %}

              {% when 'pill' %}
                {% if feature_row_open %}</div>{% assign feature_row_open = false %}{% endif %}
                {% if block.settings.text != blank %}
                  <div class="product-hero__pill-wrap" style="padding-bottom: {{ block.settings.bottom_spacing }}px;" data-animate data-animate-order="{{ forloop.index | plus: animation_offset }}" {{ block.shopify_attributes }}>
                    <span class="product-hero__pill{% if block.settings.uppercase %} product-hero__pill--uppercase{% endif %}" style="background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};">{{ block.settings.text }}</span>
                  </div>
                {% endif %}

              {% when 'reviews' %}
                {% if feature_row_open %}</div>{% assign feature_row_open = false %}{% endif %}
                {%- liquid
                  assign star_fill = block.settings.rating | times: 20.0
                  if star_fill > 100
                    assign star_fill = 100
                  endif
                  if star_fill < 0
                    assign star_fill = 0
                  endif
                -%}
                {% if block.settings.show_stars or block.settings.text != blank %}
                  <div class="product-hero__reviews" style="padding-bottom: {{ block.settings.bottom_spacing }}px;" data-animate data-animate-order="{{ forloop.index | plus: animation_offset }}" {{ block.shopify_attributes }}>
                    {% if block.settings.show_stars %}
                      <div class="product-hero__stars" style="--star-color: {{ block.settings.star_color }};" role="img" aria-label="{{ block.settings.rating }} / 5">
                        <div class="product-hero__stars-empty">
                          {% for i in (1..5) %}{% render 'theme-icon', icon: 'star-solid', iconSize: 18 %}{% endfor %}
                        </div>
                        <div class="product-hero__stars-full" style="width: {{ star_fill }}%;">
                          {% for i in (1..5) %}{% render 'theme-icon', icon: 'star-solid', iconSize: 18 %}{% endfor %}
                        </div>
                      </div>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="product-hero__reviews-text">{{ block.settings.text }}</div>
                    {% endif %}
                  </div>
                {% endif %}

              {% when 'feature_icon' %}
                {% comment %} Consecutive feature icons join into one row; a non-feature block closes it {% endcomment %}
                {% if feature_row_open %}
                  <hr class="product-hero__feature-divider">
                {% else %}
                  <div class="product-hero__features product-hero__features--size-{{ section.settings.feature_icon_size }}{% if section.settings.feature_show_dividers %} product-hero__features--with-dividers{% endif %}{% if section.settings.feature_full_width %} product-hero__features--full-width{% else %} product-hero__features--gap-{{ section.settings.feature_gap }}{% endif %}" style="padding-bottom: {{ block.settings.bottom_spacing }}px;" data-animate data-animate-order="{{ forloop.index | plus: animation_offset }}">
                  {% assign feature_row_open = true %}
                {% endif %}
                <div class="product-hero__feature" {{ block.shopify_attributes }}>
                  {% if block.settings.custom_icon != blank %}
                    <div class="product-hero__feature-icon">
                      {% render 'responsive-image', image: block.settings.custom_icon, allow_stretch: true %}
                    </div>
                  {% elsif block.settings.icon != 'none' %}
                    <div class="product-hero__feature-icon">
                      {% render 'theme-icon', icon: block.settings.icon %}
                    </div>
                  {% endif %}
                  {% if block.settings.label != blank %}
                    <div class="product-hero__feature-label{% if section.settings.feature_labels_uppercase %} product-hero__feature-label--uppercase{% endif %}">{{ block.settings.label }}</div>
                  {% endif %}
                </div>

            {% endcase %}
          {% endfor %}
          {% if feature_row_open %}</div>{% assign feature_row_open = false %}{% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>


{% schema %}
{
  "name": "t:sections.product-hero.name",
  "class": "section--product-hero",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "t:all.Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "t:all.Image"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "t:all.Section_height",
      "default": "100vh",
      "options": [
        {
          "value": "original",
          "label": "t:all.Original"
        },
        {
          "value": "50vh",
          "label": "t:all.Small"
        },
        {
          "value": "62vh",
          "label": "t:all.Medium"
        },
        {
          "value": "74vh",
          "label": "t:all.Large"
        },
        {
          "value": "87vh",
          "label": "t:all.Extra_Large"
        },
        {
          "value": "100vh",
          "label": "t:all.Fullscreen"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_position_desktop",
      "label": "t:all.Content_position",
      "default": "right",
      "options": [
        {
          "value": "top_left",
          "label": "t:all.Top_left"
        },
        {
          "value": "top_center",
          "label": "t:all.Top_center"
        },
        {
          "value": "top_right",
          "label": "t:all.Top_right"
        },
        {
          "value": "left",
          "label": "t:all.Center_left"
        },
        {
          "value": "center",
          "label": "t:all.Center"
        },
        {
          "value": "right",
          "label": "t:all.Center_right"
        },
        {
          "value": "bottom_left",
          "label": "t:all.Bottom_left"
        },
        {
          "value": "bottom_center",
          "label": "t:all.Bottom_center"
        },
        {
          "value": "bottom_right",
          "label": "t:all.Bottom_right"
        }
      ]
    },
    {
      "type": "text_alignment",
      "id": "text_alignment_desktop",
      "label": "t:all.Alignment",
      "default": "left"
    },
    {
      "type": "range",
      "id": "caption_width_desktop",
      "label": "t:sections.product-hero.settings.content_width.label",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "content_offset_x_desktop",
      "label": "t:sections.product-hero.settings.content_offset_x.label",
      "info": "t:sections.product-hero.settings.content_offset_x.info",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "content_offset_y_desktop",
      "label": "t:sections.product-hero.settings.content_offset_y.label",
      "info": "t:sections.product-hero.settings.content_offset_y.info",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:all.Mobile"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:all.Image"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:all.Section_height",
      "default": "100vh",
      "options": [
        {
          "value": "original",
          "label": "t:all.Original"
        },
        {
          "value": "250px",
          "label": "t:all.Small"
        },
