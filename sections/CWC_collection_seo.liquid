{% style %}
  #cwc_collection-seo-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#0A1F12' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --body-text-color: {{ section.settings.body_text_color | default: '#666666' }};
    --content-width: {{ section.settings.content_width | default: 1000 }}px;
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }

  {%- comment -%}
    Read more: blocks collapse to the first N cards; metafield copy (one card)
    collapses to its first N×2 elements — roughly N heading + paragraph pairs.
    CWC_collection_seo.js adds the collapsed class, so with JS off it all shows.
  {%- endcomment -%}
  {%- if section.settings.enable_read_more %}
    {%- assign visible_cards = section.settings.visible_blocks | default: 2 %}
    {%- assign visible_children = visible_cards | times: 2 %}
    #cwc_collection-seo-{{ section.id }} .cwc_collection-seo--collapsed > .cwc_collection-seo__card:nth-child(n + {{ visible_cards | plus: 1 }}),
    #cwc_collection-seo-{{ section.id }} .cwc_collection-seo--collapsed .cwc_collection-seo__card--metafield .cwc_collection-seo__card-text > :nth-child(n + {{ visible_children | plus: 1 }}) {
      display: none;
    }
  {%- endif %}
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_collection_seo.css' | asset_url | stylesheet_tag }}

{% liquid
  # A collection that carries its own SEO copy wins over the blocks: the copy is
  # written once per collection and travels with it, rather than being retyped
  # into this section for every template that uses it. Blocks stay as the
  # fallback for collections that have no metafield yet.
  assign seo_metafield = null
  if section.settings.use_metafield
    assign seo_metafield = collection.metafields.custom.seo_description
  endif
%}

{%- comment -%}
  seo_description is rich text, so it is rendered through metafield_tag rather
  than read via .value — .value hands back the structured object, not markup.
  Going through the filter also keeps this working if the metafield is ever
  created as plain multi-line text instead.
{%- endcomment -%}
{%- capture seo_copy -%}
  {%- if seo_metafield != blank -%}
    {{ seo_metafield | metafield_tag }}
  {%- endif -%}
{%- endcapture -%}

{% comment %}
  An existing but empty metafield still renders as markup, and that empty
  wrapper must not win over the blocks — so test the text, not the tags.
{% endcomment %}
{% assign seo_text = seo_copy | strip_html | strip %}

{% if seo_text != blank or section.blocks.size > 0 %}
  <section id="cwc_collection-seo-{{ section.id }}" class="cwc_collection-seo">
    <div class="cwc_collection-seo__container">
      <div class="cwc_collection-seo__content" data-cwc-seo-body>
        {% if seo_text != blank %}
          {% comment %}
            Rich text metafield — headings and lists come through as markup, so
            the whole thing renders as one card rather than block by block.
          {% endcomment %}
          <div class="cwc_collection-seo__card cwc_collection-seo__card--metafield">
            <div class="cwc_collection-seo__card-text cwc-rte">
              {{ seo_copy }}
            </div>
          </div>
        {% else %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'content' %}
                <div
                  class="cwc_collection-seo__card cwc_collection-seo__card--{{ block.settings.size }}"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.title != blank %}
                    {% case block.settings.size %}
                      {% when 'large' %}
                        <h2 class="cwc_collection-seo__card-title">{{ block.settings.title }}</h2>
                      {% when 'medium' %}
                        <h3 class="cwc_collection-seo__card-title">{{ block.settings.title }}</h3>
                      {% else %}
                        <h4 class="cwc_collection-seo__card-title">{{ block.settings.title }}</h4>
                    {% endcase %}
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="cwc_collection-seo__card-text cwc-rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}
        {% endif %}
      </div>

      {% if section.settings.enable_read_more %}
        <div class="cwc_collection-seo__more">
          <button
            type="button"
            class="cwc_collection-seo__toggle"
            aria-expanded="false"
            data-more="{{ section.settings.more_label | default: 'Read More' | escape }}"
            data-less="{{ section.settings.less_label | default: 'Read Less' | escape }}"
            hidden
          >
            {{- section.settings.more_label | default: 'Read More' | escape -}}
          </button>
        </div>
      {% endif %}
    </div>
  </section>

  <script src="{{ 'CWC_collection_seo.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "CWC Collection SEO Copy",
  "settings": [
    {
      "type": "header",
      "content": "Content Source"
    },
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "Use Collection Metafield",
      "default": true,
      "info": "When the collection has custom.seo_description filled in, that copy renders instead of the blocks below. Collections without it fall back to the blocks."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Width",
      "min": 600,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Read More"
    },
    {
      "type": "checkbox",
      "id": "enable_read_more",
      "label": "Collapse Long Copy",
      "default": true,
      "info": "Shows the first few blocks with a Read More button for the rest."
    },
    {
      "type": "range",
      "id": "visible_blocks",
      "label": "Blocks Shown Before Read More",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Read More Label",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "less_label",
      "label": "Read Less Label",
      "default": "Read Less"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Body Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#C4933F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content Block",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Title Size",
          "options": [
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ],
          "default": "medium",
          "info": "Also sets the heading level for SEO — Large is the section's main heading, Medium and Small nest under it."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "What We Carry"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this part of the collection for shoppers and search engines.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection SEO Copy",
      "category": "CWC Custom",
      "blocks": [
        {
          "type": "content"
        },
        {
          "type": "content"
        },
        {
          "type": "content"
        }
      ]
    }
  ]
}
{% endschema %}
