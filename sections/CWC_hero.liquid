{% style %}
  #cwc_hero-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#0A1F12' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#C4933F' }};
    --overlay-color: {{ section.settings.overlay_color | default: '#0A1F12' }};
    --overlay-opacity: {{ section.settings.overlay_opacity | default: 92 | divided_by: 100.0 }};
    --button-bg: {{ section.settings.button_bg_color | default: '#C4933F' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};
    --hero-height: {{ section.settings.hero_height | default: 640 }}px;
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_hero.css' | asset_url | stylesheet_tag }}

<section id="cwc_hero-{{ section.id }}" class="cwc_hero">
  {% comment %} Background image + gradient overlay {% endcomment %}
  <div class="cwc_hero__bg">
    {% if section.settings.image != blank %}
      {% if section.settings.image_mobile != blank %}
        <picture>
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 900 }}"
          >
          <img
            src="{{ section.settings.image | image_url: width: 2000 }}"
            alt="{{ section.settings.alt_text | default: 'Hero background' | escape }}"
            loading="eager"
            fetchpriority="high"
            width="2000"
            height="1200"
          >
        </picture>
      {% else %}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          alt="{{ section.settings.alt_text | default: 'Hero background' | escape }}"
          loading="eager"
          fetchpriority="high"
          width="2000"
          height="1200"
        >
      {% endif %}
    {% endif %}
    <span class="cwc_hero__overlay" aria-hidden="true"></span>
  </div>

  <div class="cwc_hero__container">
    <div class="cwc_hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="cwc_hero__content-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_hero__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_hero__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank or section.settings.button_2_label != blank %}
        <div class="cwc_hero__actions">
          {% if section.settings.button_label != blank %}
            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="cwc_hero__button cwc_hero__button--primary"
            >
              {{ section.settings.button_label }}
            </a>
          {% endif %}

          {% if section.settings.button_2_label != blank %}
            <a
              href="{{ section.settings.button_2_link | default: '#' }}"
              class="cwc_hero__button cwc_hero__button--outline"
            >
              {{ section.settings.button_2_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% comment %} Circular stat badge {% endcomment %}
  {% if section.settings.show_badge and section.settings.badge_number != blank %}
    <div class="cwc_hero__badge">
      <span class="cwc_hero__badge-number">{{ section.settings.badge_number }}</span>
      {% if section.settings.badge_text != blank %}
        <span class="cwc_hero__badge-text">{{ section.settings.badge_text }}</span>
      {% endif %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "CWC Hero",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Allocated Bourbon · Rare Releases"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Rare spirits.<br><em>Delivered</em><br>to your door.</p>",
      "info": "Italic text uses the Highlight Color."
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Fair prices on allocated bourbon, rare releases, and premium spirits. Every bottle hand-packed and shipped from Coronado.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop Rare & Allocated"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "View Best Sellers"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Circular Badge",
      "default": true,
      "info": "Hidden on mobile."
    },
    {
      "type": "text",
      "id": "badge_number",
      "label": "Badge Number",
      "default": "600+"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Bottles In Stock"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Background Image Alt Text"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Strength",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 92,
      "info": "Darkens the left side of the image so the text stays readable."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop Height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Highlight Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Primary Button Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Primary Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80,
      "info": "Applies below 1024px, where the hero grows to fit its content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
