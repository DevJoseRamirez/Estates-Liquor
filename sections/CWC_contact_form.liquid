{% style %}
  #cwc_contact-form-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#14281D' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A35A12' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#A35A12' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#4A554D' }};
    --meta-color: {{ section.settings.meta_color | default: '#5C5C57' }};
    --border-color: {{ section.settings.border_color | default: '#DEDED8' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E9A23B' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#14281D' }};

    {% comment %} Fields sit on the section background with a hairline rule {% endcomment %}
    --input-bg: {{ section.settings.input_bg_color | default: '#FFFFFF' }};
    --input-border-color: {{ section.settings.input_border_color | default: '#1C1C19' }};
    --input-text-color: {{ section.settings.input_text_color | default: '#14281D' }};
    --input-placeholder-color: {{ section.settings.input_placeholder_color | default: '#5C5C57' }};
    --success-bg: {{ section.settings.success_bg_color | default: '#FBE3C4' }};
    --success-text-color: {{ section.settings.success_text_color | default: '#8A4A0E' }};
    --error-bg: {{ section.settings.error_bg_color | default: '#FBE3C4' }};
    --error-text-color: {{ section.settings.error_text_color | default: '#8A4A0E' }};
    --form-width: {{ section.settings.form_width | default: 720 }}px;
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_contact_form.css' | asset_url | stylesheet_tag }}

<section id="cwc_contact-form-{{ section.id }}" class="cwc_contact-form">
  <div class="cwc_contact-form__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_contact-form__content">
      {% if section.settings.eyebrow != blank %}
        <p class="cwc_contact-form__content-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_contact-form__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.show_rule %}
        <span class="cwc_contact-form__rule" aria-hidden="true"></span>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_contact-form__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %}
      Shopify's contact form posts to /contact#contact-{{ section.id }} and
      re-renders the page, so the anchor is what scrolls the shopper back to
      the confirmation instead of the top of the page.
    {% endcomment %}
    {% assign form_id = 'cwc_contact-' | append: section.id %}
    {% form 'contact', id: form_id, class: 'cwc_contact-form__form' %}
      {% if form.posted_successfully? %}
        <p class="cwc_contact-form__message cwc_contact-form__message--success" role="status">
          {{ section.settings.success_message | default: 'Thanks — your message is in. We reply within one business day.' }}
        </p>
      {% elsif form.errors %}
        <p class="cwc_contact-form__message cwc_contact-form__message--error" role="alert">
          {{ section.settings.error_message | default: 'Something is missing. Check the fields below and send again.' }}
        </p>
      {% endif %}

      <div class="cwc_contact-form__fields">
        <div class="cwc_contact-form__field">
          <label class="cwc_contact-form__label" for="cwc_contact-name-{{ section.id }}">
            {{ section.settings.name_label | default: 'Name' }}
          </label>
          <input
            id="cwc_contact-name-{{ section.id }}"
            class="cwc_contact-form__input"
            type="text"
            name="contact[name]"
            value="{{ form.name }}"
            placeholder="{{ section.settings.name_label | default: 'Name' | escape }}"
            autocomplete="name"
            required
          >
        </div>

        <div class="cwc_contact-form__field">
          <label class="cwc_contact-form__label" for="cwc_contact-email-{{ section.id }}">
            {{ section.settings.email_label | default: 'Email' }}
          </label>
          <input
            id="cwc_contact-email-{{ section.id }}"
            class="cwc_contact-form__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.email_label | default: 'Email' | escape }}"
            autocomplete="email"
            required
          >
        </div>

        {% if section.settings.show_phone %}
          <div class="cwc_contact-form__field">
            <label class="cwc_contact-form__label" for="cwc_contact-phone-{{ section.id }}">
              {{ section.settings.phone_label | default: 'Phone (optional)' }}
            </label>
            <input
              id="cwc_contact-phone-{{ section.id }}"
              class="cwc_contact-form__input"
              type="tel"
              name="contact[phone]"
              value="{{ form.phone }}"
              placeholder="{{ section.settings.phone_label | default: 'Phone (optional)' | escape }}"
              autocomplete="tel"
            >
          </div>
        {% endif %}

        {% if section.settings.show_subject %}
          {% comment %}
            Subject ships as a named contact field so it lands as its own line
            in the notification email rather than buried in the message body.
          {% endcomment %}
          {% assign subject_options = section.settings.subject_options | newline_to_br | split: '<br />' %}
          <div class="cwc_contact-form__field">
            <label class="cwc_contact-form__label" for="cwc_contact-subject-{{ section.id }}">
              {{ section.settings.subject_label | default: 'What can we help with?' }}
            </label>
            <select
              id="cwc_contact-subject-{{ section.id }}"
              class="cwc_contact-form__select"
              name="contact[Subject]"
            >
              {% for option in subject_options %}
                {% assign option_label = option | strip %}
                {% if option_label != blank %}
                  <option value="{{ option_label | escape }}">{{ option_label }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>
        {% endif %}

        <div class="cwc_contact-form__field cwc_contact-form__field--full">
          <label class="cwc_contact-form__label" for="cwc_contact-body-{{ section.id }}">
            {{ section.settings.message_label | default: 'Message' }}
          </label>
          <textarea
            id="cwc_contact-body-{{ section.id }}"
            class="cwc_contact-form__textarea"
            name="contact[body]"
            rows="{{ section.settings.message_rows | default: 6 }}"
            placeholder="{{ section.settings.message_placeholder | default: 'Tell us what you are looking for.' | escape }}"
            required
          >{{ form.body }}</textarea>
        </div>
      </div>

      <div class="cwc_contact-form__actions">
        <button type="submit" class="cwc_contact-form__button">
          {{ section.settings.button_label | default: 'Send Message' }}
        </button>

        {% if section.settings.disclaimer != blank %}
          <p class="cwc_contact-form__disclaimer">{{ section.settings.disclaimer }}</p>
        {% endif %}
      </div>
    {% endform %}

  </div>
</section>

{% schema %}
{
