          "default": "Ships Nationally"
        },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icon 3",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Shipping Truck" },
            { "value": "check", "label": "Check Circle" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "bottle", "label": "Bottle" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3",
          "default": "Verified Authentic"
        },
        {
          "type": "select",
          "id": "icon_4",
          "label": "Icon 4",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Shipping Truck" },
            { "value": "check", "label": "Check Circle" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "bottle", "label": "Bottle" }
          ],
          "default": "lock"
        },
        {
          "type": "text",
          "id": "text_4",
          "label": "Text 4",
          "default": "Secure Checkout"
        }
