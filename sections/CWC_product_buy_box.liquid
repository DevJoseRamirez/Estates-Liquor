{% style %}
  #cwc_product-buy-box-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#14281D' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A35A12' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#5C5C57' }};
    --meta-color: {{ section.settings.meta_color | default: '#5C5C57' }};
    --media-bg: {{ section.settings.media_bg_color | default: '#FFFFFF' }};
    --border-color: {{ section.settings.border_color | default: '#ECECE8' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E9A23B' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#14281D' }};
    --stock-color: {{ section.settings.stock_color | default: '#A35A12' }};
    --media-width: {{ section.settings.media_width | default: 45 }}%;
    --padding-top: {{ section.settings.padding_top | default: 30 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 30 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_buy_box.css' | asset_url | stylesheet_tag }}

{% liquid
  assign buy_product = section.settings.product | default: product
  assign current_variant = buy_product.selected_or_first_available_variant

  # Detail line: metafield first, product type as the fallback
  assign product_meta = buy_product.metafields.custom.details
  if product_meta == blank
    assign product_meta = buy_product.type
  endif
%}

<section
  id="cwc_product-buy-box-{{ section.id }}"
  class="cwc_product-buy-box"
  data-section-id="{{ section.id }}"
  data-product-url="{{ buy_product.url }}"
>
  <div class="cwc_product-buy-box__container">
    <div class="cwc_product-buy-box__layout">
      {% comment %} Media gallery {% endcomment %}
      {% comment %}
        Gallery: one swipeable track of slides (scroll-snap), thumbnails under
        it on desktop, progress bars over it on tablet and mobile. Works as a
        plain swipe/scroll strip with no JS; the JS syncs thumbs and bars and
        jumps to the chosen variant's image.
      {% endcomment %}
      {% liquid
        assign gallery_media = buy_product.media | slice: 0, section.settings.gallery_limit
        assign media_count = gallery_media.size
      %}
      <div class="cwc_product-buy-box__media{% if section.settings.sticky_gallery %} cwc_product-buy-box__media--sticky{% endif %}{% if section.settings.media_spotlight %} cwc_product-buy-box__media--spotlight{% endif %}">
        <div class="cwc_product-buy-box__media-main" data-cwc-media-main>
          <div class="cwc_product-buy-box__track" data-cwc-gallery-track tabindex="0" aria-label="{{ buy_product.title | escape }} images">
            {% if media_count > 0 %}
              {% for media in gallery_media %}
                {%- assign media_image = media.preview_image -%}
                <div
                  class="cwc_product-buy-box__slide"
                  data-cwc-slide
                  data-media-id="{{ media.id }}"
                  data-index="{{ forloop.index0 }}"
                >
                  {% if media_image != blank %}
                    <img
                      src="{{ media_image | image_url: width: 1100 }}"
                      srcset="{{ media_image | image_url: width: 550 }} 550w, {{ media_image | image_url: width: 800 }} 800w, {{ media_image | image_url: width: 1100 }} 1100w, {{ media_image | image_url: width: 1500 }} 1500w"
                      sizes="(max-width: 1024px) 100vw, {{ section.settings.media_width | default: 45 }}vw"
                      alt="{{ media.alt | default: buy_product.title | escape }}"
                      width="{{ media_image.width }}"
                      height="{{ media_image.height }}"
                      {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                    >
                  {% endif %}
                </div>
              {% endfor %}
            {% else %}
              <div class="cwc_product-buy-box__slide" data-index="0">
                <span class="cwc_product-buy-box__media-placeholder">
                  <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
                    <rect x="16" y="0" width="20" height="6" rx="2" />
                    <rect x="18" y="6" width="16" height="11" />
                    <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
                  </svg>
                </span>
              </div>
            {% endif %}
          </div>

          {% if media_count > 1 %}
            <div class="cwc_product-buy-box__dots" aria-hidden="true">
              {% for media in gallery_media %}
                <span class="cwc_product-buy-box__dot{% if forloop.first %} cwc_product-buy-box__dot--active{% endif %}" data-cwc-dot></span>
              {% endfor %}
            </div>
          {% endif %}

          {% liquid
            assign badge_label = ''
            if buy_product.available == false
              assign badge_label = 'Sold Out'
            elsif buy_product.tags contains 'Allocated' or buy_product.tags contains 'allocated'
              assign badge_label = 'Allocated'
            elsif buy_product.tags contains 'Barrel Pick' or buy_product.tags contains 'barrel pick'
              assign badge_label = 'Barrel Pick'
            elsif buy_product.tags contains 'New' or buy_product.tags contains 'new'
              assign badge_label = 'New'
            endif
          %}

          {% if badge_label != blank %}
            <span class="cwc_product-buy-box__media-badge cwc_product-buy-box__media-badge--{{ badge_label | handleize }}">{{ badge_label }}</span>
          {% endif %}
        </div>

        {% comment %} Thumb strip hides itself when there is only one image {% endcomment %}
        {% if media_count > 1 and section.settings.show_thumbnails %}
          <div class="cwc_product-buy-box__thumbs" role="group" aria-label="Product images">
            {% for media in gallery_media %}
              <button
                type="button"
                class="cwc_product-buy-box__thumb{% if forloop.first %} cwc_product-buy-box__thumb--active{% endif %}"
                data-cwc-thumb
                data-index="{{ forloop.index0 }}"
                aria-label="Show image {{ forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                <img
                  src="{{ media.preview_image | image_url: width: 180 }}"
                  alt=""
                  loading="lazy"
                  width="88"
                  height="88"
                >
              </button>
            {% endfor %}
          </div>

          {% if section.settings.thumb_note != blank %}
            <p class="cwc_product-buy-box__thumb-note">{{ section.settings.thumb_note }}</p>
          {% endif %}
        {% endif %}

        {%- liquid
          comment
            Default review comes from the section settings (shared across products). With the
            product review toggle on, the browser asks Judge.me's feed for this product and swaps
            in its first review at or above the minimum rating. Desktop only.
          endcomment
          assign use_product_review = section.settings.testimonial_use_product_review
          assign show_testimonial = false
          if section.settings.show_testimonial
            if section.settings.testimonial_quote != blank or use_product_review
              assign show_testimonial = true
            endif
          endif
        -%}
        {% if show_testimonial %}
          {%- assign testimonial_percent = section.settings.testimonial_rating | times: 20 -%}
          <figure
            class="cwc_product-buy-box__testimonial"
            {% if section.settings.testimonial_quote == blank %}hidden{% endif %}
            {% if use_product_review %}
              data-product-review
              data-product-id="{{ buy_product.id }}"
              data-shop-domain="{{ shop.permanent_domain }}"
              data-min-rating="{{ section.settings.testimonial_min_rating | default: 4 }}"
            {% endif %}
          >
            <span
              class="cwc_product-buy-box__testimonial-stars"
              data-testimonial-stars
              style="--rating: {{ testimonial_percent }}%;"
              role="img"
              aria-label="{{ section.settings.testimonial_rating }} out of 5 stars"
            >★★★★★</span>
            <blockquote class="cwc_product-buy-box__testimonial-quote">
              <p data-testimonial-quote>&ldquo;{{ section.settings.testimonial_quote | escape }}&rdquo;</p>
            </blockquote>
            <figcaption class="cwc_product-buy-box__testimonial-footer">
              <span class="cwc_product-buy-box__testimonial-author">
                {% if section.settings.testimonial_photo != blank %}
                  <img
                    data-testimonial-photo
                    src="{{ section.settings.testimonial_photo | image_url: width: 120 }}"
                    alt=""
                    loading="lazy"
                    width="40"
                    height="40"
                  >
                {% endif %}
                <span class="cwc_product-buy-box__testimonial-name" data-testimonial-name>{{ section.settings.testimonial_name | escape }}</span>
              </span>
              {% if section.settings.testimonial_verified_label != blank %}
                <span class="cwc_product-buy-box__testimonial-verified" data-testimonial-verified>
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="12" fill="currentColor"></circle><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  {{ section.settings.testimonial_verified_label | escape }}
                </span>
              {% endif %}
            </figcaption>
          </figure>
        {% endif %}
      </div>

      {% comment %} Buy column — every row is a reorderable block {% endcomment %}
      <div class="cwc_product-buy-box__info">
        {% for block in section.blocks %}
          {% case block.type %}
              {% comment %}
                App blocks from installed apps — subscription widgets, review
                badges, size charts. Ordered like any other block, so an app can
                sit between the price and the buy button.
              {% endcomment %}
            {% when '@app' %}
              <div class="cwc_product-buy-box__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {% when 'brand' %}
              {% if buy_product.vendor != blank %}
                <div class="cwc_product-buy-box__brand" {{ block.shopify_attributes }}>
                  {% if block.settings.link_vendor %}
                    <a href="{{ buy_product.vendor | url_for_vendor }}">{{ buy_product.vendor }}</a>
                  {% else %}
                    {{ buy_product.vendor }}
                  {% endif %}
                </div>
              {% endif %}

            {% when 'title' %}
              <h1 class="cwc_product-buy-box__title" {{ block.shopify_attributes }}>
                {{ buy_product.title }}
              </h1>

            {% when 'rating' %}
              <div class="cwc_product-buy-box__rating" {{ block.shopify_attributes }}>
                <span class="cwc_product-buy-box__stars" role="img" aria-label="5 out of 5 stars">
                  {% for i in (1..5) %}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
                    </svg>
                  {% endfor %}
                </span>
                {% if block.settings.review_text != blank %}
                  <a href="{{ block.settings.review_link | default: '#cwc_product-reviews' }}">
                    {{ block.settings.review_text }}
                  </a>
                {% endif %}
              </div>

            {% when 'price' %}
              <div class="cwc_product-buy-box__price-row" {{ block.shopify_attributes }} data-cwc-price-row>
                <span class="cwc_product-buy-box__price" data-cwc-price>
                  {{ current_variant.price | money }}
                </span>
                {% if current_variant.compare_at_price > current_variant.price %}
                  <span class="cwc_product-buy-box__price-was" data-cwc-compare>
                    {{ current_variant.compare_at_price | money }}
                  </span>
                  <span class="cwc_product-buy-box__save" data-cwc-save>
                    Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
                  </span>
                {% endif %}
              </div>

            {% when 'meta' %}
              {% liquid
                if block.settings.text != blank
                  assign meta_line = block.settings.text
                else
                  assign meta_line = product_meta
                endif
              %}
              {% if meta_line != blank %}
                <p class="cwc_product-buy-box__meta" {{ block.shopify_attributes }}>{{ meta_line }}</p>
              {% endif %}

            {% when 'stock' %}
              {% liquid
                assign stock_message = ''
                if buy_product.available == false
                  assign stock_message = block.settings.sold_out_text
                elsif current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_threshold
                  assign stock_message = block.settings.low_text | replace: '[count]', current_variant.inventory_quantity
                else
                  assign stock_message = block.settings.in_stock_text
                endif
              %}
              {% if stock_message != blank %}
                <p
                  class="cwc_product-buy-box__stock{% unless buy_product.available %} cwc_product-buy-box__stock--out{% endunless %}"
                  {{ block.shopify_attributes }}
                >
                  <span class="cwc_product-buy-box__stock-dot" aria-hidden="true"></span>
                  {{ stock_message }}
                </p>
              {% endif %}

            {% when 'delivery_estimate' %}
              {%- liquid
                comment
                  Delivery = processing (counted from today if ordered on a business day
                  before the cutoff, otherwise from the next business day) + UPS transit,
                  in business days. CWC_product_buy_box.js fills in the dates in store
                  (Pacific) time and unhides the line; without JS it stays hidden.
                endcomment
                assign processing_min = block.settings.processing_min | default: 3
                assign processing_max = block.settings.processing_max | default: 5 | at_least: processing_min
                assign transit_min = block.settings.transit_min | default: 1
                assign transit_max = block.settings.transit_max | default: 5 | at_least: transit_min
                assign closed_dates = block.settings.closed_dates | newline_to_br | strip_newlines | replace: '<br />', ',' | remove: ' '
              -%}
              <p
                class="cwc_product-buy-box__estimate"
                data-delivery-estimate
                data-processing-min="{{ processing_min }}"
                data-processing-max="{{ processing_max }}"
                data-transit-min="{{ transit_min }}"
                data-transit-max="{{ transit_max }}"
                data-cutoff-hour="{{ block.settings.cutoff_hour }}"
                data-closed-dates="{{ closed_dates | escape }}"
                style="--estimate-bg: {{ block.settings.bg_color | default: '#FBEFDD' }}; --estimate-text: {{ block.settings.text_color | default: '#14281D' }}; --estimate-accent: {{ block.settings.accent_color | default: '#A35A12' }};"
                hidden
                {{ block.shopify_attributes }}
              >
                <svg class="cwc_product-buy-box__estimate-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="11" fill="currentColor"></circle><path d="M12 6.5V12l3.75 3.4" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                <span>
                  {% if block.settings.label != blank %}{{ block.settings.label | escape }} {% endif -%}
                  <strong class="cwc_product-buy-box__estimate-date" data-estimate-date></strong>
                </span>
              </p>

            {% when 'buy_buttons' %}
              <div class="cwc_product-buy-box__buy" {{ block.shopify_attributes }}>
                {% form 'product', buy_product, class: 'cwc_product-buy-box__form' %}
                  {% comment %}
                    A real product form — it posts to /cart/add and works with
                    JS disabled. The script upgrades it to an AJAX add.
                  {% endcomment %}
                  {% unless buy_product.has_only_default_variant %}
                    <div class="cwc_product-buy-box__variants">
                      <label for="cwc_variant-{{ section.id }}">
                        {{- block.settings.variant_label | default: 'Option' -}}
                      </label>
                      <select id="cwc_variant-{{ section.id }}" name="id" data-cwc-variant-select>
                        {% for variant in buy_product.variants %}
                          <option
                            value="{{ variant.id }}"
                            {% if variant.featured_media != blank %}data-media-id="{{ variant.featured_media.id }}"{% endif %}
                            {% if variant == current_variant %}
                              selected
                            {% endif %}
                            {% unless variant.available %}
                              disabled
                            {% endunless %}
                          >
                            {{ variant.title }} — {{ variant.price | money }}
                          </option>
                        {% endfor %}
                      </select>
                    </div>
                  {% else %}
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {% endunless %}

                  <div class="cwc_product-buy-box__buy-row">
                    {% if block.settings.show_quantity %}
                      <div class="cwc_product-buy-box__qty">
                        <button type="button" data-cwc-qty="-1" aria-label="Decrease quantity">&minus;</button>
                        <label class="cwc_product-buy-box__qty-label" for="cwc_qty-{{ section.id }}">Quantity</label>
                        <input
                          id="cwc_qty-{{ section.id }}"
                          type="number"
                          name="quantity"
                          value="1"
                          min="1"
                          inputmode="numeric"
                          data-cwc-qty-input
                        >
                        <button type="button" data-cwc-qty="1" aria-label="Increase quantity">+</button>
                      </div>
                    {% endif %}

                    <button
                      type="submit"
                      name="add"
                      class="cwc_product-buy-box__atc"
                      data-cwc-atc
                      {% unless buy_product.available %}
                        disabled
                      {% endunless %}
                    >
                      {% if buy_product.available %}
                        {{ block.settings.button_label | default: 'Add to Cart' }}
                      {% else %}
                        {{ block.settings.sold_out_label | default: 'Sold Out' }}
                      {% endif %}
                    </button>
                  </div>
                {% endform %}
              </div>

            {% when 'nudge' %}
              {% liquid
                assign threshold = block.settings.threshold | times: 100
                assign remaining = threshold | minus: cart.total_price

                # formatted separately — chaining `| money` after `| replace`
                # feeds the whole sentence to the filter and renders blank
                assign remaining_money = remaining | money
              %}
              {% if remaining > 0 %}
                <p class="cwc_product-buy-box__nudge" {{ block.shopify_attributes }}>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="1" y="4" width="15" height="12" rx="1" />
                    <path d="M16 8h4l3 3v5h-7V8z" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                  </svg>
                  {{ block.settings.text | replace: '[amount]', remaining_money }}
                </p>
              {% elsif block.settings.reached_text != blank %}
                <p class="cwc_product-buy-box__nudge" {{ block.shopify_attributes }}>
                  {{ block.settings.reached_text }}
                </p>
              {% endif %}

            {% when 'protection' %}
              {% if block.settings.text != blank %}
                <p class="cwc_product-buy-box__protect" {{ block.shopify_attributes }}>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                  {{ block.settings.text }}
                </p>
              {% endif %}

            {% when 'trust_row' %}
              <div class="cwc_product-buy-box__trust" {{ block.shopify_attributes }}>
                {% for i in (1..4) %}
                  {% liquid
                    assign icon_key = 'icon_' | append: i
                    assign text_key = 'text_' | append: i
                    assign trust_icon = block.settings[icon_key]
                    assign trust_text = block.settings[text_key]
                  %}
                  {% if trust_text != blank %}
                    <div class="cwc_product-buy-box__trust-item">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        focusable="false"
                      >
                        {% case trust_icon %}
                          {% when 'shield' %}
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                          {% when 'truck' %}
                            <rect x="1" y="4" width="15" height="12" rx="1" />
                            <path d="M16 8h4l3 3v5h-7V8z" />
                            <circle cx="5.5" cy="18.5" r="2.5" />
                            <circle cx="18.5" cy="18.5" r="2.5" />
                          {% when 'check' %}
                            <circle cx="12" cy="12" r="9" />
                            <path d="M8 12.4l2.6 2.6L16 9.6" />
                          {% when 'lock' %}
                            <rect x="4" y="10" width="16" height="11" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                          {% when 'star' %}
                            <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
                          {% when 'bottle' %}
                            <path d="M10 2.5h4V6l2 3.2V21H8V9.2L10 6V2.5z" />
                            <path d="M8 13h8" />
                        {% endcase %}
                      </svg>
                      <span>{{ trust_text }}</span>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>

            {% when 'help' %}
              {%- assign help_phone_digits = block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' -%}
              <div class="cwc_product-buy-box__help{% if block.settings.show_photo %} cwc_product-buy-box__help--photo{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.show_photo %}
                  <div class="cwc_product-buy-box__help-photo">
                    {% if block.settings.staff_photo != blank %}
                      <img
                        src="{{ block.settings.staff_photo | image_url: width: 160 }}"
                        alt="{{ block.settings.staff_photo.alt | escape }}"
                        loading="lazy"
                        width="64"
                        height="64"
                      >
                    {% endif %}
                  </div>
                {% endif %}
                <div class="cwc_product-buy-box__help-body">
                  {% if block.settings.heading != blank %}
                    <p class="cwc_product-buy-box__help-heading">{{ block.settings.heading | escape }}</p>
                  {% endif %}
                  {% if block.settings.subtext != blank or block.settings.hours != blank %}
                    <p class="cwc_product-buy-box__help-meta">
                      {% if block.settings.subtext != blank %}
                        <span class="cwc_product-buy-box__help-subtext">{{ block.settings.subtext | escape }}{% if block.settings.hours != blank %} · {% endif %}</span>
                      {%- endif -%}
                      {{ block.settings.hours | escape }}
                    </p>
                  {% endif %}
                  <div class="cwc_product-buy-box__help-actions">
                    {% if block.settings.phone != blank %}
                      <a href="tel:{{ help_phone_digits }}" class="cwc_product-buy-box__help-button cwc_product-buy-box__help-button--outline">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
                        <span class="cwc_product-buy-box__help-label-desktop">{{ block.settings.call_label | escape }} {{ block.settings.phone | escape }}</span>
                        <span class="cwc_product-buy-box__help-label-mobile">{{ block.settings.call_label_mobile | default: block.settings.call_label | escape }}</span>
                      </a>
                    {% endif %}
                    {%- liquid
                      # Inbox chat falls back to the link, then the phone number, if Inbox can't open
                      assign chat_is_inbox = false
                      if block.settings.chat_action == 'inbox'
                        assign chat_is_inbox = true
                      endif
                      assign chat_href = block.settings.chat_url
                      if chat_href == blank and chat_is_inbox and block.settings.phone != blank
                        assign chat_href = 'tel:' | append: help_phone_digits
                      endif
                    -%}
                    {% if chat_is_inbox or block.settings.chat_url != blank %}
                      <a
                        href="{{ chat_href | default: '#' }}"
                        class="cwc_product-buy-box__help-button cwc_product-buy-box__help-button--dark"
                        {% if chat_is_inbox %}data-inbox-trigger{% endif %}
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M4 5h16v11H9l-5 4z"></path></svg>
                        {{ block.settings.chat_label | escape }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>

            {% when 'fbt' %}
              {%- liquid
                # Companion rows normally come from the recommendations API at
                # runtime. The picked products below are the fallback: rendered
                # server-side so the block is never empty and works without JS,
                # then replaced once live recommendations arrive.
                assign fbt_fallback_count = 0
                for i in (1..3)
                  assign fallback_key = 'product_' | append: i
                  assign fallback_product = block.settings[fallback_key]
                  if fallback_product != blank and fallback_product.available
                    assign fbt_fallback_count = fbt_fallback_count | plus: 1
                  endif
                endfor

                # Mirrors the automatic discount configured in Shopify. Nothing
                # here creates or applies a discount — the cart does that — so
                # these two numbers must be kept in step with the real rule.
                assign fbt_discount_threshold = block.settings.discount_threshold | times: 100 | round
                assign fbt_discount_percent = block.settings.discount_percent

                assign fbt_position = block.settings.discount_position | default: 'top'
                assign fbt_offer_top = false
                assign fbt_offer_bottom = false
                if fbt_position == 'top' or fbt_position == 'both'
                  assign fbt_offer_top = true
                endif
                if fbt_position == 'bottom' or fbt_position == 'both'
                  assign fbt_offer_bottom = true
                endif
              -%}
              <div
                class="cwc_product-buy-box__fbt"
                {{ block.shopify_attributes }}
                data-cwc-fbt
                data-product-id="{{ buy_product.id }}"
                data-shop="{{ shop.permanent_domain }}"
                data-max="{{ block.settings.max_products | default: 3 }}"
                {% comment %}
                  The label's count token cannot be written as a literal here —
                  a brace inside an output tag reads as the start of another tag
                  and the template fails to parse. The schema default carries it,
                  and the script has its own fallback for a blank setting.
                {% endcomment %}
                data-total-label="{{ block.settings.total_label | escape }}"
                data-discount-threshold="{{ fbt_discount_threshold }}"
                data-discount-percent="{{ fbt_discount_percent }}"
                data-discount-note="{{ block.settings.discount_note | escape }}"
                data-discount-note-pending="{{ block.settings.discount_note_pending | escape }}"
                data-save-label="{{ block.settings.save_badge_label | escape }}"
                {% unless block.settings.show_item_meta %}data-cwc-fbt-no-meta{% endunless %}
                style="--cwc-fbt-thumb: {{ block.settings.thumb_size | default: 56 }}px; --cwc-fbt-zoom: {{ block.settings.thumb_zoom | default: 115 | divided_by: 100.0 }};"
                {% if block.settings.show_item_discounts %}data-cwc-fbt-item-discounts{% endif %}
                {% if block.settings.use_recommendations %}data-cwc-fbt-fetch{% endif %}
                {% comment %}
                  With nothing picked there is nothing to pair with yet — stay
                  hidden rather than showing this product on its own, and let
                  the fetch reveal the block only if it finds companions.
                {% endcomment %}
                {% if fbt_fallback_count == 0 %}hidden{% endif %}
              >
                {% comment %}
                  The offer leads the block so the saving frames the products
                  rather than trailing them. Clearing the heading in the editor
                  leaves this bar on its own as the block's opening line.
                {% endcomment %}
           
                {% if block.settings.heading != blank %}
                  <h2 class="cwc_product-buy-box__fbt-head">{{ block.settings.heading }}</h2>
                {% endif %}

               {% if fbt_offer_top %}
                  <p class="cwc_product-buy-box__fbt-offer" data-cwc-fbt-offer hidden></p>
                {% endif %}

                <div class="cwc_product-buy-box__fbt-row" data-cwc-fbt-list>
                  {% comment %} This product first, and unlike the companions it is never replaced {% endcomment %}
                  <label class="cwc_product-buy-box__fbt-item">
                    {% comment %}
                      The whole row is the control. The input stays in the
                      markup and keeps the label, keyboard focus and screen
                      reader wiring — it is only moved out of sight, so the
                      badge on the thumbnail is decorative.
                    {% endcomment %}
                    <input
                      type="checkbox"
                      class="cwc_product-buy-box__fbt-check"
                      checked
                      data-cwc-fbt-check
                      data-cwc-fbt-self
                      data-variant-id="{{ current_variant.id }}"
                      data-product-id="{{ buy_product.id }}"
                      data-price="{{ current_variant.price }}"
                    >
                    <span class="cwc_product-buy-box__fbt-thumb">
                      <span class="cwc_product-buy-box__fbt-thumb-frame">
                        {% if buy_product.featured_image != blank %}
                          <img
                            src="{{ buy_product.featured_image | image_url: width: 160 }}"
                            alt=""
                            loading="lazy"
                            width="56"
                            height="56"
                          >
                        {% endif %}
                      </span>
                      {% render 'cwc_fbt_tick' %}
                    </span>
                    <span class="cwc_product-buy-box__fbt-info">
                      <span class="cwc_product-buy-box__fbt-name">
                        {{ buy_product.title }}
                        <em>({{ block.settings.this_item_label | default: 'This item' }})</em>
                      </span>
                      {% if product_meta != blank and block.settings.show_item_meta %}
                        <span class="cwc_product-buy-box__fbt-meta">{{ product_meta }}</span>
                      {% endif %}
                    </span>
                    <span class="cwc_product-buy-box__fbt-price">{{ current_variant.price | money }}</span>
                  </label>

                  {% for i in (1..3) %}
                    {% liquid
                      assign key = 'product_' | append: i
                      assign fbt_product = block.settings[key]
                    %}
                    {% comment %} Sold-out picks are dropped rather than shown disabled {% endcomment %}
                    {% if fbt_product != blank and fbt_product.available %}
                      {% assign fbt_variant = fbt_product.selected_or_first_available_variant %}
                      {% liquid
                        assign fbt_meta = fbt_product.metafields.custom.details
                        if fbt_meta == blank
                          assign fbt_meta = fbt_product.type
                        endif
                      %}
                      <label class="cwc_product-buy-box__fbt-item" data-cwc-fbt-fallback>
                        <input
                          type="checkbox"
                          class="cwc_product-buy-box__fbt-check"
                          checked
                          data-cwc-fbt-check
                          data-variant-id="{{ fbt_variant.id }}"
                          data-product-id="{{ fbt_product.id }}"
                          data-price="{{ fbt_variant.price }}"
                        >
                        <span class="cwc_product-buy-box__fbt-thumb">
                          <span class="cwc_product-buy-box__fbt-thumb-frame">
                            {% if fbt_product.featured_image != blank %}
                              <img
                                src="{{ fbt_product.featured_image | image_url: width: 160 }}"
                                alt=""
                                loading="lazy"
                                width="56"
                                height="56"
                              >
                            {% endif %}
                          </span>
                          {% render 'cwc_fbt_tick' %}
                        </span>
                        <span class="cwc_product-buy-box__fbt-info">
                          <span class="cwc_product-buy-box__fbt-name">{{ fbt_product.title }}</span>
                          {% if fbt_meta != blank and block.settings.show_item_meta %}
                            <span class="cwc_product-buy-box__fbt-meta">{{ fbt_meta }}</span>
                          {% endif %}
                        </span>
                        <span class="cwc_product-buy-box__fbt-price">{{ fbt_variant.price | money }}</span>
                      </label>
                    {% endif %}
                  {% endfor %}
                </div>

                {% comment %}
                  One empty row for the JS to clone per live recommendation, so
                  the markup and its classes stay here rather than in the script.
                {% endcomment %}
                <template data-cwc-fbt-template>
                  <label class="cwc_product-buy-box__fbt-item">
                    <input
                      type="checkbox"
                      class="cwc_product-buy-box__fbt-check"
                      checked
                      data-cwc-fbt-check
                    >
                    <span class="cwc_product-buy-box__fbt-thumb">
                      <span class="cwc_product-buy-box__fbt-thumb-frame">
                        <img alt="" loading="lazy" width="56" height="56" hidden>
                      </span>
                      {% render 'cwc_fbt_tick' %}
                    </span>
                    <span class="cwc_product-buy-box__fbt-info">
                      <span class="cwc_product-buy-box__fbt-name"></span>
                      <span class="cwc_product-buy-box__fbt-meta" hidden></span>
                    </span>
                    <span class="cwc_product-buy-box__fbt-price"></span>
                  </label>
                </template>

                <div class="cwc_product-buy-box__fbt-total">
                  <span class="cwc_product-buy-box__fbt-total-label" data-cwc-fbt-label>
                    {% comment %} Replaced by the script with the live count {% endcomment %}
                    {{ block.settings.total_label | default: 'Total for selected' }}
                  </span>
                  {% comment %}
                    Flat on purpose. All four are direct children so the narrow
                    layout can regroup them into two lines — label + badge, then
                    was + now — and collapse back to one line with no discount.
                  {% endcomment %}
                  <span class="cwc_product-buy-box__fbt-save" data-cwc-fbt-save hidden></span>
                  <s class="cwc_product-buy-box__fbt-total-was" data-cwc-fbt-total-was hidden></s>
                  <span class="cwc_product-buy-box__fbt-total-price" data-cwc-fbt-total></span>
                </div>

                {% if fbt_offer_bottom %}
                  <p
                    class="cwc_product-buy-box__fbt-offer cwc_product-buy-box__fbt-offer--bottom"
                    data-cwc-fbt-offer
                    hidden
                  ></p>
                {% endif %}

                <button type="button" class="cwc_product-buy-box__fbt-button" data-cwc-fbt-add>
                  {{ block.settings.button_label | default: 'Add Selected to Cart' }}
                </button>
              </div>
          {% endcase %}



        {%- endfor %}
        </div> </div> </div> </section>

        <script src="{{ 'CWC_product_buy_box.js' | asset_url }}" defer></script>
        <script src="{{ 'CWC_inbox_trigger.js' | asset_url }}" defer></script>

        {% schema %}
{
  "name": "CWC Product Buy Box",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the product being viewed."
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Gallery Width",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "sticky_gallery",
      "label": "Sticky Gallery (Desktop)",
      "default": true,
      "info": "The gallery stays in view under the header while the buy column scrolls."
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show Thumbnails (Desktop)",
      "default": true,
      "info": "Tablet and mobile swipe between images, with progress bars instead."
    },
    {
      "type": "checkbox",
      "id": "media_spotlight",
      "label": "Spotlight Background",
      "default": false,
      "info": "Soft spotlight behind the bottle, tinted with the gallery background color. Off uses the same image background as the collection cards."
    },
    {
      "type": "range",
      "id": "gallery_limit",
      "label": "Maximum Images",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "thumb_note",
      "label": "Thumbnail Note",
      "default": "Thumbnail strip hides automatically when a product has only one image."
    },
    {
      "type": "header",
      "content": "Gallery Testimonial (Desktop)"
    },
    {
      "type": "checkbox",
      "id": "show_testimonial",
      "label": "Show Testimonial Under Gallery",
      "default": true,
      "info": "Desktop only. Connect the fields to product metafields for a per-product review."
    },
    {
      "type": "range",
      "id": "testimonial_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "textarea",
      "id": "testimonial_quote",
      "label": "Quote",
      "default": "I was nervous ordering online due to how hard it was to find at retail stores but this company is LEGIT. Packaging was great and bottle in perfect shape"
    },
    {
      "type": "image_picker",
      "id": "testimonial_photo",
      "label": "Customer Photo"
    },
    {
      "type": "text",
      "id": "testimonial_name",
      "label": "Customer Name",
      "default": "Justyn King"
    },
    {
      "type": "text",
      "id": "testimonial_verified_label",
      "label": "Verified Label",
      "default": "Verified buyer",
      "info": "Leave blank to hide"
    },
    {
      "type": "checkbox",
      "id": "testimonial_use_product_review",
      "label": "Use Product Review When Available",
      "default": true,
      "info": "Swaps in this product's own Judge.me review when one meets the minimum rating. Otherwise the review above shows."
    },
    {
      "type": "range",
      "id": "testimonial_min_rating",
      "label": "Product Review Minimum Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#14281D"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#A35A12"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Gallery Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ECECE8"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Add To Cart Color",
      "default": "#E9A23B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Add To Cart Text Color",
      "default": "#14281D"
    },
    {
      "type": "color",
      "id": "stock_color",
      "label": "In Stock Color",
      "default": "#A35A12"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
