{% style %}
  #cwc_product-buy-box-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#0A1F12' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C4933F' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#666666' }};
    --meta-color: {{ section.settings.meta_color | default: '#9A9A9A' }};
    --media-bg: {{ section.settings.media_bg_color | default: '#F2EFE8' }};
    --border-color: {{ section.settings.border_color | default: '#E0DDD6' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#C4933F' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};
    --stock-color: {{ section.settings.stock_color | default: '#2E7D47' }};
    --media-width: {{ section.settings.media_width | default: 45 }}%;
    --padding-top: {{ section.settings.padding_top | default: 30 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 30 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_buy_box.css' | asset_url | stylesheet_tag }}

{% liquid
  assign buy_product = section.settings.product | default: product
  assign current_variant = buy_product.selected_or_first_available_variant

  # Detail line: metafield first, product type as the fallback
  assign product_meta = buy_product.metafields.custom.details
  if product_meta == blank
    assign product_meta = buy_product.type
  endif
%}

<section
  id="cwc_product-buy-box-{{ section.id }}"
  class="cwc_product-buy-box"
  data-section-id="{{ section.id }}"
  data-product-url="{{ buy_product.url }}"
>
  <div class="cwc_product-buy-box__container">
    <div class="cwc_product-buy-box__layout">

      {% comment %} Media gallery {% endcomment %}
      <div class="cwc_product-buy-box__media">
        <div class="cwc_product-buy-box__media-main" data-cwc-media-main>
          {% if buy_product.featured_media != blank %}
            <img
              src="{{ buy_product.featured_media | image_url: width: 1200 }}"
              alt="{{ buy_product.featured_media.alt | default: buy_product.title | escape }}"
              loading="eager"
              fetchpriority="high"
              width="1200"
              height="1200"
              data-cwc-media-image
            >
          {% else %}
            <span class="cwc_product-buy-box__media-placeholder">
              <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
                <rect x="16" y="0" width="20" height="6" rx="2" />
                <rect x="18" y="6" width="16" height="11" />
                <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
              </svg>
            </span>
          {% endif %}

          {% liquid
            assign badge_label = ''
            if buy_product.available == false
              assign badge_label = 'Sold Out'
            elsif buy_product.tags contains 'Allocated' or buy_product.tags contains 'allocated'
              assign badge_label = 'Allocated'
            elsif buy_product.tags contains 'Barrel Pick' or buy_product.tags contains 'barrel pick'
              assign badge_label = 'Barrel Pick'
            elsif buy_product.tags contains 'New' or buy_product.tags contains 'new'
              assign badge_label = 'New'
            endif
          %}

          {% if badge_label != blank %}
            <span class="cwc_product-buy-box__media-badge">{{ badge_label }}</span>
          {% endif %}
        </div>

        {% comment %} Thumb strip hides itself when there is only one image {% endcomment %}
        {% if buy_product.media.size > 1 %}
          <div class="cwc_product-buy-box__thumbs" role="group" aria-label="Product images">
            {% for media in buy_product.media limit: section.settings.gallery_limit %}
              <button
                type="button"
                class="cwc_product-buy-box__thumb{% if forloop.first %} cwc_product-buy-box__thumb--active{% endif %}"
                data-cwc-thumb
                data-full="{{ media | image_url: width: 1200 }}"
                aria-label="Show image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 200 }}"
                  alt=""
                  loading="lazy"
                  width="200"
                  height="200"
                >
              </button>
            {% endfor %}
          </div>

          {% if section.settings.thumb_note != blank %}
            <p class="cwc_product-buy-box__thumb-note">{{ section.settings.thumb_note }}</p>
          {% endif %}
        {% endif %}
      </div>

      {% comment %} Buy column — every row is a reorderable block {% endcomment %}
      <div class="cwc_product-buy-box__info">
        {% for block in section.blocks %}
          {% case block.type %}

            {% comment %}
              App blocks from installed apps — subscription widgets, review
              badges, size charts. Ordered like any other block, so an app can
              sit between the price and the buy button.
            {% endcomment %}
            {% when '@app' %}
              <div class="cwc_product-buy-box__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {% when 'brand' %}
              {% if buy_product.vendor != blank %}
                <div class="cwc_product-buy-box__brand" {{ block.shopify_attributes }}>
                  {% if block.settings.link_vendor %}
                    <a href="{{ buy_product.vendor | url_for_vendor }}">{{ buy_product.vendor }}</a>
                  {% else %}
                    {{ buy_product.vendor }}
                  {% endif %}
                </div>
              {% endif %}

            {% when 'title' %}
              <h1 class="cwc_product-buy-box__title" {{ block.shopify_attributes }}>
                {{ buy_product.title }}
              </h1>

            {% when 'rating' %}
              <div class="cwc_product-buy-box__rating" {{ block.shopify_attributes }}>
                <span class="cwc_product-buy-box__stars" role="img" aria-label="5 out of 5 stars">
                  {% for i in (1..5) %}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
                    </svg>
                  {% endfor %}
                </span>
                {% if block.settings.review_text != blank %}
                  <a href="{{ block.settings.review_link | default: '#cwc_product-reviews' }}">
                    {{ block.settings.review_text }}
                  </a>
                {% endif %}
              </div>

            {% when 'price' %}
              <div class="cwc_product-buy-box__price-row" {{ block.shopify_attributes }} data-cwc-price-row>
                <span class="cwc_product-buy-box__price" data-cwc-price>
                  {{ current_variant.price | money }}
                </span>
                {% if current_variant.compare_at_price > current_variant.price %}
                  <span class="cwc_product-buy-box__price-was" data-cwc-compare>
                    {{ current_variant.compare_at_price | money }}
                  </span>
                  <span class="cwc_product-buy-box__save" data-cwc-save>
                    Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
                  </span>
                {% endif %}
              </div>

            {% when 'meta' %}
              {% liquid
                if block.settings.text != blank
                  assign meta_line = block.settings.text
                else
                  assign meta_line = product_meta
                endif
              %}
              {% if meta_line != blank %}
                <p class="cwc_product-buy-box__meta" {{ block.shopify_attributes }}>{{ meta_line }}</p>
              {% endif %}

            {% when 'stock' %}
              {% liquid
                assign stock_message = ''
                if buy_product.available == false
                  assign stock_message = block.settings.sold_out_text
                elsif current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_threshold
                  assign stock_message = block.settings.low_text | replace: '[count]', current_variant.inventory_quantity
                else
                  assign stock_message = block.settings.in_stock_text
                endif
              %}
              {% if stock_message != blank %}
                <p class="cwc_product-buy-box__stock{% unless buy_product.available %} cwc_product-buy-box__stock--out{% endunless %}" {{ block.shopify_attributes }}>
                  <span class="cwc_product-buy-box__stock-dot" aria-hidden="true"></span>
                  {{ stock_message }}
                </p>
              {% endif %}

            {% when 'buy_buttons' %}
              <div class="cwc_product-buy-box__buy" {{ block.shopify_attributes }}>
                {% form 'product', buy_product, class: 'cwc_product-buy-box__form' %}
                  {% comment %}
                    A real product form — it posts to /cart/add and works with
                    JS disabled. The script upgrades it to an AJAX add.
                  {% endcomment %}
                  {% unless buy_product.has_only_default_variant %}
                    <div class="cwc_product-buy-box__variants">
                      <label for="cwc_variant-{{ section.id }}">{{ block.settings.variant_label | default: 'Option' }}</label>
                      <select id="cwc_variant-{{ section.id }}" name="id" data-cwc-variant-select>
                        {% for variant in buy_product.variants %}
                          <option
                            value="{{ variant.id }}"
                            {% if variant == current_variant %}selected{% endif %}
                            {% unless variant.available %}disabled{% endunless %}
                          >
                            {{ variant.title }} — {{ variant.price | money }}
                          </option>
                        {% endfor %}
                      </select>
                    </div>
                  {% else %}
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {% endunless %}

                  <div class="cwc_product-buy-box__buy-row">
                    {% if block.settings.show_quantity %}
                      <div class="cwc_product-buy-box__qty">
                        <button type="button" data-cwc-qty="-1" aria-label="Decrease quantity">&minus;</button>
                        <label class="cwc_product-buy-box__qty-label" for="cwc_qty-{{ section.id }}">Quantity</label>
                        <input
                          id="cwc_qty-{{ section.id }}"
                          type="number"
                          name="quantity"
                          value="1"
                          min="1"
                          inputmode="numeric"
                          data-cwc-qty-input
                        >
                        <button type="button" data-cwc-qty="1" aria-label="Increase quantity">+</button>
                      </div>
                    {% endif %}

                    <button
                      type="submit"
                      name="add"
                      class="cwc_product-buy-box__atc"
                      data-cwc-atc
                      {% unless buy_product.available %}disabled{% endunless %}
                    >
                      {% if buy_product.available %}
                        {{ block.settings.button_label | default: 'Add to Cart' }}
                      {% else %}
                        {{ block.settings.sold_out_label | default: 'Sold Out' }}
                      {% endif %}
                    </button>
                  </div>
                {% endform %}
              </div>

            {% when 'nudge' %}
              {% liquid
                assign threshold = block.settings.threshold | times: 100
                assign remaining = threshold | minus: cart.total_price
              %}
              {% if remaining > 0 %}
                <p class="cwc_product-buy-box__nudge" {{ block.shopify_attributes }}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <rect x="1" y="4" width="15" height="12" rx="1" />
                    <path d="M16 8h4l3 3v5h-7V8z" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                  </svg>
                  {{ block.settings.text | replace: '[amount]', remaining | money }}
                </p>
              {% elsif block.settings.reached_text != blank %}
                <p class="cwc_product-buy-box__nudge" {{ block.shopify_attributes }}>
                  {{ block.settings.reached_text }}
                </p>
              {% endif %}

            {% when 'protection' %}
              {% if block.settings.text != blank %}
                <p class="cwc_product-buy-box__protect" {{ block.shopify_attributes }}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                  {{ block.settings.text }}
                </p>
              {% endif %}

            {% when 'trust_row' %}
              <div class="cwc_product-buy-box__trust" {{ block.shopify_attributes }}>
                {% for i in (1..4) %}
                  {% liquid
                    assign icon_key = 'icon_' | append: i
                    assign text_key = 'text_' | append: i
                    assign trust_icon = block.settings[icon_key]
                    assign trust_text = block.settings[text_key]
                  %}
                  {% if trust_text != blank %}
                    <div class="cwc_product-buy-box__trust-item">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        {% case trust_icon %}
                          {% when 'shield' %}
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                          {% when 'truck' %}
                            <rect x="1" y="4" width="15" height="12" rx="1" />
                            <path d="M16 8h4l3 3v5h-7V8z" />
                            <circle cx="5.5" cy="18.5" r="2.5" />
                            <circle cx="18.5" cy="18.5" r="2.5" />
                          {% when 'check' %}
                            <circle cx="12" cy="12" r="9" />
                            <path d="M8 12.4l2.6 2.6L16 9.6" />
                          {% when 'lock' %}
                            <rect x="4" y="10" width="16" height="11" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                          {% when 'star' %}
                            <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
                          {% when 'bottle' %}
                            <path d="M10 2.5h4V6l2 3.2V21H8V9.2L10 6V2.5z" />
                            <path d="M8 13h8" />
                        {% endcase %}
                      </svg>
                      <span>{{ trust_text }}</span>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>

            {% when 'fbt' %}
              <div class="cwc_product-buy-box__fbt" {{ block.shopify_attributes }} data-cwc-fbt>
                {% if block.settings.heading != blank %}
                  <h2 class="cwc_product-buy-box__fbt-head">{{ block.settings.heading }}</h2>
                {% endif %}

                <div class="cwc_product-buy-box__fbt-row">
                  {% comment %} This product first, always checked {% endcomment %}
                  <label class="cwc_product-buy-box__fbt-item">
                    <input
                      type="checkbox"
                      class="cwc_product-buy-box__fbt-check"
                      checked
                      disabled
                      data-cwc-fbt-self
                      data-variant-id="{{ current_variant.id }}"
                      data-price="{{ current_variant.price }}"
                    >
                    <span class="cwc_product-buy-box__fbt-thumb">
                      {% if buy_product.featured_image != blank %}
                        <img src="{{ buy_product.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="46" height="58">
                      {% endif %}
                    </span>
                    <span class="cwc_product-buy-box__fbt-info">
                      <span class="cwc_product-buy-box__fbt-name">
                        {{ buy_product.title }} <em>({{ block.settings.this_item_label | default: 'This item' }})</em>
                      </span>
                      {% if product_meta != blank %}
                        <span class="cwc_product-buy-box__fbt-meta">{{ product_meta }}</span>
                      {% endif %}
                    </span>
                    <span class="cwc_product-buy-box__fbt-price">{{ current_variant.price | money }}</span>
                  </label>

                  {% for i in (1..3) %}
                    {% liquid
                      assign key = 'product_' | append: i
                      assign fbt_product = block.settings[key]
                    %}
                    {% if fbt_product != blank %}
                      {% assign fbt_variant = fbt_product.selected_or_first_available_variant %}
                      {% liquid
                        assign fbt_meta = fbt_product.metafields.custom.details
                        if fbt_meta == blank
                          assign fbt_meta = fbt_product.type
                        endif
                      %}
                      <label class="cwc_product-buy-box__fbt-item">
                        <input
                          type="checkbox"
                          class="cwc_product-buy-box__fbt-check"
                          data-cwc-fbt-check
                          data-variant-id="{{ fbt_variant.id }}"
                          data-price="{{ fbt_variant.price }}"
                          {% if forloop.first %}checked{% endif %}
                          {% unless fbt_product.available %}disabled{% endunless %}
                        >
                        <span class="cwc_product-buy-box__fbt-thumb">
                          {% if fbt_product.featured_image != blank %}
                            <img src="{{ fbt_product.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="46" height="58">
                          {% endif %}
                        </span>
                        <span class="cwc_product-buy-box__fbt-info">
                          <span class="cwc_product-buy-box__fbt-name">{{ fbt_product.title }}</span>
                          {% if fbt_meta != blank %}
                            <span class="cwc_product-buy-box__fbt-meta">{{ fbt_meta }}</span>
                          {% endif %}
                        </span>
                        <span class="cwc_product-buy-box__fbt-price">{{ fbt_variant.price | money }}</span>
                      </label>
                    {% endif %}
                  {% endfor %}
                </div>

                <div class="cwc_product-buy-box__fbt-total">
                  <span class="cwc_product-buy-box__fbt-total-label" data-cwc-fbt-label>
                    {{ block.settings.total_label | default: 'Total for selected' }}
                  </span>
                  <span class="cwc_product-buy-box__fbt-total-price" data-cwc-fbt-total></span>
                </div>

                <button type="button" class="cwc_product-buy-box__fbt-button" data-cwc-fbt-add>
                  {{ block.settings.button_label | default: 'Add Selected to Cart' }}
                </button>
              </div>

          {% endcase %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<script src="{{ 'CWC_product_buy_box.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Product Buy Box",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the product being viewed."
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Gallery Width",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "gallery_limit",
      "label": "Maximum Thumbnails",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "thumb_note",
      "label": "Thumbnail Note",
      "default": "Thumbnail strip hides automatically when a product has only one image."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0A1F12"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Color",
      "default": "#9A9A9A"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Gallery Background Color",
      "default": "#F2EFE8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E0DDD6"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Add To Cart Color",
      "default": "#C4933F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Add To Cart Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "stock_color",
      "label": "In Stock Color",
      "default": "#2E7D47"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "link_vendor",
          "label": "Link To Vendor",
          "default": true
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Uses the product title."
        }
      ]
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "review_text",
          "label": "Review Link Text",
          "default": "Read 24 reviews"
        },
        {
          "type": "url",
          "id": "review_link",
          "label": "Review Link"
        },
        {
          "type": "paragraph",
          "content": "Shows five stars. Swap for your review app's badge once it is installed."
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Uses the selected variant's price and compare-at price."
        }
      ]
    },
    {
      "type": "meta",
      "name": "Detail Line",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text Override",
          "info": "Falls back to the product's details metafield, then its type."
        }
      ]
    },
    {
      "type": "stock",
      "name": "Stock Message",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "in_stock_text",
          "label": "In Stock Text",
          "default": "In stock — ships this week"
        },
        {
          "type": "text",
          "id": "low_text",
          "label": "Low Stock Text",
          "default": "Only [count] left — ships this week",
          "info": "Use [count] for the remaining quantity."
        },
        {
          "type": "range",
          "id": "low_threshold",
          "label": "Low Stock Threshold",
          "min": 1,
          "max": 25,
          "step": 1,
          "default": 10
        },
        {
          "type": "text",
          "id": "sold_out_text",
          "label": "Sold Out Text",
          "default": "Sold out — join the waitlist"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show Quantity Selector",
          "default": true
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Add to Cart"
        },
        {
