      ]
    },
    {
      "type": "nudge",
      "name": "Free Shipping Nudge",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "threshold",
          "label": "Free Shipping Threshold",
          "min": 0,
          "max": 500,
          "step": 5,
          "default": 200
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
