          "info": "Use [count] for the remaining quantity."
        },
        {
          "type": "range",
          "id": "low_threshold",
          "label": "Low Stock Threshold",
          "min": 1,
          "max": 25,
          "step": 1,
          "default": 10
        },
        {
          "type": "text",
          "id": "sold_out_text",
          "label": "Sold Out Text",
          "default": "Sold out — join the waitlist"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show Quantity Selector",
          "default": true
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Add to Cart"
        },
        {
          "type": "text",
          "id": "sold_out_label",
          "label": "Sold Out Label",
          "default": "Sold Out"
        },
        {
          "type": "text",
          "id": "variant_label",
