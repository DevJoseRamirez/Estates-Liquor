        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Order today, estimated delivery"
        },
        {
          "type": "paragraph",
          "content": "Estimated delivery = processing time + UPS transit time, in business days (Mon–Fri). Uses store time (Pacific)."
        },
        {
          "type": "range",
          "id": "cutoff_hour",
          "label": "Same-Day Cutoff (Pacific, 24h)",
          "min": 0,
          "max": 23,
          "step": 1,
          "default": 16,
          "info": "Orders after this hour, on weekends or closed dates count from the next business day. 16 = 4 PM."
        },
        {
          "type": "range",
          "id": "processing_min",
          "label": "Processing Time, Fastest (business days)",
          "min": 0,
          "max": 15,
          "step": 1,
          "default": 3
        },
        {
          "type": "range",
          "id": "processing_max",
          "label": "Processing Time, Slowest (business days)",
          "min": 0,
          "max": 15,
          "step": 1,
          "default": 5
        },
        {
          "type": "range",
          "id": "transit_min",
          "label": "UPS Transit, Fastest (business days)",
          "min": 0,
          "max": 10,
          "step": 1,
          "default": 1
        },
        {
          "type": "range",
          "id": "transit_max",
          "label": "UPS Transit, Slowest (business days)",
          "min": 0,
          "max": 10,
          "step": 1,
