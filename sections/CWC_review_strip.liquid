{% style %}
  #cwc_review-strip-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --text-color: {{ section.settings.text_color | default: '#000000' }};
    --highlight-color: {{ section.settings.bold_color | default: '#C49340' }};
    --star-color: {{ section.settings.star_color | default: '#C49340' }};
    --author-color: {{ section.settings.author_color | default: '#6E6A60' }};
    --border-color: {{ section.settings.border_color | default: '#E4DED2' }};
    --heading-color: {{ section.settings.heading_color | default: '#13241C' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#8A6A2E' }};
    --rule-color: {{ section.settings.rule_color | default: '#13241C' }};
    --rs-card-min: {{ section.settings.card_min_width | default: 260 }}px;
    --rs-card-max: {{ section.settings.card_max_width | default: 360 }}px;
    --padding-top: {{ section.settings.padding_top | default: 14 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 14 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 14 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 14 | times: 0.5 }}px;
  }
{% endstyle %}

{%- comment -%}
  Thin social proof strip: every store review scrolls across the full width in
  one endless CSS-only loop (no JS). Same review source as CWC Store Reviews:
  Judge.me featured store reviews when on and any pass the filters, otherwise
  the review blocks.

  The loop is two identical halves; sliding the track by half its width lands
  exactly on the start again. A short review list is repeated inside each half
  so one half is always wider than the screen and no gap shows at the seam.
{%- endcomment -%}
{%- liquid
  assign text_limit = section.settings.text_limit | default: 110
  assign review_count = 0

  if section.settings.use_judgeme
    assign judgeme_reviews = shop.metafields.judgeme.reviews_grid.value.store_reviews.reviews
    assign judgeme_limit = section.settings.judgeme_limit | default: 25
    assign judgeme_min_rating = section.settings.judgeme_min_rating | default: 4

    capture items_primary
      for review in judgeme_reviews
        if review_count >= judgeme_limit
          break
        endif
        assign review_rating = review.rating | plus: 0
        if review_rating < judgeme_min_rating
          continue
        endif
        assign review_text = review.body | strip_html | strip | truncate: text_limit
        if review_text == blank
          continue
        endif
        render 'CWC_review_strip_item', rating: review_rating, text: review_text, author: review.reviewer_name
        assign review_count = review_count | plus: 1
      endfor
    endcapture

    if review_count > 0
      capture items_copy
        assign copy_count = 0
        for review in judgeme_reviews
          if copy_count >= judgeme_limit
            break
          endif
          assign review_rating = review.rating | plus: 0
          if review_rating < judgeme_min_rating
            continue
          endif
          assign review_text = review.body | strip_html | strip | truncate: text_limit
          if review_text == blank
            continue
          endif
          render 'CWC_review_strip_item', rating: review_rating, text: review_text, author: review.reviewer_name, hidden: true
          assign copy_count = copy_count | plus: 1
        endfor
      endcapture
    endif
  endif

  if review_count == 0
    capture items_primary
      for block in section.blocks
        if block.type != 'review' or block.settings.text == blank
          continue
        endif
        assign review_text = block.settings.text | strip_html | strip | truncate: text_limit
        render 'CWC_review_strip_item', rating: block.settings.rating, text: review_text, author: block.settings.author, block_attrs: block.shopify_attributes
        assign review_count = review_count | plus: 1
      endfor
    endcapture

    capture items_copy
      for block in section.blocks
        if block.type != 'review' or block.settings.text == blank
          continue
        endif
        assign review_text = block.settings.text | strip_html | strip | truncate: text_limit
        render 'CWC_review_strip_item', rating: block.settings.rating, text: review_text, author: block.settings.author, hidden: true
      endfor
    endcapture
  endif

  # Repeat a short list so each half holds at least 8 reviews (wider than any screen)
  assign repeats = 1
  if review_count > 0 and review_count < 8
    assign repeats = 8 | plus: review_count | minus: 1 | divided_by: review_count
  endif
  assign half_count = review_count | times: repeats
  assign loop_seconds = section.settings.seconds_per_review | default: 10 | times: half_count

  # Header summary: live Judge.me rating + count, falling back to the summary text
  assign summary_text = section.settings.summary_fallback
  assign summary_rating = 0
  assign summary_count = 0
  assign summary_source = section.settings.summary_source | default: 'all'
  if summary_source == 'store'
    assign summary_count = shop.metafields.judgeme.shop_reviews_count.value | plus: 0
    assign summary_rating = shop.metafields.judgeme.shop_reviews_rating.value | plus: 0
  elsif summary_source == 'all'
    assign summary_count = shop.metafields.judgeme.all_reviews_count.value | plus: 0
    assign summary_rating = shop.metafields.judgeme.all_reviews_rating.value | plus: 0
  endif

  if summary_count > 0 and section.settings.summary_template != blank
    # 1922 -> 1,922 (Liquid has no number delimiter filter)
    assign count_display = summary_count | append: ''
    if summary_count >= 1000
      assign count_thousands = summary_count | divided_by: 1000
      assign count_rest = summary_count | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
      assign count_display = count_thousands | append: ',' | append: count_rest
    endif
    assign rating_display = summary_rating | round: 1 | append: ''
    assign summary_text = section.settings.summary_template | replace: '[rating]', rating_display | replace: '[count]', count_display
  endif

  assign show_header = false
  if section.settings.heading != blank or section.settings.show_summary and summary_text != blank
    assign show_header = true
  endif
-%}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_review_strip.css' | asset_url | stylesheet_tag }}

{%- if review_count > 0 or request.design_mode -%}
<section
  id="cwc_review-strip-{{ section.id }}"
  class="cwc_review-strip{% if section.settings.show_borders %} cwc_review-strip--borders{% endif %}{% if section.settings.edge_fade %} cwc_review-strip--fade{% endif %}{% if section.settings.card_layout == 'stacked' %} cwc_review-strip--stacked{% endif %}"
  style="--loop-duration: {{ loop_seconds }}s;"
>
  {% comment %} Section Header: title, then the star rating and review total {% endcomment %}
  {% if show_header %}
    <div class="cwc_review-strip__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_review-strip__content-title">
          {% if section.settings.show_rule %}<span class="cwc_review-strip__content-rule" aria-hidden="true"></span>{% endif %}
          <div class="cwc_review-strip__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
          {% if section.settings.show_rule %}<span class="cwc_review-strip__content-rule" aria-hidden="true"></span>{% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_summary and summary_text != blank %}
        <p class="cwc_review-strip__summary">
          <span class="cwc_review-strip__summary-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" focusable="false"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" /></svg>
            {%- endfor -%}
          </span>
          <span class="cwc_review-strip__summary-text">{{ summary_text | escape }}</span>
        </p>
      {% endif %}
    </div>
  {% endif %}

  {% if review_count > 0 %}
    <div class="cwc_review-strip__container" role="region" aria-label="Customer reviews">
      <div class="cwc_review-strip__track">
        {%- for pass in (1..2) -%}
          <ul
            class="cwc_review-strip__list{% if pass == 2 %} cwc_review-strip__list--clone{% endif %}"
            role="list"
            {% if pass == 2 %}aria-hidden="true"{% endif %}
          >
            {%- for r in (1..repeats) -%}
              {%- if pass == 1 and r == 1 -%}
                {{ items_primary }}
              {%- else -%}
                {{ items_copy }}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {% else %}
    <div class="cwc_review-strip__empty">
      <p>No Judge.me reviews matched. Add review blocks as a fallback.</p>
    </div>
  {% endif %}
</section>

{% if review_count > 0 %}
  {% comment %}
    Start each page view at a random point in the loop, so shoppers don't
    all land on the same first few reviews. Runs inline, right after the
    markup, so the strip never paints at the start and then jumps. A
    negative delay just means "already this far in"; the loop is unchanged.
  {% endcomment %}
  <script>
    (function () {
      var section = document.getElementById('cwc_review-strip-{{ section.id }}');
      var track = section && section.querySelector('.cwc_review-strip__track');
      if (!track) return;
      var seconds = {{ loop_seconds | default: 40 }};
      track.style.animationDelay = '-' + (Math.random() * seconds).toFixed(2) + 's';
    })();
  </script>
{% endif %}
{%- endif -%}

{% schema %}
{
  "name": "CWC Review Strip",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "info": "Leave empty for the strip only",
      "default": "<p>What Our <strong>Customers</strong> Say</p>"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Lines Beside Heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show Rating Summary",
      "info": "Stars with the average rating and review total, under the heading",
      "default": true
    },
    {
      "type": "select",
      "id": "summary_source",
      "label": "Summary Source",
      "info": "Judge.me numbers update live. Falls back to the text below if Judge.me has no count.",
      "options": [
        { "value": "store", "label": "Judge.me: store reviews only" },
        { "value": "all", "label": "Judge.me: all reviews (product + store)" },
        { "value": "manual", "label": "Fallback text" }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "summary_template",
      "label": "Judge.me Summary Format",
      "info": "[rating] and [count] are replaced with the live Judge.me numbers",
      "default": "[rating] Average · [count] Reviews"
    },
    {
      "type": "text",
      "id": "summary_fallback",
      "label": "Summary Fallback Text",
      "default": "4.9 Average · 18 Store Reviews"
    },
    {
      "type": "header",
      "content": "Review Source"
    },
    {
      "type": "checkbox",
      "id": "use_judgeme",
      "label": "Use Judge.me Store Reviews",
      "info": "Pulls featured store reviews from Judge.me. The review blocks show instead when this is off or no Judge.me review matches the filters below.",
      "default": true
    },
    {
      "type": "range",
      "id": "judgeme_limit",
      "label": "Max Judge.me Reviews",
      "info": "Judge.me shares about 25 featured store reviews",
      "min": 1,
      "max": 25,
      "step": 1,
      "default": 25
    },
    {
      "type": "range",
      "id": "judgeme_min_rating",
      "label": "Minimum Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "text_limit",
      "label": "Max Characters per Review",
      "info": "Longer reviews are cut short with …",
      "min": 60,
      "max": 200,
      "step": 10,
      "default": 110
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "seconds_per_review",
      "label": "Scroll Speed",
      "info": "Seconds each review takes to pass. Lower is faster. Pauses on hover.",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "Review Layout",
      "options": [
        { "value": "inline", "label": "Inline (stars, text, name in one line)" },
        { "value": "stacked", "label": "Stacked (stars, then text, then name)" }
      ],
      "default": "inline"
    },
    {
      "type": "range",
      "id": "card_min_width",
      "label": "Review Min Width",
      "info": "Short reviews still take at least this much room, so the row never looks cramped",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
      "id": "card_max_width",
      "label": "Review Max Width",
      "info": "Stacked layout: longer reviews wrap to two lines at this width",
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show Top & Bottom Borders",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade Edges",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#13241C"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Heading Line Color",
      "default": "#13241C"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Summary Text Color",
      "default": "#8A6A2E"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Divider Color",
      "default": "#C49340"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#C49340"
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Reviewer Name Color",
      "default": "#6E6A60"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border & Empty Star Color",
      "default": "#E4DED2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "paragraph",
          "content": "Fallback review. Shows only when Judge.me is off or has no matching reviews."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review Text",
          "default": "<p>Packed better than anything I have ordered online. Arrived in two days in perfect shape.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer Name",
          "default": "Michael R."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CWC Review Strip",
      "category": "CWC Custom",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "text": "<p>Fair prices on allocated bottles, which is rare on its own. No games, no inflated markup.</p>", "author": "David K." } },
        { "type": "review", "settings": { "text": "<p>Emailed a question about a barrel pick and heard back the same day from someone who knew it.</p>", "author": "James T." } }
      ]
    }
  ]
}
{% endschema %}
