{% style %}
  #cwc_bab-builder-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#1C1C19' }};
    --highlight-color: {{ section.settings.bold_color | default: '#8A6A2E' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#8A6A2E' }};
    --accent-color: {{ section.settings.accent_color | default: '#E9A23B' }};
    --accent-hover: {{ section.settings.accent_hover_color | default: '#D68F27' }};
    --accent-text: {{ section.settings.accent_text_color | default: '#8A6A2E' }};
    --dark-color: {{ section.settings.dark_color | default: '#13241C' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5C57' }};
    --border-color: {{ section.settings.border_color | default: '#ECECE8' }};
    --input-border: {{ section.settings.input_border_color | default: '#D9D9D3' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --ground-edge: {{ section.settings.ground_edge_color | default: '#E4EBE6' }};
    --sticky-offset: {{ section.settings.sticky_offset | default: 24 }}px;
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_bab_builder.css' | asset_url | stylesheet_tag }}

{%- liquid
  # ---------- Offer on / off ----------
  assign offer_live = section.settings.offer_enabled
  if section.settings.offer_end_date != blank
    assign today = 'now' | date: '%Y-%m-%d'
    if today > section.settings.offer_end_date
      assign offer_live = false
    endif
  endif

  # ---------- Valid tiers (product rewards need a purchasable product) ----------
  assign valid_tiers = ','
  assign tier_count = 0
  assign top_threshold = 0
  for block in section.blocks
    if block.type == 'tier' and block.settings.threshold > 0
      assign t_ok = true
      if block.settings.reward_type == 'product_price' or block.settings.reward_type == 'gift'
        assign t_variant = block.settings.reward_product.selected_or_first_available_variant
        if block.settings.reward_product == blank or t_variant.available == false
          assign t_ok = false
        endif
      endif
      if t_ok
        assign valid_tiers = valid_tiers | append: block.id | append: ','
        assign tier_count = tier_count | plus: 1
        if block.settings.threshold > top_threshold
          assign top_threshold = block.settings.threshold
        endif
      endif
    endif
  endfor

  assign min_bottles = section.settings.min_bottles | default: 2
  assign low_stock = section.settings.low_stock_threshold | default: 5
-%}

{%- comment -%} Reward naming, shared by tier cards and the JS config {%- endcomment -%}
{%- capture tier_json -%}
  [
  {%- assign tier_i = 0 -%}
  {%- for block in section.blocks -%}
    {%- assign block_key = ',' | append: block.id | append: ',' -%}
    {%- if block.type == 'tier' and valid_tiers contains block_key -%}
      {%- liquid
        assign r_type = block.settings.reward_type
        assign r_product = block.settings.reward_product
        assign r_variant = r_product.selected_or_first_available_variant
        assign r_threshold = block.settings.threshold | times: 100 | round
        assign r_value = block.settings.reward_value | default: 0
        assign r_price = block.settings.reward_price | default: 0 | times: 100 | round
        assign r_regular = 0
        if r_variant != blank
          assign r_regular = r_variant.price
        endif
        if block.settings.reward_label != blank
          assign r_name = block.settings.reward_label
        elsif r_type == 'amount_off'
          assign r_name = r_value | times: 100 | money_without_trailing_zeros | append: ' off your box'
        elsif r_type == 'percent_off'
          assign r_name = r_value | append: '% off your box'
        else
          assign r_name = r_product.title
        endif
        if r_type == 'product_price'
          assign r_price_phrase = r_price | money_without_trailing_zeros | prepend: 'for '
        elsif r_type == 'gift'
          assign r_price_phrase = 'free'
        else
          assign r_price_phrase = ''
        endif
      -%}
      {%- unless tier_i == 0 -%},{%- endunless -%}
      {
        "idx": {{ tier_i }},
        "threshold": {{ r_threshold }},
        "label": {{ r_threshold | money_without_trailing_zeros | append: '+' | json }},
        "type": {{ r_type | json }},
        "value": {{ r_value | json }},
        "price": {{ r_price }},
        "regular": {{ r_regular }},
        "name": {{ r_name | json }},
        "pricePhrase": {{ r_price_phrase | json }},
        "variantId": {% if r_variant != blank and r_type != 'amount_off' and r_type != 'percent_off' %}{{ r_variant.id }}{% else %}null{% endif %},
        "image": {% if r_product.featured_image != blank and r_type != 'amount_off' and r_type != 'percent_off' %}{{ r_product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %}
      }
      {%- assign tier_i = tier_i | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  ]
{%- endcapture -%}

{%- comment -%} Progress bar with one marker per tier — reused in the panel, sheet and bar {%- endcomment -%}
{%- capture progress_markup -%}
  <div class="cwc_bab-builder__progress">
    <div class="cwc_bab-builder__progress-track">
      <span class="cwc_bab-builder__progress-fill" data-bab-fill></span>
      {%- assign tier_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign block_key = ',' | append: block.id | append: ',' -%}
        {%- if block.type == 'tier' and valid_tiers contains block_key -%}
          {%- liquid
            assign m_pos = block.settings.threshold | times: 100.0 | divided_by: top_threshold
            assign m_mod = block.settings.threshold | modulo: 1000
            if block.settings.threshold >= 1000 and m_mod == 0
              assign m_label = block.settings.threshold | divided_by: 1000 | prepend: '$' | append: 'K'
            else
              assign m_label = block.settings.threshold | times: 100 | money_without_trailing_zeros
            endif
          -%}
          <span class="cwc_bab-builder__progress-marker" style="--pos: {{ m_pos }}%;" data-bab-marker data-tier="{{ tier_i }}">
            <span class="cwc_bab-builder__progress-label">{{ m_label }}</span>
          </span>
          {%- assign tier_i = tier_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endcapture -%}

{%- comment -%} The full box — rendered in the desktop panel and the mobile sheet {%- endcomment -%}
{%- capture box_markup -%}
  <div class="cwc_bab-builder__box" data-bab-box>
    <div class="cwc_bab-builder__box-header">
      <p class="cwc_bab-builder__box-title">
        {{ section.settings.box_title | default: 'Your box' }}
        <span class="cwc_bab-builder__box-count">(<span data-bab-count>0</span>)</span>
      </p>
      <button type="button" class="cwc_bab-builder__box-close" data-bab-close aria-label="Close box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>

    <div class="cwc_bab-builder__box-status">
      <p class="cwc_bab-builder__status-bold" data-bab-status></p>
      <p class="cwc_bab-builder__status-sub" data-bab-sub></p>
      {% if tier_count > 0 %}{{ progress_markup }}{% endif %}
    </div>

    <div class="cwc_bab-builder__box-body">
      <ul class="cwc_bab-builder__lines" data-bab-lines></ul>

      <div class="cwc_bab-builder__reward" data-bab-reward hidden>
        <div class="cwc_bab-builder__reward-media" data-bab-reward-media></div>
        <div class="cwc_bab-builder__reward-info">
          <p class="cwc_bab-builder__reward-label" data-bab-reward-label></p>
          <p class="cwc_bab-builder__reward-name" data-bab-reward-name></p>
        </div>
        <div class="cwc_bab-builder__reward-price">
          <span data-bab-reward-price></span>
          <s data-bab-reward-was></s>
        </div>
      </div>
    </div>

    <div class="cwc_bab-builder__box-footer">
      <div class="cwc_bab-builder__box-total">
        <span class="cwc_bab-builder__box-total-label" data-bab-total-label>{{ section.settings.total_label | default: 'Box total' }}</span>
        <span class="cwc_bab-builder__box-total-value" data-bab-total></span>
      </div>
      <button type="button" class="cwc_bab-builder__button" data-bab-submit disabled></button>
      <p class="cwc_bab-builder__error" data-bab-error role="alert" hidden></p>
      <button type="button" class="cwc_bab-builder__keep" data-bab-close>
        {{- section.settings.keep_shopping_label | default: 'Keep shopping' -}}
      </button>
      {% if section.settings.box_note != blank %}
        <p class="cwc_bab-builder__box-note">{{ section.settings.box_note }}</p>
      {% endif %}
    </div>
  </div>
{%- endcapture -%}

<section
  id="cwc_bab-builder-{{ section.id }}"
  class="cwc_bab-builder"
  data-section-id="{{ section.id }}"
>
  <div class="cwc_bab-builder__container">

    {% unless offer_live %}
      {% comment %} Offer off — "check back" state {% endcomment %}
      <div class="cwc_bab-builder__off">
        {% if section.settings.off_heading != blank %}
          <div class="cwc_bab-builder__content-heading cwc-rte">{{ section.settings.off_heading }}</div>
        {% endif %}
        {% if section.settings.off_text != blank %}
          <div class="cwc_bab-builder__content-subtext cwc-rte">{{ section.settings.off_text }}</div>
        {% endif %}
      </div>
    {% else %}

      <div class="cwc_bab-builder__layout">

        {% comment %} ========== Main column ========== {% endcomment %}
        <div class="cwc_bab-builder__main">

          {% comment %} Section Header {% endcomment %}
          <div class="cwc_bab-builder__content">
            {% if section.settings.eyebrow != blank %}
              <p class="cwc_bab-builder__content-eyebrow">{{ section.settings.eyebrow }}</p>
            {% endif %}
            {% if section.settings.heading != blank %}
              <div class="cwc_bab-builder__content-heading cwc-rte">{{ section.settings.heading }}</div>
            {% endif %}
            {% if section.settings.subtext != blank %}
              <div class="cwc_bab-builder__content-subtext cwc-rte">{{ section.settings.subtext }}</div>
            {% endif %}
          </div>

          {% comment %} Tier cards {% endcomment %}
          {% if tier_count > 0 %}
            <div class="cwc_bab-builder__tiers" style="--tier-count: {{ tier_count }};">
              {%- assign tier_i = 0 -%}
              {% for block in section.blocks %}
                {%- assign block_key = ',' | append: block.id | append: ',' -%}
                {% case block.type %}
                  {% when 'tier' %}
                    {% if valid_tiers contains block_key %}
                      {%- liquid
                        assign r_type = block.settings.reward_type
                        assign r_product = block.settings.reward_product
                        assign r_variant = r_product.selected_or_first_available_variant
                        assign r_value = block.settings.reward_value | default: 0
                        assign r_price = block.settings.reward_price | default: 0 | times: 100 | round
                        if block.settings.reward_label != blank
                          assign r_name = block.settings.reward_label
                        elsif r_type == 'amount_off'
                          assign r_name = r_value | times: 100 | money_without_trailing_zeros | append: ' off your box'
                        elsif r_type == 'percent_off'
                          assign r_name = r_value | append: '% off your box'
                        else
                          assign r_name = r_product.title
                        endif
                      -%}
                      <div class="cwc_bab-builder__tier cwc_bab-builder__tier--locked" data-bab-tier data-tier="{{ tier_i }}" {{ block.shopify_attributes }}>
                        <p class="cwc_bab-builder__tier-status" data-bab-tier-status>
                          {{- section.settings.tier_locked_text | default: 'Locked' -}}
                        </p>
                        <p class="cwc_bab-builder__tier-threshold">
                          {{- block.settings.threshold | times: 100 | money_without_trailing_zeros -}}+
                        </p>
                        <p class="cwc_bab-builder__tier-name">{{ r_name }}</p>
                        <p class="cwc_bab-builder__tier-price">
                          {% case r_type %}
                            {% when 'product_price' %}
                              <span>{{ r_price | money_without_trailing_zeros }}</span>
                              <s>{{ r_variant.price | money }}</s>
                            {% when 'gift' %}
                              <span>{{ section.settings.free_text | default: 'Free' }}</span>
                              <s>{{ r_variant.price | money }}</s>
                            {% when 'amount_off' %}
                              <span>{{ r_value | times: 100 | money_without_trailing_zeros }} off</span>
                            {% when 'percent_off' %}
                              <span>{{ r_value }}% off</span>
                          {% endcase %}
                        </p>
                      </div>
                      {%- assign tier_i = tier_i | plus: 1 -%}
                    {% endif %}
                {% endcase %}
              {% endfor %}
            </div>
          {% endif %}

          {% comment %} Toolbar: tabs + search {% endcomment %}
          <div class="cwc_bab-builder__toolbar">
            <div class="cwc_bab-builder__tabs" role="group" aria-label="Filter bottles">
              {%- assign has_tabs = false -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'tab' and block.settings.collection != blank -%}
                  {%- assign has_tabs = true -%}
                {%- endif -%}
              {%- endfor -%}
              {% if section.settings.show_all_tab or has_tabs == false %}
                <button type="button" class="cwc_bab-builder__tab cwc_bab-builder__tab--active" data-bab-tab="all" aria-pressed="true">
                  {{- section.settings.all_tab_label | default: 'All' -}}
                </button>
              {% endif %}
              {%- assign tab_i = 0 -%}
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'tab' %}
                    {% if block.settings.collection != blank %}
                      {%- liquid
                        assign is_first_active = false
                        if section.settings.show_all_tab == false and tab_i == 0
                          assign is_first_active = true
                        endif
                      -%}
                      <button
                        type="button"
                        class="cwc_bab-builder__tab{% if is_first_active %} cwc_bab-builder__tab--active{% endif %}"
                        data-bab-tab="{{ tab_i }}"
                        aria-pressed="{{ is_first_active }}"
                        {{ block.shopify_attributes }}
                      >
                        {{- block.settings.label | default: block.settings.collection.title -}}
                      </button>
                      {%- assign tab_i = tab_i | plus: 1 -%}
                    {% endif %}
                {% endcase %}
              {% endfor %}
            </div>

            <label class="cwc_bab-builder__search">
              <span class="cwc_bab-builder__visually-hidden">{{ section.settings.search_placeholder | default: 'Search this offer' }}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
              <input
                type="search"
                class="cwc_bab-builder__search-input"
                placeholder="{{ section.settings.search_placeholder | default: 'Search this offer' | escape }}"
                autocomplete="off"
                data-bab-search
              >
            </label>
          </div>

          <p class="cwc_bab-builder__count" data-bab-results aria-live="polite"></p>

          {% comment %} Product grid — union of the tab collections, deduped {% endcomment %}
          <div class="cwc_bab-builder__grid">
            {%- liquid
              assign seen = ','
              assign card_total = 0
            -%}
            {% for block in section.blocks %}
              {% if block.type == 'tab' and block.settings.collection != blank %}
                {% for product in block.settings.collection.products limit: 50 %}
                  {%- liquid
                    assign p_key = ',' | append: product.id | append: ','
                    assign skip = false
                    if seen contains p_key
                      assign skip = true
                    endif
                    if product.tags contains 'Allocated' or product.tags contains 'allocated'
                      assign skip = true
                    endif
                    assign p_soldout = false
                    if product.available == false
                      assign p_soldout = true
                      if section.settings.sold_out_mode == 'hide'
                        assign skip = true
                      endif
                    endif
                    if card_total >= 150
                      assign skip = true
                    endif
                  -%}
                  {% unless skip %}
                    {%- liquid
                      assign seen = seen | append: product.id | append: ','
                      assign card_total = card_total | plus: 1
                      assign p_variant = product.selected_or_first_available_variant

                      # Max that can go in the box: tracked + deny = stock, else open
                      assign p_max = 99
                      if p_variant.inventory_management == 'shopify' and p_variant.inventory_policy == 'deny'
                        assign p_max = p_variant.inventory_quantity
                        if p_max < 0
                          assign p_max = 0
                        endif
                      endif
                      assign p_low = false
                      if p_max > 0 and p_max <= low_stock
                        assign p_low = true
                      endif

                      # Which tabs this bottle belongs to
                      assign p_handles = product.collections | map: 'handle' | join: ','
                      assign p_handles = ',' | append: p_handles | append: ','
                      assign p_tabs = ' '
                      assign tab_j = 0
                      for t_block in section.blocks
                        if t_block.type == 'tab' and t_block.settings.collection != blank
                          assign t_key = ',' | append: t_block.settings.collection.handle | append: ','
                          if p_handles contains t_key or t_block.id == block.id
                            assign p_tabs = p_tabs | append: tab_j | append: ' '
                          endif
                          assign tab_j = tab_j | plus: 1
                        endif
                      endfor

                      assign p_search = product.title | append: ' ' | append: product.vendor | append: ' ' | append: product.type
                      if product.metafields.custom.distillery != blank
                        assign p_search = p_search | append: ' ' | append: product.metafields.custom.distillery.value
                      endif
                      assign p_search = p_search | downcase
                    -%}
                    <div
                      class="cwc_bab-builder__card{% if p_soldout %} cwc_bab-builder__card--soldout{% endif %}"
                      data-bab-card
                      data-variant-id="{{ p_variant.id }}"
                      data-price="{{ p_variant.price }}"
                      data-max="{{ p_max }}"
                      data-title="{{ product.title | escape }}"
                      data-url="{{ product.url }}"
                      data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 160 }}{% endif %}"
                      data-tabs="{{ p_tabs }}"
                      data-search="{{ p_search | escape }}"
                    >
                      <a href="{{ product.url }}" class="cwc_bab-builder__card-media" tabindex="-1" aria-hidden="true">
                        {% if product.featured_image != blank %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w"
                            sizes="(max-width: 768px) 50vw, 25vw"
                            alt="{{ product.featured_image.alt | default: product.title | escape }}"
                            loading="lazy"
                            width="600"
                            height="600"
                          >
                        {% else %}
                          <span class="cwc_bab-builder__card-placeholder">
                            <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
                              <rect x="16" y="0" width="20" height="6" rx="2" />
                              <rect x="18" y="6" width="16" height="11" />
                              <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
                            </svg>
                          </span>
                        {% endif %}
                        <span class="cwc_bab-builder__card-badge" data-bab-in-box hidden>
                          {{- section.settings.in_box_label | default: 'In your box' -}}
                        </span>
                        {% if p_soldout %}
                          <span class="cwc_bab-builder__card-badge cwc_bab-builder__card-badge--soldout">
                            {{- section.settings.sold_out_label | default: 'Sold out' -}}
                          </span>
                        {% endif %}
                      </a>

                      <div class="cwc_bab-builder__card-body">
                        <a href="{{ product.url }}" class="cwc_bab-builder__card-title">{{ product.title }}</a>

                        <div class="cwc_bab-builder__card-price-row">
                          <span class="cwc_bab-builder__card-price">{{ p_variant.price | money }}</span>
                          {% if p_low %}
                            <span class="cwc_bab-builder__card-stock">{{ p_max }} left</span>
                          {% endif %}
                        </div>

                        {% unless p_soldout %}
                          <button
                            type="button"
                            class="cwc_bab-builder__card-button"
                            data-bab-add
                            aria-label="Add {{ product.title | escape }} to box"
                          >
                            {{- section.settings.add_label | default: 'Add to box' -}}
                          </button>
                          <div class="cwc_bab-builder__stepper" data-bab-stepper hidden>
                            <button type="button" class="cwc_bab-builder__stepper-button" data-bab-dec aria-label="Remove one {{ product.title | escape }}">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /></svg>
                            </button>
                            <span class="cwc_bab-builder__stepper-value" data-bab-qty aria-live="polite"></span>
                            <button type="button" class="cwc_bab-builder__stepper-button" data-bab-inc aria-label="Add one more {{ product.title | escape }}">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
                            </button>
                          </div>
                        {% endunless %}
                      </div>
                    </div>
                  {% endunless %}
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>

          <div class="cwc_bab-builder__empty" data-bab-empty hidden>
            <p>{{ section.settings.empty_search_text | default: 'No bottles in this offer match.' }}</p>
            <button type="button" class="cwc_bab-builder__text-link" data-bab-clear>
              {{- section.settings.clear_search_label | default: 'Clear search' -}}
            </button>
          </div>

          {% if card_total == 0 %}
            <p class="cwc_bab-builder__placeholder">Add a Tab block with a collection to fill the shelf.</p>
          {% endif %}
        </div>

        {% comment %} ========== Desktop box panel (sticky) ========== {% endcomment %}
        <aside class="cwc_bab-builder__panel" aria-label="{{ section.settings.box_title | default: 'Your box' | escape }}">
          {{ box_markup }}
        </aside>
      </div>

      {% comment %} ========== Mobile tracker bar + box sheet ========== {% endcomment %}
      <div class="cwc_bab-builder__bar" data-bab-bar>
        <p class="cwc_bab-builder__status-bold" data-bab-status></p>
        <p class="cwc_bab-builder__status-sub" data-bab-sub></p>
        {% if tier_count > 0 %}{{ progress_markup }}{% endif %}
        <div class="cwc_bab-builder__bar-row">
          <div class="cwc_bab-builder__bar-summary">
            <span class="cwc_bab-builder__bar-count" data-bab-bottles></span>
            <span class="cwc_bab-builder__bar-subtotal" data-bab-subtotal></span>
          </div>
          <button type="button" class="cwc_bab-builder__button cwc_bab-builder__button--bar" data-bab-open>
            {{- section.settings.view_box_label | default: 'View box' -}}
          </button>
        </div>
      </div>

      <dialog class="cwc_bab-builder__sheet" data-bab-sheet aria-label="{{ section.settings.box_title | default: 'Your box' | escape }}">
        {{ box_markup }}
      </dialog>

      <template data-bab-line-template>
        <li class="cwc_bab-builder__line">
          <span class="cwc_bab-builder__line-media"><img alt="" width="56" height="56" loading="lazy" hidden></span>
          <div class="cwc_bab-builder__line-info">
            <p class="cwc_bab-builder__line-title" data-bab-line-title></p>
            <p class="cwc_bab-builder__line-qty" data-bab-line-qty hidden></p>
            <p class="cwc_bab-builder__line-note" data-bab-line-note hidden></p>
          </div>
          <div class="cwc_bab-builder__line-side">
            <button type="button" class="cwc_bab-builder__line-remove" data-bab-remove aria-label="Remove from box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
            <span class="cwc_bab-builder__line-price" data-bab-line-price></span>
          </div>
        </li>
      </template>

      <script type="application/json" data-bab-config>
        {
          "storageKey": {{ section.id | json }},
          "minBottles": {{ min_bottles }},
          "moneyFormat": {{ shop.money_format | json }},
          "tiers": {{ tier_json }},
          "copy": {
            "emptyBold": {{ section.settings.status_empty_bold | json }},
            "emptySub": {{ section.settings.status_empty_sub | json }},
            "fewBold": {{ section.settings.status_few_bold | json }},
            "fewSub": {{ section.settings.status_few_sub | json }},
            "underBold": {{ section.settings.status_under_bold | json }},
            "underSub": {{ section.settings.status_under_sub | json }},
            "reachedBold": {{ section.settings.status_reached_bold | json }},
            "reachedSub": {{ section.settings.status_reached_sub | json }},
            "topBold": {{ section.settings.status_top_bold | json }},
            "topSub": {{ section.settings.status_top_sub | json }},
            "noTiersBold": {{ section.settings.status_no_tiers_bold | json }},
            "tierNext": {{ section.settings.tier_next_text | json }},
            "tierToGo": {{ section.settings.tier_to_go_text | json }},
            "tierActive": {{ section.settings.tier_active_text | json }},
            "tierUpgraded": {{ section.settings.tier_upgraded_text | json }},
            "tierLocked": {{ section.settings.tier_locked_text | json }},
            "buttonEmpty": {{ section.settings.button_empty_label | json }},
            "buttonFew": {{ section.settings.button_few_label | json }},
            "buttonActive": {{ section.settings.button_active_label | json }},
            "buttonAdding": {{ section.settings.button_adding_label | json }},
            "inBox": {{ section.settings.in_box_qty_label | json }},
            "bottlesInBox": {{ section.settings.bottles_in_box_label | json }},
            "results": {{ section.settings.results_text | json }},
            "resultsOne": {{ section.settings.results_text_one | json }},
            "rewardLabel": {{ section.settings.reward_line_label | json }},
            "free": {{ section.settings.free_text | json }},
            "totalLabel": {{ section.settings.total_label | json }},
            "estTotalLabel": {{ section.settings.est_total_label | json }},
            "onlyLeft": {{ section.settings.only_left_text | json }},
            "emptyBox": {{ section.settings.empty_box_text | json }},
            "addError": {{ section.settings.add_error_text | json }}
          }
        }
      </script>
    {% endunless %}

  </div>
</section>

{% if offer_live %}
  <script src="{{ 'CWC_bab_store.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'CWC_bab_builder.js' | asset_url }}" defer="defer"></script>
{% endif %}

