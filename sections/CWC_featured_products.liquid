{% style %}
  #cwc_featured-products-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F4F0E8' }};
    --text-color: {{ section.settings.text_color | default: '#13241C' }};
    --highlight-color: {{ section.settings.bold_color | default: '#8A6A2E' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#8A6A2E' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-media-bg: {{ section.settings.card_media_bg_color | default: '#FFFFFF' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#13241C' }};
    --card-text-color: {{ section.settings.card_text_color | default: '#5C5C57' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E9A23B' }};
    --border-color: {{ section.settings.border_color | default: '#ECECE8' }};
    --columns: {{ section.settings.columns | default: 4 }};
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_card.css' | asset_url | stylesheet_tag }}
{{ 'CWC_featured_products.css' | asset_url | stylesheet_tag }}

<section id="cwc_featured-products-{{ section.id }}" class="cwc_featured-products" data-section-id="{{ section.id }}">
  <div class="cwc_featured-products__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_featured-products__content">
      <div class="cwc_featured-products__content-main">
        {% if section.settings.eyebrow != blank %}
          <p class="cwc_featured-products__content-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_featured-products__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url | default: '#' }}" class="cwc_featured-products__view-all">
          {{ section.settings.link_label }}
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      {% comment %} Tab rail {% endcomment %}
      <div class="cwc_featured-products__tabs" role="tablist">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'tab' %}
              {% liquid
                assign tab_collection = block.settings.collection

                if block.settings.title != blank
                  assign tab_title = block.settings.title
                elsif tab_collection != blank
                  assign tab_title = tab_collection.title
                else
                  assign tab_title = 'Tab'
                endif
              %}

              <button
                type="button"
                class="cwc_featured-products__tab{% if forloop.first %} cwc_featured-products__tab--active{% endif %}"
                role="tab"
                id="cwc_tab-{{ section.id }}-{{ block.id }}"
                aria-controls="cwc_panel-{{ section.id }}-{{ block.id }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ tab_title }}
              </button>
          {% endcase %}
        {% endfor %}
      </div>

      {% comment %} Panels — one product grid per tab {% endcomment %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tab' %}
            {% assign tab_collection = block.settings.collection %}

            <div
              class="cwc_featured-products__panel{% if forloop.first %} cwc_featured-products__panel--active{% endif %}"
              role="tabpanel"
              id="cwc_panel-{{ section.id }}-{{ block.id }}"
              aria-labelledby="cwc_tab-{{ section.id }}-{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {% if tab_collection != blank and tab_collection.products_count > 0 %}
                <div class="cwc_featured-products__grid">
                  {% for product in tab_collection.products limit: section.settings.products_to_show %}
                    <div class="cwc_featured-products__card">
                      {% render 'cwc-product-card', product: product, section_settings: section.settings %}
                    </div>
                  {% endfor %}
                </div>
              {% else %}
                <div class="cwc_featured-products__empty">
                  <p>Select a collection for this tab to show products.</p>
                </div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    {% endif %}

  </div>
</section>

<script src="{{ 'CWC_product_card.js' | asset_url }}" defer></script>
<script src="{{ 'CWC_featured_products.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CWC Featured Products",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best Sellers"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Fan Favorites</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View All Link Label",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products Per Tab",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_card_vendor",
      "label": "Show Brand On Cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_meta",
      "label": "Show Detail Line On Cards",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#13241C"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#8A6A2E"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#8A6A2E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ECECE8"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_media_bg_color",
      "label": "Card Image Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#13241C"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Meta Color",
      "default": "#5C5C57"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Add To Cart Button Color",
      "default": "#E9A23B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Supplies the tab title and its products."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title Override"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Featured Products",
      "category": "CWC Custom",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
