{% if settings.enable_verification_popup or settings['verification-pop-up__test-mode'] %}
  {% liquid
    assign background_opacity = 100 | minus: settings.verification_background_opacity
    assign verification_popup_background_color = 'rgba(' | append: settings['verification-popup--background-color'].rgba | append: ')'
    assign verification_popup_background_color_opaque = 'color-mix(in srgb, ' | append: verification_popup_background_color | append: ', transparent ' | append: background_opacity | append: '%)'
  %}

  {% if settings['verification-popup--override_button_colors'] %}
    {% render 'button-color-overrides',
      id: 'verification-popup',
      style: 'filled',
      text_color: settings['verification-popup--button_text_color'],
      background_color: settings['verification-popup--button_background_color']
    %}
  {% endif %}

  <div
    class="verification-popup-container"
    style="display: none"
    data-age-test-mode="{{ settings.verification-pop-up__test-mode }}"
    tabindex="-1"
  >
    <div id="prompt__background">
      <div
        id="verification__prompt"
        class="modal__prompt popup-shadow color-scheme--{{ settings.verification_popup_color_scheme }} block-radius"
        role="dialog"
      >
        {% capture logo-image %}
          <div class="verification-popup-logo__container" itemscope itemtype="http://schema.org/Organization">
            {% capture props %}itemprop="logo"{% endcapture %}

            {% if settings.verification-popup__logo %}
              <div class="verification-popup-logo__image">
                {% capture alt %}{{ settings.verification-popup__logo.alt | default: shop.name }}{% endcapture %}
                {% render 'responsive-image', image: settings.verification-popup__logo, alt: alt, blur: false, props: props %}
              </div>
            {% endif %}
          </div>
        {% endcapture %}

        <div class="modal-initial-content">
          {{ logo-image }}
          <div class="modal-content__wrapper">
            {% if settings['verification-pop-up__header'] != '' %}
              <h2>
                {{ settings['verification-pop-up__header'] }}
              </h2>
            {% endif %}
            {% if settings['verification-pop-up__description'] != '' %}
              <div class="rte text-link-animated">
                {{ settings['verification-pop-up__description'] }}
              </div>
            {% endif %}
          </div>

          <div class="modal-button-container">
            {% if settings['confirm-button__text'] != '' %}
              <button
                role="button"
                class="btn__enter btn dynamic-section-button--verification-popup"
                id="button__enter"
                tabindex="1"
              >
                {{ settings['confirm-button__text'] }}
              </button>
            {% endif %}

            {% if settings['exit-button__text'] != '' %}
              <button
                role="button"
                id="button__exit"
                class="btn__exit btn secondary-button styled-submit dynamic-section-button--verification-popup"
                tabindex="1"
              >
                {{ settings['exit-button__text'] }}
              </button>
            {% endif %}
          </div>
          <div class="pop_disclaimer">By entering this site you agree to our Terms of Service and Privacy Policy.</div>
        </div>

        <div class="modal-deny-content hidden">
          {{ logo-image }}
          <div class="modal-content__wrapper">
            {% if settings.deny__header != '' %}
              <h2>
                {{ settings.deny__header }}
              </h2>
            {% endif %}
            {% if settings.deny__description != '' %}
              <div class="rte text-link-animated">
                {{ settings.deny__description }}
              </div>
            {% endif %}
          </div>

          <div class="modal-button-container">
            <button
              role="button"
              id="button__return"
              class="btn__return btn dynamic-section-button--verification-popup"
            >
              {% if settings['deny-button__text'] != '' %}
                {{ settings['deny-button__text'] }}
              {% else %}
                {{ 'general.verification_popup.return_text' | t }}
              {% endif %}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<style>
  .verification-popup-logo__image img {
    width: {{ settings.verification-popup-logo--max-width }}px;
    max-width: {{ settings.verification-popup-logo--max-width }}px !important;
  }

  @media (max-width: 991px) {
    .verification-popup-logo__image img {
      max-width: 220px !important;
    }
  }



  {% if settings.verification-popup--background-image %}
    {% render 'responsive-background-image', image: settings.verification-popup--background-image, selector: '#prompt__background', sizes: '600, 1200, 2000', scale: 1 %}

    body {
      min-height: 100%;
    }
  {% endif %}

  #prompt__background:after {
    {% if settings.verification-popup--background-color == 'rgba(0,0,0,0)' %}
      background-color: transparent;
    {% else %}
      background-color: {{ verification_popup_background_color_opaque }};
    {% endif %}
  }
</style>

{% style %}
  /* Age gate — white card on dimmed site, brand green + gold */
  .verification-popup-container #prompt__background {
    padding: 16px;
  }
  .verification-popup-container #prompt__background:after {
    background: rgba(10, 31, 18, 0.85);
  }

  .verification-popup-container #verification__prompt {
    background: #ffffff;
    color: #2c2c2c;
    width: 100%;
    max-width: 540px;
    min-height: 0;
    margin: 0 auto;
    padding: 48px 40px 36px;
    border-radius: 0;
    outline: 1px solid #c4933f;
    outline-offset: -10px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
  }
  .verification-popup-container #verification__prompt .modal-initial-content,
  .verification-popup-container #verification__prompt .modal-deny-content {
    width: 100%;
    max-height: none;
  }

  .verification-popup-container #verification__prompt .verification-popup-logo__image img {
    margin: 0 auto;
    height: auto;
  }

  .verification-popup-container #verification__prompt .modal-content__wrapper {
    margin: 24px 0 28px;
  }
  .verification-popup-container #verification__prompt h2 {
    color: #0a1f12;
    font-size: 38px;
    line-height: 1.15;
    letter-spacing: 0;
    margin: 0 0 18px;
  }
  .verification-popup-container #verification__prompt h2::after {
    content: '';
    display: block;
    width: 56px;
    height: 1px;
    margin: 18px auto 0;
    background: #c4933f;
  }
  .verification-popup-container #verification__prompt .rte p {
    color: #555555;
    font-size: 15px;
    line-height: 1.7;
    margin: 0 auto;
    max-width: 400px;
  }

  .verification-popup-container #verification__prompt .modal-button-container {
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    margin: 0 0 22px;
  }
  .verification-popup-container #verification__prompt .modal-button-container button {
    flex: 1 1 0;
    min-width: 0;
    max-width: none;
    margin: 0;
    padding: 16px 20px;
    font-family: var(--body-font-stack);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .verification-popup-container #verification__prompt #button__enter,
  .verification-popup-container #verification__prompt #button__return {
    background: #0a1f12;
    color: #ffffff;
    border: 1px solid #0a1f12;
  }
  .verification-popup-container #verification__prompt #button__enter:hover,
  .verification-popup-container #verification__prompt #button__return:hover {
    background: #c4933f;
    border-color: #c4933f;
  }
  .verification-popup-container #verification__prompt #button__exit {
    background: #ffffff;
    color: #0a1f12;
    border: 1px solid #0a1f12;
  }
  .verification-popup-container #verification__prompt #button__exit:hover {
    background: #f8f6f1;
  }
  .verification-popup-container #verification__prompt button:focus-visible {
    outline: 2px solid #c4933f;
    outline-offset: 3px;
  }

  .verification-popup-container #verification__prompt .pop_disclaimer {
    color: #666666;
    font-size: 12px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .verification-popup-container #verification__prompt {
      padding: 40px 24px 28px;
    }
    .verification-popup-container #verification__prompt .modal-content__wrapper {
      margin: 20px 0 24px;
    }
    .verification-popup-container #verification__prompt h2 {
      font-size: 28px;
    }
    .verification-popup-container #verification__prompt .rte p {
      font-size: 14px;
    }
    .verification-popup-container #verification__prompt .modal-button-container {
      flex-direction: column;
      gap: 10px;
    }
    .verification-popup-container #verification__prompt .modal-button-container button {
      flex: none;
      width: 100%;
    }
  }
{% endstyle %}
