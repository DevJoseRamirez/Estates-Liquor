{% comment %}
  CWC Sticky Add To Cart
  Rendered from the sticky_atc block of CWC Product Details. Params:
    block            — the block (for its settings)
    sticky_product   — the product to buy

  Visible whenever the main buy box's Add to Cart is off-screen; the
  observer lives in CWC_product_details.js.
{% endcomment %}

{% liquid
  assign sticky_variant = sticky_product.selected_or_first_available_variant
%}

<div
  class="cwc_product-details__sticky{% unless block.settings.show_info_mobile %} cwc_product-details__sticky--button-only{% endunless %}"
  data-cwc-sticky-atc
  data-watch="{{ block.settings.watch_selector | default: '[data-cwc-atc]' }}"
  hidden
>
  <div class="cwc_product-details__sticky-inner">
    <span class="cwc_product-details__sticky-thumb">
      {% if sticky_product.featured_image != blank %}
        <img
          src="{{ sticky_product.featured_image | image_url: width: 160 }}"
          alt=""
          loading="lazy"
          width="58"
          height="68"
        >
      {% else %}
        <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
          <rect x="16" y="0" width="20" height="6" rx="2" />
          <rect x="18" y="6" width="16" height="11" />
          <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
        </svg>
      {% endif %}
    </span>

    <span class="cwc_product-details__sticky-info">
      <span class="cwc_product-details__sticky-name">{{ sticky_product.title }}</span>
      {%- liquid
        assign sticky_on_sale = false
        if sticky_variant.compare_at_price > sticky_variant.price
          assign sticky_on_sale = true
        endif
      -%}
      <span class="cwc_product-details__sticky-price-row">
        <span class="cwc_product-details__sticky-price" data-cwc-sticky-price>{{ sticky_variant.price | money }}</span>
        {% comment %} Compare-at + Save: desktop only; always rendered so a variant change can show them {% endcomment %}
        <span class="cwc_product-details__sticky-was" data-cwc-sticky-compare{% unless sticky_on_sale %} hidden{% endunless %}>
          {%- if sticky_on_sale -%}{{ sticky_variant.compare_at_price | money }}{%- endif -%}
        </span>
        <span class="cwc_product-details__sticky-save" data-cwc-sticky-save{% unless sticky_on_sale %} hidden{% endunless %}>
          {%- if sticky_on_sale -%}Save {{ sticky_variant.compare_at_price | minus: sticky_variant.price | money }}{%- endif -%}
        </span>
      </span>
    </span>

    {% comment %} A real form, so this works even if the script fails {% endcomment %}
    {% form 'product', sticky_product, class: 'cwc_product-details__sticky-form' %}
      <input type="hidden" name="id" value="{{ sticky_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button
        type="submit"
        name="add"
        class="cwc_product-details__sticky-button"
        data-cwc-sticky-add
        {% unless sticky_product.available %}disabled{% endunless %}
      >
        {% if sticky_product.available %}
          {{ block.settings.button_label | default: 'Add to Cart' }}
        {% else %}
          {{ block.settings.sold_out_label | default: 'Sold Out' }}
        {% endif %}
      </button>
    {% endform %}
  </div>
</div>
