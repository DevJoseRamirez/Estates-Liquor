{% comment %}
  CWC Product Card
  Shared by the collection grid, search, You May Also Like and the home
  page rails (Featured Products, Rare Allocated, Barrel Picks). Params:
    product          — required
    section_settings — the calling section's settings (for labels/colours)
                       show_card_vendor / show_card_meta: false hides the
                       brand line / category line. Missing = shown, so
                       sections without the toggles are unchanged.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant

  # Stock state is deliberately not surfaced here — a sold-out card is meant to
  # be indistinguishable from an in-stock one in the grid. The brand spec's
  # SOLD OUT treatment (label, faded bottle, NOTIFY button) is styled and ready:
  # set surface_sold_out to true to turn it on.
  assign surface_sold_out = false
  assign is_sold_out = false
  if surface_sold_out and product.available == false
    assign is_sold_out = true
  endif

  # Max two labels: one top-left (status), one top-right (savings / sold out).
  # Savings show as a dollar amount, never a percent.
  assign badge_label = ''
  assign badge_style = ''
  if product.tags contains 'Allocated' or product.tags contains 'allocated'
    assign badge_label = 'Allocated'
    assign badge_style = 'allocated'
  elsif product.tags contains 'Barrel Pick' or product.tags contains 'barrel pick'
    assign badge_label = 'Barrel Pick'
    assign badge_style = 'barrel'
  elsif product.tags contains 'New' or product.tags contains 'new'
    assign badge_label = 'New'
    assign badge_style = 'new'
  endif

  assign corner_label = ''
  assign corner_style = ''
  if is_sold_out
    assign corner_label = 'Sold Out'
    assign corner_style = 'soldout'
  elsif product.compare_at_price > product.price
    assign saving = product.compare_at_price | minus: product.price | money_without_trailing_zeros
    assign corner_label = 'Save ' | append: saving
    assign corner_style = 'save'
  endif

  assign show_vendor = true
  if section_settings.show_card_vendor == false
    assign show_vendor = false
  endif
  assign show_meta = true
  if section_settings.show_card_meta == false
    assign show_meta = false
  endif

  # Detail line: metafield first, product type as the fallback
  assign product_meta = product.metafields.custom.details
  if product_meta == blank
    assign product_meta = product.type
  endif
%}

<div class="cwc_collection-body__card{% if is_sold_out %} cwc_collection-body__card--soldout{% endif %}">
  <a href="{{ product.url }}" class="cwc_collection-body__card-media" tabindex="-1" aria-hidden="true">
    {% if product.featured_image != blank %}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="600"
        height="800"
      >
    {% else %}
      <span class="cwc_collection-body__card-placeholder">
        <svg viewBox="0 0 52 62" aria-hidden="true" focusable="false">
          <rect x="16" y="0" width="20" height="6" rx="2" />
          <rect x="18" y="6" width="16" height="11" />
          <path d="M10,17 Q10,24 6,28 L6,54 Q6,62 14,62 L38,62 Q46,62 46,54 L46,28 Q42,24 42,17 Z" />
        </svg>
      </span>
    {% endif %}

    {% if badge_label != blank %}
      <span class="cwc_collection-body__card-badge cwc_collection-body__card-badge--{{ badge_style }}">
        {{ badge_label }}
      </span>
    {% endif %}

    {% if corner_label != blank %}
      <span class="cwc_collection-body__card-badge cwc_collection-body__card-badge--corner cwc_collection-body__card-badge--{{ corner_style }}">
        {{ corner_label }}
      </span>
    {% endif %}
  </a>

  <div class="cwc_collection-body__card-body">
    {% if show_vendor and product.vendor != blank %}
      <div class="cwc_collection-body__card-brand">{{ product.vendor }}</div>
    {% endif %}

    <a href="{{ product.url }}" class="cwc_collection-body__card-title">{{ product.title }}</a>

    {% if show_meta and product_meta != blank %}
      <div class="cwc_collection-body__card-text">{{ product_meta }}</div>
    {% endif %}

    {% comment %}
      Same footer in and out of stock. Sold-out swaps the add-to-cart button for
      a visually identical link to the product page, where the back-in-stock app
      lives — so the control never silently fails.
    {% endcomment %}
    <div class="cwc_collection-body__card-footer">
      <div class="cwc_collection-body__card-price{% if product.compare_at_price > product.price %} cwc_collection-body__card-price--sale{% endif %}">
        <span class="cwc_collection-body__card-price-now">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="cwc_collection-body__card-price-was">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      {%- capture cart_icon -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
      {%- endcapture -%}

      {% if product.available %}
        <button
          type="button"
          class="cwc_collection-body__card-button"
          data-variant-id="{{ current_variant.id }}"
          aria-label="Add {{ product.title | escape }} to cart"
        >
          {% comment %} {{ cart_icon }} {% endcomment %}
          Add to Cart
        </button>
      {% elsif is_sold_out %}
        <a
          href="{{ product.url }}"
          class="cwc_collection-body__card-button cwc_collection-body__card-button--notify"
          aria-label="Get notified when {{ product.title | escape }} is back"
        >
          Notify
        </a>
      {% else %}
        <a
          href="{{ product.url }}"
          class="cwc_collection-body__card-button"
          aria-label="View {{ product.title | escape }}"
        >
          {% comment %} {{ cart_icon }} {% endcomment %}
          Add to Cart
        </a>
      {% endif %}
    </div>
  </div>
</div>
